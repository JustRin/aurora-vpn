export component Glow inherits Rectangle {
    in property <color> tint;
    background: @radial-gradient(circle, root.tint 0%, #00000000 62%);
}

export component Card inherits Rectangle {
    // Отступы вынесены наружу: у карточки подписки они меньше (.sub-card).
    in property <length> pad-x: 20px;
    in property <length> pad-y: 18px;
    in property <length> gap: 0px;
    background: Theme.panel;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.shadow-card;
    // inset 0 1px 0 var(--sheen): кромка отступает на радиус, чтобы не
    // перечёркивать скруглённые углы прямой линией.
    Rectangle {
        x: 16px;
        y: 1px;
        width: parent.width - 32px;
        height: 1px;
        background: Theme.sheen;
    }
    VerticalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        spacing: root.gap;
        @children
    }
}

// .section-title описан в CSS одним правилом с .micro (см. MicroRow ниже),
// поэтому и размер здесь тот же — --t-micro.
export component SectionTitle inherits Text {
    color: Theme.text-muted;
    font-size: 10.5px;
    font-weight: 640;
    letter-spacing: 1px;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// .segmented: подложка --sunken, выбранная кнопка — сплошной --accent.
//
// Акцент вынесен из кнопок и лежит один на весь переключатель: выбор его
// перевозит, а не перекрашивает две кнопки разом (.seg-pill в styles.css).
// Тот же приём, что у NavPill в сайдбаре, но там строки одной высоты и y
// считается умножением, а здесь ширины разные — снаружи их взять неоткуда,
// поэтому геометрию сообщает сама кнопка, когда выбор пришёлся на неё.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    // Геометрия выбранной кнопки; заливка занимает ровно её место.
    property <length> pill-x;
    property <length> pill-w;
    property <bool> animated;
    property <bool> measured;

    // pick — выбор перешёл на другую кнопку, вот тогда заливка едет.
    // Перекладка разметки (ширина окна, смена языка) переставляет её без
    // анимации, и первая укладка тоже: страницы пересоздаются на каждом
    // заходе, так что иначе заливка влетала бы из левого угла всякий раз.
    callback place(length, length, bool);
    place(nx, nw, pick) => {
        root.animated = pick && root.measured;
        root.measured = true;
        root.pill-x = nx;
        root.pill-w = nw;
    }

    height: 37px;
    border-radius: 12px;
    background: Theme.sunken;
    border-width: 1px;
    border-color: Theme.border-strong;

    Rectangle {
        x: root.pill-x;
        y: 3px;
        width: root.pill-w;
        height: root.height - 6px;
        border-radius: 8px;
        background: Theme.accent;
        // Без перелёта: по краям трека всего 3px, и возврат пружины на
        // крайних вариантах читался бы как удар о стенку.
        animate x, width {
            duration: root.animated ? 340ms : 0ms;
            easing: cubic-bezier(0.22, 1, 0.36, 1);
        }
    }

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for opt[i] in root.options: Rectangle {
            property <bool> on: i == root.selected;
            border-radius: 8px;
            // Кнопки лежат поверх заливки, так что подсветка наведения
            // достаётся только невыбранным: у выбранной она закрасила бы акцент.
            background: !self.on && touch.has-hover ? #ffffff08 : #00000000;
            animate background { duration: 140ms; }
            // Первая укладка достаётся таймером: отслеживание изменений
            // молчит на первом вычислении свойства (x и width выбранной
            // кнопки так и остались бы неучтёнными), а к моменту init
            // разметка ещё не посчитана.
            Timer {
                interval: 1ms;
                running: parent.on && !root.measured;
                triggered => { root.place(parent.x, parent.width, false); }
            }
            changed on => { if (self.on) { root.place(self.x, self.width, true); } }
            changed x => { if (self.on) { root.place(self.x, self.width, false); } }
            changed width => { if (self.on) { root.place(self.x, self.width, false); } }
            touch := TouchArea { clicked => { root.selected = i; } }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: opt;
                    vertical-alignment: center;
                    font-size: 12.5px;
                    font-weight: 560;
                    color: i == root.selected
                        ? Theme.on-accent
                        : (touch.has-hover ? Theme.text : Theme.text-dim);
                    // Цвет идёт вровень с заливкой, а не вспыхивает впереди неё.
                    animate color { duration: 280ms; }
                }
            }
        }
    }
}

// Общая геометрия фигур графика.
//
// stroke-width здесь задан и для заливок, у которых обводки нет. Slint
// вписывает путь не в габарит элемента, а в габарит, уменьшенный на толщину
// обводки, и сдвигает на её половину (i-slint-core, items/path.rs,
// fitted_path_events). Поэтому фигура с обводкой и фигура без неё получают
// разные трансформации: по вертикали линия уезжает на ~1px, а по горизонтали
// сдвиг на крутом участке превращается в зазор в несколько пикселей — между
// линией и её заливкой открывалась тёмная щель. Одинаковая толщина даёт им
// одинаковую трансформацию.
export component GraphPath inherits Path {
    width: 100%;
    height: 100%;
    // Вьюбокс равен фактическому размеру элемента: координаты Rust генерирует
    // сразу в пикселях, так что масштаб выходит 1:1.
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    stroke-width: 1.8px;
}

export component NavIcon inherits Path {
    in property <color> tint;
    width: 17px;
    height: 17px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.tint;
    stroke-width: 1.5px;
    fill: #00000000;
}

// Подложка активной строки навигации. Лежит не внутри NavItem, а одна на весь
// список (app.slint): при смене страницы она переезжает к выбранной строке, а
// не вспыхивает на новом месте.
export component NavPill inherits Rectangle {
    border-radius: 10px;
    // Подложка активной строки, как в вебе: linear-gradient(90deg,
    // var(--accent-soft), transparent 92%) — слева заливка в полную силу, к
    // правому краю она тает, и строка растворяется в сайдбаре.
    //
    // Двумя прямоугольниками, а не одним: градиентную заливку софтверный
    // рендер кладёт без скругления (LinearGradientCommand радиуса не знает, а
    // process_rounded_rectangle получает после неё прозрачный inner_color —
    // i-slint-renderer-software 1.17.1). Поэтому левые углы, где заливка ещё
    // почти в полную силу, закрывает ровная скруглённая шапка, а градиент
    // начинается за ней; правым углам скруглять уже нечего, там прозрачность.
    //
    // Шапка шириной в два радиуса, а не в один: радиус режется до половины
    // меньшей стороны, и на полоске в 10px от скругления осталась бы половина.
    // Своей ровной заливкой шапка держит подложку в полную силу первые 20px,
    // тогда как в вебе она за эти 20px теряет десятую часть — 3/255 по синему.
    //
    // Path вместо этой пары брать нельзя: при частичной перерисовке он
    // получает клип напрямую, минуя пересечение с грязной областью, и
    // полупрозрачная заливка за несколько кадров анимации цвета набирала в
    // углу строки почти сплошной фиолетовый. Rectangle клип честно пересекает.
    Rectangle {
        x: 0px;
        width: 20px;
        border-top-left-radius: 10px;
        border-bottom-left-radius: 10px;
        background: Theme.accent-soft;
    }
    Rectangle {
        x: 20px;
        width: parent.width - 20px;
        background: @linear-gradient(90deg,
            Theme.accent-soft 0%,
            Theme.accent-soft.transparentize(1.0) 92%);
    }
    // Акцентная рейка слева со свечением (.nav-item.active::before).
    Rectangle {
        x: 0px;
        y: (parent.height - 18px) / 2;
        width: 3px;
        height: 18px;
        border-top-right-radius: 3px;
        border-bottom-right-radius: 3px;
        background: Theme.accent;
        drop-shadow-blur: 10px;
        drop-shadow-color: Theme.accent;
    }
    // inset 0 1px 0 var(--sheen): кромка идёт по верхнему краю и вместе со
    // скруглением заворачивает в углы — в вебе это видно как скруглённый
    // верхний правый угол у растаявшего края строки. Поэтому не полоска, а
    // рамка в 1px у скруглённого прямоугольника, обрезанная по высоте радиуса:
    // ниже точки касания дуги рамка пошла бы по прямым бокам, которых у
    // inset-тени нет.
    Rectangle {
        y: 0px;
        height: 10px;
        clip: true;
        Rectangle {
            y: 0px;
            height: root.height;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.sheen;
        }
    }
}

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <string> badge;
    in property <bool> active;
    callback pressed();
    height: Theme.nav-row-h;
    border-radius: 10px;
    background: !root.active && touch.has-hover ? Theme.panel : #00000000;
    property <color> fg: root.active
        ? Theme.accent-text
        : (touch.has-hover ? Theme.text : Theme.text-dim);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 11px;
        VerticalLayout {
            alignment: center;
            NavIcon { commands: root.icon; tint: root.fg; }
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-size: 13.5px;
            font-weight: 500;
            color: root.fg;
            animate color { duration: 120ms; }
        }
        if root.badge != "": Text {
            text: root.badge;
            vertical-alignment: center;
            font-size: 11px;
            color: Theme.text-muted;
        }
    }
    touch := TouchArea { clicked => { root.pressed(); } }
}

// Строка футера сайдбара (.core-line): иконка 13px + приглушённый текст.
export component CoreLine inherits HorizontalLayout {
    in property <string> icon;
    in property <string> label;
    spacing: 7px;
    VerticalLayout {
        alignment: center;
        NavIcon {
            commands: root.icon;
            tint: Theme.text-muted;
            width: 13px;
            height: 13px;
            stroke-width: 1.2px;
        }
    }
    Text {
        text: root.label;
        vertical-alignment: center;
        font-size: 11.5px;
        color: Theme.text-muted;
    }
}

export component MonoText inherits Text {
    font-family: Theme.mono-font;
    font-size: 12.5px;
    color: Theme.text;
}

// Микро-подпись (.micro): иконка 12px + приглушённый разреженный капс.
export component MicroRow inherits HorizontalLayout {
    in property <string> icon;
    in property <string> label;
    spacing: 7px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        NavIcon {
            commands: root.icon;
            tint: Theme.text-muted;
            width: 12px;
            height: 12px;
            stroke-width: 1.3px;
        }
    }
    Text {
        text: root.label;
        vertical-alignment: center;
        font-size: 10.5px;
        font-weight: 640;
        letter-spacing: 1px;
        color: Theme.text-muted;
    }
}

// Плитка счётчика (.stat): подпись, крупное число, приписка.
export component StatTile inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> value;
    in property <string> foot;
    // В вебе две плитки из трёх — кнопки: разорвать соединения и измерить
    // задержку. Без обработчика клик просто ничего не делает.
    callback clicked();
    background: Theme.panel;
    border-radius: 16px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-strong : Theme.border;
    animate border-color { duration: 160ms; }
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.shadow-card;
    Rectangle {
        x: 16px;
        y: 1px;
        width: parent.width - 32px;
        height: 1px;
        background: Theme.sheen;
    }
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 0px;
        MicroRow { icon: root.icon; label: root.label; }
        Rectangle { height: 8px; }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: 19px;
            font-weight: 660;
            letter-spacing: -0.4px;
        }
        Rectangle { height: 4px; }
        Text {
            text: root.foot;
            color: Theme.text-muted;
            font-size: 11.5px;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Кнопка системного меню шапки — размеры и ховеры из .win-button.
export component WinButton inherits Rectangle {
    in property <string> kind; // "min" | "max" | "close"
    callback activate();
    width: 46px;
    property <bool> danger: root.kind == "close";
    property <color> fg: touch.has-hover
        ? (root.danger ? #ffffff : Theme.text)
        : Theme.text-dim;
    background: touch.has-hover
        ? (root.danger ? Theme.danger-hover : Theme.panel-hover)
        : #00000000;
    animate background { duration: 120ms; }

    if root.kind == "min": Rectangle {
        Rectangle {
            x: (parent.width - 10px) / 2;
            y: (parent.height - 1.5px) / 2;
            width: 10px;
            height: 1.5px;
            background: fg;
        }
    }
    if root.kind == "max": Rectangle {
        Rectangle {
            x: (parent.width - 10px) / 2;
            y: (parent.height - 10px) / 2;
            width: 10px;
            height: 10px;
            border-width: 1px;
            border-color: fg;
            border-radius: 2px;
        }
    }
    if root.kind == "close": Rectangle {
        Path {
            x: (parent.width - 11px) / 2;
            y: (parent.height - 11px) / 2;
            width: 11px;
            height: 11px;
            viewbox-width: 11;
            viewbox-height: 11;
            stroke: fg;
            stroke-width: 1.5px;
            MoveTo { x: 0; y: 0; }
            LineTo { x: 11; y: 11; }
            MoveTo { x: 11; y: 0; }
            LineTo { x: 0; y: 11; }
        }
    }

    touch := TouchArea { clicked => { root.activate(); } }
}
