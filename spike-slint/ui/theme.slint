// Дизайн-токены и общие детали Aurora VPN — сняты со styles.css.
// Blur-эффектов в Slint нет: стекло имитируется полупрозрачными заливками.

import { Conf } from "data.slint";

export global Theme {
    // Имена семейств выбирает main.rs (ui-font, mono-font): в font-family
    // Slint помещается ровно одно имя, а в styles.css и у текста интерфейса,
    // и у моноширинного стоит стек с запасными на случай, если первого в
    // системе нет.
    in-out property <string> ui-font;
    in-out property <string> mono-font;

    // Выбранная палитра: 0 Аврора, 1 Полночь, 2 Багровая, 3 Изумруд,
    // 4 Болотная, 5 Светлая — тот же порядок, что у плиток в настройках и у
    // THEMES в themes.ts. «Как в системе» разрешает Rust: он держит
    // Conf.system-dark по настройке Windows и обновляет её на лету.
    out property <int> variant:
        Conf.theme == "midnight" ? 1
        : Conf.theme == "crimson" ? 2
        : Conf.theme == "emerald" ? 3
        : Conf.theme == "swamp" ? 4
        : Conf.theme == "light" ? 5
        : Conf.theme == "system" ? (Conf.system-dark ? 0 : 5)
        : 0;
    // Тёмная ли текущая палитра: по ней Rust красит рамку окна и пересобирает
    // амбиент-подложку.
    out property <bool> dark: root.variant != 5;

    // Палитра — таблица: строка на токен, колонка на тему в порядке variant.
    // Значения сняты с блоков [data-theme=...] в styles.css; полупрозрачные
    // записаны как #rrggbbaa, потому что в Slint нет rgba().
    pure function p(aurora: color, night: color, crimson: color, emerald: color, swamp: color, light: color) -> color {
        return root.variant == 1 ? night
            : root.variant == 2 ? crimson
            : root.variant == 3 ? emerald
            : root.variant == 4 ? swamp
            : root.variant == 5 ? light
            : aurora;
    }

    // -------------------------------------------------------- поверхности
    out property <color> bg:              p(#0a0c12, #050813, #0f080a, #040f0b, #0e1005, #eef1f8);
    out property <color> bg-elevated:     p(#12151fb8, #0c1226bd, #1a1013bd, #0a1a15bd, #181a0cc2, #ffffffd1);
    out property <color> panel:           p(#141824a8, #0f1630a8, #1e1217a8, #0c1e18a8, #1c1f0fad, #ffffffc2);
    out property <color> panel-hover:     p(#1e2436d9, #182246db, #2d1b22db, #142e25db, #2a2e18e0, #fffffff2);
    out property <color> border:          p(#5a6a9638, #5a78d238, #be5a7333, #50be9633, #a5af5a33, #3c508224);
    out property <color> border-strong:   p(#6e82b94d, #6987e152, #cd69824d, #5fcda547, #b4be6947, #374b7d3d);
    out property <color> border-hover:    p(#829bdc73, #7da0ff75, #e17d9670, #73e1b96b, #c8d27d6b, #32467866);
    out property <color> sunken:          p(#090c15b3, #070b1ab8, #130b0eb8, #07140fb8, #121408bd, #f0f3fad9);
    out property <color> sunken-deep:     p(#060910d1, #040712d6, #0c0709d6, #040d09d6, #0b0d05db, #eaeef7e6);
    out property <color> backdrop:        p(#04060bb8, #030610bd, #0c0507bd, #030c09bd, #0a0c04bd, #1e243259);
    // Тот же bg-elevated, но уже положенный на bg и потому непрозрачный.
    // В вебе диалоги и меню держит backdrop-filter: blur(30px); блюра в Slint
    // нет, и сквозь полупрозрачную панель просвечивает страница — читать её
    // невозможно. Веб-версия так же «схлопывает» меню выбора сервера.
    out property <color> elevated-solid:  p(#10121b, #0a0f21, #170e11, #081712, #16180a, #fcfcfe);

    // -------------------------------------------------------------- текст
    out property <color> text:            p(#e7eaf3, #e6ebff, #f5e9ec, #e4f5ee, #edeedb, #10131c);
    out property <color> text-dim:        p(#a2aac2, #a3b0d6, #c2a5ad, #9dc2b3, #b6b89b, #414a60);
    out property <color> text-muted:      p(#6f7893, #6d7aa3, #8a6a73, #698a7c, #808268, #6d7689);
    out property <color> log-text:        p(#c8cfe2, #c3ccec, #ddc9ce, #c4ded4, #d3d5bd, #2a3040);

    // ------------------------------------------------- акцент и состояния
    out property <color> accent:          p(#7c3aed, #4f6bff, #d01838, #0f9b6c, #76861f, #6d28d9);
    out property <color> accent-hi:       p(#8b5cf6, #6b83ff, #ef4060, #14b981, #8ea028, #7c3aed);
    out property <color> accent-deep:     p(#6d28d9, #3a52d6, #a3122b, #0a7a55, #5a6716, #5b21b6);
    out property <color> accent-2:        p(#22d3ee, #38bdf8, #fb923c, #22d3ee, #9ccc65, #0e7490);
    out property <color> accent-soft:     p(#7c3aed29, #4f6bff2e, #d018382e, #0f9b6c2e, #76861f33, #6d28d91a);
    out property <color> accent-text:     p(#c4b5fd, #a5b8ff, #fda4af, #6ee7b7, #d3dc7a, #5b21b6);
    out property <color> on-accent:       p(#ffffff, #ffffff, #ffffff, #ffffff, #ffffff, #ffffff);
    out property <color> ok:              p(#34d399, #34d399, #34d399, #7ee7b0, #34d399, #047857);
    out property <color> warn:            p(#fbbf24, #fbbf24, #fbbf24, #fbbf24, #fbbf24, #a16207);
    out property <color> danger:          p(#f87171, #f87171, #f87171, #f87171, #f87171, #dc2626);
    out property <color> danger-soft:     p(#f871711f, #f871711f, #f871711f, #f871711f, #f871711f, #dc262614);
    out property <color> warn-soft:       p(#fbbf2412, #fbbf2412, #fbbf2412, #fbbf2412, #fbbf2412, #a1620714);
    out property <color> warn-line:       p(#fbbf2452, #fbbf2452, #fbbf2452, #fbbf2452, #fbbf2452, #a162074d);
    out property <color> danger-line:     p(#f8717152, #f8717152, #f8717152, #f8717152, #f8717152, #dc262647);
    out property <color> ok-glow:         p(#34d39938, #34d39938, #34d39938, #7ee7b038, #34d39938, #0478572e);
    out property <color> ok-halo:         p(#34d39917, #34d39917, #34d39917, #7ee7b017, #34d39917, #04785714);
    // Ховер кнопки «закрыть» — один и тот же красный во всех палитрах: в
    // styles.css он задан литералом, а не токеном.
    out property <color> danger-hover:    p(#d63b3b, #d63b3b, #d63b3b, #d63b3b, #d63b3b, #d63b3b);

    // -------------------------------------------------- свет и поверхности
    out property <color> sheen:           p(#ffffff0f, #bed2ff12, #ffd2d70f, #c8ffeb0f, #f0f5c80e, #ffffffd9);
    out property <color> glow-a:          p(#7c3aed4d, #4f6bff57, #d018384d, #0f9b6c52, #76861f4d, #7c3aed24);
    out property <color> glow-b:          p(#22d3ee1f, #38bdf833, #fb923c29, #22d3ee29, #9ccc6524, #0ea5e91f);
    out property <color> glow-c:          p(#5820e82e, #1e3a8a57, #780a2061, #064e3b66, #343e0c70, #ec489914);
    out property <color> grid-line:       p(#1d2434, #16203c, #2c1c23, #132a22, #262917, #e6eaf2);
    out property <color> meter-track:     p(#1d2434, #16203c, #2c1c23, #143026, #262917, #e3e7f0);
    out property <color> switch-off:      p(#2b3348, #24304f, #402630, #1f4437, #3b3f24, #ccd3e2);
    out property <color> switch-knob:     p(#8a93ab, #8a93ab, #8a93ab, #8a93ab, #8a93ab, #ffffff);
    out property <color> toggle-off:      p(#262c3f, #262c3f, #262c3f, #262c3f, #262c3f, #262c3f);
    out property <color> scrollbar:       p(#2a3247, #253154, #462b35, #235045, #414527, #c8cfde);
    out property <color> scrollbar-hover: p(#3a4560, #35447a, #653c4a, #327063, #5c6238, #aeb7cb);

    // ------------------------------------------------- график и подложки
    out property <color> chart-down:      p(#22d3ee, #38bdf8, #fb923c, #22d3ee, #9ccc65, #0e7490);
    out property <color> chart-up:        p(#a78bfa, #7c8cff, #ef4060, #34d399, #d4c14a, #7c3aed);
    out property <color> core-from:       p(#1e2436, #14203f, #2a1620, #12332a, #262a12, #ffffff);
    out property <color> core-to:         p(#10131d, #0a1024, #170c11, #091a15, #14160a, #eef1f8);
    out property <color> core-ok-from:    p(#16302a, #16302a, #16302a, #16302a, #16302a, #ecfdf5);
    out property <color> core-ok-to:      p(#0e1a17, #0e1a17, #0e1a17, #0e1a17, #0e1a17, #d3f2e4);
    out property <color> avatar-from:     p(#2a3145, #1a2547, #33202a, #17392f, #2f331b, #e6eaf4);
    out property <color> avatar-to:       p(#1a2030, #111936, #22151b, #0f251e, #1e2110, #d8dfee);
    out property <color> core-hover-from:  p(#262d43, #1b2a52, #371d29, #184537, #31361a, #ffffff);
    out property <color> core-hover-to:    p(#141826, #0e1530, #1e1016, #0d241d, #1b1e0d, #e6eaf4);
    // Тени: во всех тёмных палитрах чёрные, в светлой — синеватые и заметно
    // слабее (--card-shadow и --shadow в styles.css). Двух хватает на всё:
    // мягкая под карточками и плотная под тем, что всплывает над страницей.
    out property <color> shadow-card:     p(#0000003d, #0000003d, #0000003d, #0000003d, #0000003d, #17203814);
    out property <color> shadow-deep:     p(#000000a8, #000000a8, #000000a8, #000000a8, #000000a8, #17203824);
    // Заливки графика — непрозрачные, хотя по макету это полупрозрачный
    // chart-down 32% / chart-up 26% поверх карточки. Причина в софтверном
    // рендере Slint: process_rectangle и градиенты пересекают клип с грязной
    // областью, а process_filled_path/process_stroked_path передают клип
    // напрямую (i-slint-renderer-software 1.17.1, lib.rs), поэтому при
    // частичной перерисовке Path красится поверх неочищенных пикселей.
    // Полупрозрачная заливка от этого копится слой за слоем: при наведении на
    // плитку график за несколько кадров анимации выцветал в ядовито-бирюзовый.
    // С непрозрачным цветом повторная отрисовка ничего не меняет.
    // Значения посчитаны смешиванием panel → bg и заливок поверх неё; амбиент
    // в счёт не идёт — фон под графиком меняется по ширине не более чем на
    // 1–2/255.
    out property <color> chart-fill-base: p(#11141e, #0c1126, #190f13, #091914, #181a0c, #fbfcfd);
    out property <color> chart-down-fill: p(#165160, #1a4869, #613920, #115459, #425328, #afd0da);
    out property <color> chart-up-fill:   p(#3c6088, #335a90, #863b31, #1a756a, #687031, #a2a9df);

    // Шаг навигации: высота строки и зазор между строками. Этими же числами
    // едет подложка активной строки (NavPill), поэтому они общие.
    out property <length> nav-row-h: 38px;
    out property <length> nav-row-gap: 3px;
}

