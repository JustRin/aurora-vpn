// Страница «Серверы» и её модальные окна — порт Servers.tsx.

import { Theme, Icons, SectionTitle, MonoText, Divider, NavIcon } from "../theme.slint";
import {
    Btn, IconBtn, Field, Input, TextArea, Select, Switch, Empty, ScrollArea,
    ModalShell, ModalFoot
} from "../widgets.slint";
import { NodeGroupSection, BalancerRow } from "../cards.slint";
import { Data, Conf, Ui, Draft } from "../data.slint";
import { Str } from "../i18n.slint";

export component ServersPage inherits ScrollArea {
    pad: 28px;

    // ------------------------------------------------------------ page head
    HorizontalLayout {
        spacing: 24px;
        VerticalLayout {
            spacing: 5px;
            horizontal-stretch: 1;
            Text {
                text: Str.nav-servers;
                color: Theme.text;
                font-size: 25px * Theme.text-scale;
                font-weight: 680;
                letter-spacing: -0.6px;
            }
            // В вебе внутри подзаголовка стоит моноширинный кусок ссылки;
            // одному Text две гарнитуры не задать, поэтому строка собрана
            // из трёх кусков.
            HorizontalLayout {
                spacing: 5px;
                alignment: start;
                Text {
                    text: Str.srv-subtitle-before;
                    vertical-alignment: center;
                    color: Theme.text-muted;
                    font-size: 12.5px * Theme.text-scale;
                }
                MonoText {
                    text: "vless://";
                    vertical-alignment: center;
                    color: Theme.text-muted;
                }
                Text {
                    text: Str.srv-subtitle-after;
                    vertical-alignment: center;
                    color: Theme.text-muted;
                    font-size: 12.5px * Theme.text-scale;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 10px;
                Btn {
                    // Во время обхода — счётчик: «37 / 111». Иначе шесть секунд
                    // тишины неотличимы от зависания.
                    label: Data.test-progress == "" ? Str.dash-test-latency : Data.test-progress;
                    icon: Icons.gauge;
                    busy: Data.testing;
                    enabled: !Data.testing && Data.nodes.length > 0;
                    clicked => { Data.test-latency(); }
                }
                Btn {
                    label: "WARP";
                    icon: Icons.cloud;
                    enabled: !Data.warp-busy;
                    clicked => { Data.warp-add-node(); }
                }
                Btn {
                    label: Str.srv-add-btn;
                    icon: Icons.plus;
                    kind: "primary";
                    clicked => { Ui.modal = 1; }
                }
            }
        }
    }
    Rectangle { height: 24px; }

    // ------------------------------------------------------ балансировщики
    // Стратегии стоят в одном списке с серверами, отдельными пунктами: так их
    // видно и включают их тем же жестом, что и сервер. Одному серверу выбирать
    // не из чего — раздел появляется со второго.
    if Data.nodes.length >= 2: VerticalLayout {
        spacing: 8px;
        SectionTitle { text: Str.pick-balancers-caps; }
        Rectangle { height: 4px; }
        for kind in [1, 2, 3]: BalancerRow {
            kind: kind;
            select => { Conf.balancer = kind; }
        }
        Rectangle { height: 14px; }
    }

    // ------------------------------------------------- подписки и серверы
    // Одним списком: подписка — заголовок раздела, её серверы раскрываются
    // под ним. Отдельной полосы карточек больше нет — на четвёртой подписке
    // она уезжала за край окна.
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            SectionTitle {
                text: Data.nodes.length > 0
                    ? "\{Str.nav-servers-caps} (\{Data.nodes.length})"
                    : Str.nav-servers-caps;
            }
        }
        if Data.subs.length > 0: Btn {
            label: Str.srv-refresh-all;
            icon: Icons.refresh;
            kind: "ghost";
            small: true;
            busy: Data.refreshing;
            enabled: !Data.refreshing;
            clicked => { Data.refresh-subs(); }
        }
    }
    Rectangle { height: 12px; }

    if Data.nodes.length == 0: Empty {
        icon: Icons.server;
        title: Str.srv-empty-title;
        text: Str.srv-empty-text;
        Btn {
            label: Str.srv-paste-links;
            icon: Icons.plus;
            kind: "primary";
            clicked => { Ui.modal = 1; }
        }
    }

    if Data.nodes.length > 0: VerticalLayout {
        spacing: 10px;
        // Подсвечен ровно один пункт списка: при ручном выборе — сервер, при
        // балансировщике — его строка, а серверу достаётся отметка «сейчас».
        for group in Data.groups: NodeGroupSection {
            group: group;
            active-id: Conf.balancer == 0 ? Data.active-id : "";
            routed-id: Conf.balancer != 0 ? Data.active-id : "";
            toggle => { Data.toggle-group(group.sub.id); }
            refresh => { Data.refresh-sub(group.sub.id); }
            remove => { Data.delete-sub(group.sub.id); }
            select(id) => { Data.select-server(id); }
            copy-link(id) => { Data.copy-link(id); }
            edit(id) => { Data.edit-server(id); }
            remove-node(id) => { Data.delete-server(id); }
            reorder(id, to) => { Data.reorder-node(id, to); }
        }
    }

    Rectangle { height: 20px; }
    HorizontalLayout {
        alignment: center;
        Btn {
            label: Str.srv-add-manually;
            icon: Icons.plus;
            kind: "ghost";
            small: true;
            clicked => { Data.new-server(); }
        }
    }
}

// Вставка ссылок — ImportModal из Servers.tsx.
export component ImportModal inherits ModalShell {
    title: Str.srv-add-servers;
    close => { Ui.modal = 0; }
    VerticalLayout {
        padding: 18px;
        spacing: 13px;
        Field {
            label: Str.srv-links-label;
            hint: Str.srv-links-hint;
            TextArea {
                min-height: 190px;
                text <=> Ui.import-text;
                placeholder: Str.srv-link-placeholder;
            }
        }
        Divider { }
        // Три источника QR-кода. Прочитанное дописывается в поле выше, поэтому
        // ряд стоит под ним, а не отдельным окном.
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Btn {
                label: Str.srv-paste-btn;
                icon: Icons.clipboard-paste;
                small: true;
                clicked => { Data.paste-links(); }
            }
            // Тонкая черта: слева то, что кладут в поле как есть, справа — то,
            // что сначала надо прочитать с картинки.
            Rectangle {
                width: 1px;
                background: Theme.border;
                horizontal-stretch: 0;
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 6px;
                    padding-right: 2px;
                    VerticalLayout {
                        alignment: center;
                        NavIcon {
                            width: 14px;
                            height: 14px;
                            commands: Icons.scan-line;
                            tint: Theme.text-muted;
                            stroke-width: 1.5px;
                        }
                    }
                    Text {
                        text: Str.qr-scan;
                        vertical-alignment: center;
                        // Единственное здесь, что можно ужать: если языку не
                        // хватит ширины, отступит подпись, а не кнопки.
                        overflow: elide;
                        font-size: 12px * Theme.text-scale;
                        color: Theme.text-muted;
                    }
                }
            }
            Btn {
                label: Str.qr-screen;
                icon: Icons.monitor;
                small: true;
                enabled: !Ui.qr-busy;
                clicked => { Data.scan-screen(); }
            }
            Btn {
                label: Str.qr-file;
                icon: Icons.picture;
                small: true;
                enabled: !Ui.qr-busy;
                clicked => { Data.scan-file(); }
            }
            Btn {
                label: Str.qr-camera;
                icon: Icons.camera;
                small: true;
                enabled: !Ui.qr-busy;
                clicked => { Data.open-camera(); }
            }
        }
    }
    ModalFoot {
        Btn {
            label: Str.srv-cancel;
            clicked => { Ui.modal = 0; }
        }
        Btn {
            label: Str.srv-import-btn;
            kind: "primary";
            enabled: Ui.import-text != "";
            clicked => { Data.import-links(Ui.import-text); }
        }
    }
}

// Полоска режима «считать с экрана»: окно ужимается до неё и встаёт поверх
// остальных окон. Снимок делается по кнопке, а не сразу, потому что сперва
// нужно открыть то, где код показан, — сайт, переписку, картинку.
export component ScanBar inherits Rectangle {
    background: Theme.elevated-solid;
    border-width: 1px;
    border-color: Theme.border-strong;
    border-radius: 12px;

    // Тянуть можно за что угодно: полоска легко встаёт поверх самого кода, и
    // увести её должно быть можно не целясь.
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                Data.scan-move();
            }
        }
    }

    VerticalLayout {
        padding: 9px;
        padding-left: 11px;
        padding-right: 7px;
        spacing: 3px;

        HorizontalLayout {
            spacing: 8px;
            Btn {
                label: Str.qr-overlay-scan;
                icon: Icons.scan-line;
                kind: "primary";
                small: true;
                enabled: !Ui.qr-busy;
                clicked => { Data.scan-now(); }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: Icons.close;
                    ghost: true;
                    compact: true;
                    clicked => { Data.scan-exit(); }
                }
            }
        }
        Text {
            text: Ui.scan-empty ? Str.qr-nothing : Str.qr-overlay-hint;
            vertical-alignment: center;
            overflow: elide;
            font-size: 11px * Theme.text-scale;
            color: Ui.scan-empty ? Theme.warn : Theme.text-muted;
        }
    }
}

// Предпросмотр камеры — CameraScanner из QrScanner.tsx. Своя оболочка, а не
// ModalShell: в шапке живут ещё две кнопки, а развёрнутое окно занимает всё, что
// есть, — так код читается с большего расстояния.
export component CameraModal inherits Rectangle {
    background: Theme.backdrop;
    // Что показать поверх кадра: отказ, ожидание или ничего.
    property <string> message: Ui.camera-error != ""
        ? Ui.camera-error
        : (Ui.camera-live ? "" : Str.qr-starting);

    TouchArea {
        clicked => { Data.close-camera(); }
    }
    VerticalLayout {
        alignment: center;
        padding: Ui.camera-expanded ? 0px : 24px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: Ui.camera-expanded ? root.width : min(560px, root.width - 48px);
                // Высота задана, а не собрана из содержимого: у предпросмотра
                // её задавал бы кадр, и окно прыгало бы на каждую смену камеры.
                height: Ui.camera-expanded ? root.height : min(520px, root.height - 48px);
                background: Theme.elevated-solid;
                border-radius: Ui.camera-expanded ? 0px : 20px;
                border-width: Ui.camera-expanded ? 0px : 1px;
                border-color: Theme.border-strong;
                clip: true;
                // Свой перехват: клик по окну не должен доходить до подложки.
                TouchArea { }

                VerticalLayout {
                    HorizontalLayout {
                        padding: 16px;
                        padding-left: 18px;
                        padding-right: 12px;
                        spacing: 8px;
                        vertical-stretch: 0;
                        Text {
                            text: Str.qr-title;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-size: 15px * Theme.text-scale;
                            font-weight: 650;
                            color: Theme.text;
                        }
                        // Вторая камера появляется в списке только тогда, когда
                        // она в системе есть, — переключать нечего иначе.
                        if Ui.cameras.length > 1: VerticalLayout {
                            alignment: center;
                            IconBtn {
                                icon: Icons.switch-camera;
                                ghost: true;
                                clicked => { Data.next-camera(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconBtn {
                                icon: Ui.camera-expanded ? Icons.minimize : Icons.maximize;
                                ghost: true;
                                clicked => { Ui.camera-expanded = !Ui.camera-expanded; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconBtn {
                                icon: Icons.close;
                                ghost: true;
                                clicked => { Data.close-camera(); }
                            }
                        }
                    }
                    Divider { }

                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 300px;
                        // Чёрный, а не цвет темы: это нутро объектива, а не
                        // поверхность интерфейса, и оно одинаково в любой палитре.
                        background: #000000;
                        clip: true;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: Ui.camera-frame;
                            // contain, а не cover: наводят по тому, что видно,
                            // и обрезать кадр под форму окна значит обрезать
                            // как раз то, что человек держит у края.
                            image-fit: ImageFit.contain;
                        }
                        // Прицел. Единственная подсказка, куда наводить: код
                        // должен уместиться внутрь, иначе его модули не переживут
                        // уменьшение кадра.
                        Rectangle {
                            visible: Ui.camera-live && Ui.camera-error == "";
                            width: min(parent.width, parent.height) * 0.64;
                            height: self.width;
                            // Внутри прямоугольника ничего не центрируется само.
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            border-width: 2px;
                            border-color: Theme.accent-hi;
                            border-radius: 16px;
                        }
                        if root.message != "": Rectangle {
                            width: min(parent.width * 0.82, txt.preferred-width + 28px);
                            height: txt.preferred-height + 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            background: #00000094;
                            border-radius: 8px;
                            txt := Text {
                                width: parent.width - 28px;
                                x: 14px;
                                y: 9px;
                                text: root.message;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                font-size: 13px * Theme.text-scale;
                                color: #ffffff;
                            }
                        }
                    }

                    // Строка подсказки держит своё место всегда: без неё окно
                    // дёргалось бы на каждую смену камеры.
                    Rectangle {
                        height: 41px;
                        vertical-stretch: 0;
                        Text {
                            text: Ui.camera-error == "" ? Str.qr-hint : "";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 12px * Theme.text-scale;
                            color: Theme.text-muted;
                        }
                    }
                }
            }
        }
    }
}

// Редактор сервера — NodeEditor из Servers.tsx. Поля появляются по тем же
// правилам: что нужно протоколу, транспорту и типу шифрования.
export component NodeEditorModal inherits ModalShell {
    title: Draft.is-new ? Str.srv-new-server : Str.srv-server-params;
    wide: true;
    close => { Ui.modal = 0; }

    ScrollArea {
        pad: 18px;
        content-spacing: 14px;
        // Без собственной высоты диалог схлопывался в пустую полоску: лента
        // внутри ScrollArea позиционируется сама, поэтому раскладка берёт её
        // минимум как есть — а он нулевой. Та же поправка, что в split.slint:
        // растём вместе с окном, но не перерастаем его.
        min-height: clamp(root.height - 200px, 240px, 620px);

        HorizontalLayout {
            spacing: 14px;
            Field {
                label: Str.srv-name-label;
                horizontal-stretch: 1;
                Input { text <=> Draft.name; }
            }
            Field {
                label: Str.srv-protocol-label;
                horizontal-stretch: 1;
                Select {
                    options: ["VLESS", "VMess", "Trojan", "Shadowsocks", "Hysteria2", "TUIC"];
                    current <=> Draft.protocol;
                }
            }
        }

        HorizontalLayout {
            spacing: 14px;
            Field {
                label: Str.srv-address-label;
                horizontal-stretch: 1;
                Input {
                    text <=> Draft.address;
                    placeholder: "example.com";
                }
            }
            Field {
                label: Str.srv-port-label;
                horizontal-stretch: 1;
                Input { text <=> Draft.port; }
            }
        }

        if Draft.needs-uuid || Draft.needs-password: HorizontalLayout {
            spacing: 14px;
            if Draft.needs-uuid: Field {
                label: "UUID";
                horizontal-stretch: 1;
                Input {
                    text <=> Draft.uuid;
                    mono: true;
                }
            }
            if Draft.needs-password: Field {
                label: Str.srv-password-label;
                horizontal-stretch: 1;
                Input {
                    text <=> Draft.password;
                    mono: true;
                }
            }
            // Одинокое поле остаётся в половину ширины, как ячейка grid-2.
            if !(Draft.needs-uuid && Draft.needs-password): Rectangle {
                horizontal-stretch: 1;
            }
        }

        if Draft.protocol == 3: HorizontalLayout {
            spacing: 14px;
            Field {
                label: Str.srv-encryption-label;
                horizontal-stretch: 1;
                Input { text <=> Draft.method; }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        if Draft.has-transport: HorizontalLayout {
            spacing: 14px;
            Field {
                label: Str.srv-transport-label;
                horizontal-stretch: 1;
                Select {
                    options: ["tcp", "ws", "grpc", "http", "httpupgrade"];
                    current <=> Draft.network;
                }
            }
            Field {
                label: Str.srv-channel-encryption-label;
                horizontal-stretch: 1;
                Select {
                    options: [Str.fmt-no-tls, "TLS", "REALITY"];
                    current <=> Draft.security;
                }
            }
        }

        if Draft.has-transport && Draft.network != 0: HorizontalLayout {
            spacing: 14px;
            Field {
                label: "Path";
                horizontal-stretch: 1;
                Input {
                    text <=> Draft.path;
                    mono: true;
                    placeholder: "/";
                }
            }
            Field {
                label: "Host";
                horizontal-stretch: 1;
                Input { text <=> Draft.host; }
            }
        }

        if Draft.has-transport && Draft.network == 2: HorizontalLayout {
            spacing: 14px;
            Field {
                label: "serviceName";
                horizontal-stretch: 1;
                Input {
                    text <=> Draft.service-name;
                    mono: true;
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        if Draft.security != 0: HorizontalLayout {
            spacing: 14px;
            Field {
                label: "SNI";
                horizontal-stretch: 1;
                Input { text <=> Draft.sni; }
            }
            Field {
                label: Str.srv-tls-fingerprint-label;
                horizontal-stretch: 1;
                Input {
                    text <=> Draft.fingerprint;
                    placeholder: "chrome";
                }
            }
        }

        if Draft.security == 2: HorizontalLayout {
            spacing: 14px;
            Field {
                label: "Public key (pbk)";
                horizontal-stretch: 1;
                Input {
                    text <=> Draft.public-key;
                    mono: true;
                }
            }
            Field {
                label: "Short id (sid)";
                horizontal-stretch: 1;
                Input {
                    text <=> Draft.short-id;
                    mono: true;
                }
            }
        }

        if Draft.protocol == 0 && Draft.security != 0: HorizontalLayout {
            spacing: 14px;
            Field {
                label: "Flow";
                hint: Str.srv-flow-hint;
                horizontal-stretch: 1;
                Input {
                    text <=> Draft.flow;
                    mono: true;
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        if Draft.security == 1: HorizontalLayout {
            spacing: 16px;
            padding-top: 4px;
            VerticalLayout {
                spacing: 2px;
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: Str.srv-skip-cert-label;
                    color: Theme.text;
                    font-size: 13.5px * Theme.text-scale;
                    font-weight: 500;
                }
                Text {
                    text: Str.srv-skip-cert-desc;
                    color: Theme.text-muted;
                    font-size: 12px * Theme.text-scale;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                Switch { checked <=> Draft.allow-insecure; }
            }
        }

        // Ссылка обмена не несёт флага mux, поэтому у нового сервера его нет:
        // он появляется, когда узел уже существует.
        if !Draft.is-new && Draft.has-transport: HorizontalLayout {
            spacing: 16px;
            padding-top: 4px;
            VerticalLayout {
                spacing: 2px;
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: Str.srv-mux-label;
                    color: Theme.text;
                    font-size: 13.5px * Theme.text-scale;
                    font-weight: 500;
                }
                Text {
                    text: Str.srv-mux-desc;
                    color: Theme.text-muted;
                    font-size: 12px * Theme.text-scale;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                Switch { checked <=> Draft.mux; }
            }
        }
    }

    ModalFoot {
        Btn {
            label: Str.srv-cancel;
            clicked => { Ui.modal = 0; }
        }
        Btn {
            label: Str.srv-save-btn;
            kind: "primary";
            enabled: Draft.name != "" && Draft.address != "";
            clicked => { Data.save-draft(); }
        }
    }
}
