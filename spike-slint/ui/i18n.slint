// Строки интерфейса. Значения — те же, что в src/lib/locales/{ru,en}.ts:
// имя свойства собрано из ключа словаря, поэтому одну и ту же строку легко
// найти и здесь, и там. Строки, которых в вебе нет (карточка ресурсов спайка),
// идут в конце.
//
// Журнал не переводится намеренно: там вывод самого движка.

import { Conf } from "data.slint";

export global Str {
    // Conf.language: 0 как в системе, 1 русский, 2 английский. «Как в системе»
    // разрешает Rust — Conf.system-en по локали Windows, тем же правилом, что
    // resolveLang в i18n.ts: русский только для локалей на ru.
    out property <bool> en: Conf.language == 2 || (Conf.language == 0 && Conf.system-en);

    out property <string> fmt-never:             root.en ? "never" : "никогда";
    out property <string> fmt-just-now:          root.en ? "just now" : "только что";
    out property <string> fmt-min-ago:           root.en ? "{n} min ago" : "{n} мин назад";
    out property <string> fmt-hours-ago:         root.en ? "{n} h ago" : "{n} ч назад";
    out property <string> fmt-days-ago:          root.en ? "{n} d ago" : "{n} дн назад";
    out property <string> fmt-day-forms:         root.en ? "day|days|days" : "день|дня|дней";
    out property <string> fmt-no-expiry:         root.en ? "no expiry" : "бессрочно";
    out property <string> fmt-expired:           root.en ? "expired" : "истекла";
    out property <string> fmt-expires-today:     root.en ? "expires today" : "истекает сегодня";
    out property <string> srv-updated-when:      root.en ? "updated {when}" : "обновлено {when}";
    out property <string> srv-server-one:        root.en ? "server" : "сервер";
    out property <string> srv-server-few:        root.en ? "servers" : "сервера";
    out property <string> srv-server-many:       root.en ? "servers" : "серверов";
    // Раздел для серверов, добавленных руками: подписки у них нет, а место
    // в списке разделов нужно.
    out property <string> srv-own-group:         root.en ? "Own servers" : "Свои серверы";
    out property <string> srv-expired-warning:   root.en ? "The subscription has expired — the servers most likely no longer respond." : "Срок действия истёк — серверы, скорее всего, уже не отвечают.";
    out property <string> srv-exhausted-warning: root.en ? "Data limit reached — renew your plan in the panel." : "Трафик исчерпан — продлите тариф в панели.";
    out property <string> dash-state-connecting: root.en ? "Connecting" : "Подключение";
    out property <string> dash-state-error:      root.en ? "Error" : "Ошибка";
    out property <string> tray-show:                root.en ? "Show window" : "Показать окно";
    out property <string> tray-connect:             root.en ? "Connect" : "Подключить";
    out property <string> tray-disconnect:          root.en ? "Disconnect" : "Отключить";
    out property <string> tray-quit:                root.en ? "Quit" : "Выход";
    out property <string> set-country-data:      root.en ? "Country data" : "Данные о странах";
    out property <string> set-country-source:    "IP Geolocation by DB-IP (CC BY 4.0)";
    out property <string> set-notifications:                  root.en ? "Windows notifications" : "Уведомления Windows";
    out property <string> set-notifications-desc:             root.en ? "The tunnel going up or down is reported to the notification centre. The first time this is switched on, a Start menu shortcut is created — without it Windows refuses to accept notifications from the app." : "О поднятии и падении туннеля сообщает центр уведомлений. При первом включении создаётся ярлык в меню «Пуск» — без него Windows не принимает уведомления от приложения.";
    out property <string> notify-connected-title:             root.en ? "Connected" : "Подключено";
    out property <string> notify-disconnected-title:          root.en ? "Disconnected" : "Отключено";
    out property <string> notify-error-title:                 root.en ? "Connection error" : "Ошибка подключения";
    out property <string> notify-orphan-title:                root.en ? "A core from a previous session" : "Ядро от прошлого сеанса";
    out property <string> notify-orphan-body:                 root.en ? "The connection stopped: sing-box from an earlier session is still running. Open Aurora VPN to decide what to do with it." : "Подключение остановлено: sing-box от прошлого сеанса всё ещё работает. Откройте Aurora VPN, чтобы решить, что с ним делать.";
    out property <string> set-autostart-failed:               root.en ? "Could not change autostart" : "Не удалось изменить автозапуск";
    // Строки, которые подставляет сам Rust: единицы, состояния, тосты и
    // демо-данные. Он снимает с них копию (Lang в main.rs) — читать глобал на
    // каждый тик графика дороже, чем держать снимок.
    out property <string> srv-latency-ms:          root.en ? "{ms} ms" : "{ms} мс";
    out property <string> dash-na:                 root.en ? "n/a" : "н/д";
    out property <string> split-instances-count:   root.en ? "{count} processes" : "{count} проц.";
    out property <string> graph-peak:              root.en ? "peak" : "пик";
    out property <string> fmt-per-second:          root.en ? "/s" : "/с";
    out property <string> fmt-byte-units:          root.en ? "B|KB|MB|GB|TB" : "Б|КБ|МБ|ГБ|ТБ";
    out property <string> dash-state-connected:    root.en ? "Connected" : "Подключено";
    out property <string> dash-state-disconnected: root.en ? "Disconnected" : "Отключено";
    out property <string> srv-server-deleted:      root.en ? "Server “{name}” deleted" : "Сервер «{name}» удалён";
    out property <string> srv-link-copied:         root.en ? "Link copied" : "Ссылка скопирована";
    out property <string> srv-server-saved:        root.en ? "Server saved" : "Сервер сохранён";
    out property <string> srv-server-added:        root.en ? "Server added" : "Сервер добавлен";
    out property <string> srv-report-no-new:       root.en ? "No new servers" : "Новых серверов нет";
    out property <string> srv-report-added:        root.en ? "added {n}" : "добавлено {n}";
    out property <string> split-already-in-list:   root.en ? "This program is already in the list" : "Эта программа уже в списке";
    out property <string> logs-copied:             root.en ? "Log copied" : "Журнал скопирован";
    out property <string> dash-conns-closed:       root.en ? "Connections closed" : "Соединения разорваны";
    out property <string> spike-imported:          root.en ? "Imported {n}" : "Импортированный {n}";
    out property <string> spike-latency-updated:   root.en ? "Latency updated" : "Задержка обновлена";
    out property <string> spike-sub-refreshed:     root.en ? "Subscription updated" : "Подписка обновлена";
    out property <string> spike-sub-deleted:       root.en ? "Subscription “{name}” deleted" : "Подписка «{name}» удалена";
    out property <string> spike-apps-cleared:      root.en ? "App list cleared" : "Список приложений очищен";
    out property <string> spike-apps-added:        root.en ? "Apps added: {n}" : "Добавлено приложений: {n}";
    out property <string> spike-update-demo:       root.en ? "Update installed — a demo only in the spike" : "Обновление установлено — в спайке только демонстрация";
    out property <string> spike-demo-expiry:       root.en ? "27 days" : "27 дней";
    out property <string> spike-demo-traffic:      root.en ? "184 / 500 GB" : "184 / 500 ГБ";
    out property <string> spike-demo-foot-1:       root.en ? "12 servers · updated 5 min ago" : "12 серверов · обновлено 5 мин назад";
    out property <string> spike-demo-sub-name:     root.en ? "Backup panel" : "Резервная панель";
    out property <string> spike-demo-foot-2:       root.en ? "3 servers · updated 2 h ago" : "3 сервера · обновлено 2 ч назад";

    out property <string> app-loading:                        root.en ? "Loading…" : "Загрузка…";
    out property <string> nav-dashboard:                      root.en ? "Overview" : "Обзор";
    out property <string> nav-servers:                        root.en ? "Servers" : "Серверы";
    out property <string> nav-servers-caps:                   root.en ? "SERVERS" : "СЕРВЕРЫ";
    out property <string> nav-split:                          root.en ? "Split tunneling" : "Раздельный туннель";
    out property <string> nav-routing:                        root.en ? "Routing" : "Маршрутизация";
    out property <string> nav-logs:                           root.en ? "Log" : "Журнал";
    out property <string> nav-settings:                       root.en ? "Settings" : "Настройки";
    out property <string> bar-system-proxy:                   root.en ? "System proxy" : "Системный прокси";
    out property <string> bar-disconnected:                   root.en ? "disconnected" : "отключено";
    out property <string> side-update:                        root.en ? "Update" : "Обновление";
    out property <string> side-admin:                         root.en ? "administrator rights" : "права администратора";
    out property <string> side-user:                          root.en ? "regular rights" : "обычные права";
    out property <string> theme-dark:                         root.en ? "Aurora" : "Аврора";
    out property <string> theme-midnight:                     root.en ? "Midnight" : "Полночь";
    out property <string> theme-crimson:                      root.en ? "Crimson" : "Багровая";
    out property <string> theme-emerald:                      root.en ? "Emerald" : "Изумруд";
    out property <string> theme-swamp:                        root.en ? "Swamp" : "Болотная";
    out property <string> theme-light:                        root.en ? "Light" : "Светлая";
    out property <string> theme-system:                       root.en ? "Follow system" : "Как в системе";
    out property <string> set-subtitle:                       root.en ? "Changes apply immediately; with an active connection the core restarts automatically." : "Изменения применяются сразу; при активном подключении ядро перезапускается автоматически.";
    out property <string> set-data-folder:                    root.en ? "Data folder" : "Папка данных";
    out property <string> set-tab-core:                       root.en ? "Core" : "Ядро";
    out property <string> set-tab-client:                     root.en ? "Client" : "Клиент";
    out property <string> set-tunnel-section-caps:            root.en ? "TUNNEL" : "ТУННЕЛЬ";
    out property <string> set-tunnel-mode:                    root.en ? "Mode" : "Режим работы";
    out property <string> set-tunnel-mode-tun-desc:           root.en ? "TUN — a Wintun virtual adapter captures traffic system-wide. Needs administrator rights, but per-app rules work." : "TUN — виртуальный адаптер Wintun перехватывает трафик всей системы. Нужны права администратора, зато работают правила по приложениям.";
    out property <string> set-tunnel-mode-proxy-desc:         root.en ? "System proxy — no administrator rights, but only covers apps that honour the system proxy settings." : "Системный прокси — без прав администратора, но охватывает только приложения, которые читают системные настройки прокси.";
    out property <string> set-tun-needs-admin:                root.en ? "The app is running without administrator rights — connecting in TUN mode will offer a restart." : "Приложение запущено без прав администратора — подключение в режиме TUN предложит перезапуск.";
    out property <string> set-tun-section-caps:               root.en ? "TUN OPTIONS" : "ПАРАМЕТРЫ TUN";
    out property <string> set-tun-stack:                      root.en ? "Network stack" : "Сетевой стек";
    out property <string> set-tun-stack-hint:                 root.en ? "mixed — gVisor for TCP and the system stack for UDP: the best speed/compatibility trade-off." : "mixed — gVisor для TCP и системный для UDP: лучший баланс скорости и совместимости.";
    out property <string> set-tun-stack-mixed:                root.en ? "mixed (recommended)" : "mixed (рекомендуется)";
    out property <string> set-mtu-hint:                       root.en ? "Default is 9000." : "По умолчанию 9000.";
    out property <string> set-strict-route:                   root.en ? "Strict routing" : "Строгая маршрутизация";
    out property <string> set-strict-route-desc:              root.en ? "Blocks traffic from escaping the tunnel. Turn it off if VirtualBox/WSL or online games stop working." : "Блокирует попытки трафика уйти в обход туннеля. Отключите, если перестают работать VirtualBox/WSL или сетевые игры.";
    out property <string> set-ipv6:                           root.en ? "IPv6 support" : "Поддержка IPv6";
    out property <string> set-ipv6-desc:                      root.en ? "Off — DNS answers with A records only. Enable when your ISP and the server actually support IPv6." : "Выключено — DNS отдаёт только A-записи. Включайте, если провайдер и сервер действительно поддерживают IPv6.";
    out property <string> set-fake-ip-desc:                   root.en ? "Speeds up page opens: domains resolve instantly and the real address is resolved by the server. May confuse some local services." : "Ускоряет открытие сайтов: домен резолвится мгновенно, а настоящий адрес узнаёт уже сервер. Может мешать некоторым локальным сервисам.";
    out property <string> set-dns-remote:                     root.en ? "DNS via VPN" : "DNS через VPN";
    out property <string> set-dns-remote-hint:                root.en ? "Used for domains going through the tunnel. tls:// and https:// work too." : "Используется для доменов, идущих в туннель. Можно указать tls:// или https://.";
    out property <string> set-dns-direct:                     root.en ? "Direct DNS" : "DNS напрямую";
    out property <string> set-dns-direct-hint:                root.en ? "For domains bypassing the tunnel and for resolving the server's own address." : "Для доменов в обход туннеля и для резолва адреса самого сервера.";
    out property <string> set-conn-section-caps:              root.en ? "CONNECTION" : "ПОДКЛЮЧЕНИЕ";
    out property <string> set-mixed-port:                     root.en ? "SOCKS/HTTP port" : "Порт SOCKS/HTTP";
    out property <string> set-mixed-port-hint:                root.en ? "Local mixed proxy." : "Локальный смешанный прокси.";
    out property <string> set-clash-port:                     root.en ? "Core control port" : "Порт панели управления ядром";
    out property <string> set-clash-port-hint:                root.en ? "Clash API on 127.0.0.1." : "Clash API на 127.0.0.1.";
    out property <string> set-latency-url:                    root.en ? "Latency test URL" : "URL для проверки задержки";
    out property <string> set-latency-url-hint:               root.en ? "The request goes through the selected server." : "Запрос уходит через выбранный сервер.";
    out property <string> set-log-level:                      root.en ? "Log level" : "Уровень журнала";
    out property <string> set-allow-lan:                      root.en ? "LAN access" : "Доступ из локальной сети";
    out property <string> set-allow-lan-desc:                 root.en ? "The proxy listens on 0.0.0.0 so other devices on the network can use it. Enable only on a trusted network." : "Прокси слушает 0.0.0.0 — другие устройства в сети смогут им пользоваться. Включайте только в доверенной сети.";
    out property <string> set-auto-select:                    root.en ? "Pick the fastest server" : "Выбирать самый быстрый сервер";
    out property <string> set-auto-select-desc:               root.en ? "The core switches to the lowest-latency server on its own and re-checks every 3 minutes." : "Ядро само переключается на сервер с наименьшей задержкой и перепроверяет раз в 3 минуты.";
    out property <string> set-subs-section-caps:              root.en ? "SUBSCRIPTIONS" : "ПОДПИСКИ";
    out property <string> set-sub-auto:                       root.en ? "Refresh automatically" : "Обновлять автоматически";
    out property <string> set-sub-auto-desc:                  root.en ? "The server list, data allowance and expiry are pulled from the panel in the background. A silently stale list is the most common reason a client suddenly stops connecting." : "Список серверов, остаток трафика и срок действия подтягиваются с панели в фоне. Устаревший список — самая частая причина, по которой клиент внезапно перестаёт подключаться.";
    out property <string> set-sub-every-off:                  root.en ? "Never" : "Не обновлять";
    out property <string> set-sub-every3h:                    root.en ? "every 3 hours" : "каждые 3 часа";
    out property <string> set-sub-every6h:                    root.en ? "every 6 hours" : "каждые 6 часов";
    out property <string> set-sub-every12h:                   root.en ? "every 12 hours" : "каждые 12 часов";
    out property <string> set-sub-every-day:                  root.en ? "once a day" : "раз в сутки";
    out property <string> set-language-section-caps:          root.en ? "ЯЗЫК / LANGUAGE" : "ЯЗЫК / LANGUAGE";
    out property <string> set-language:                       root.en ? "Interface language" : "Язык интерфейса";
    out property <string> set-language-desc:                  root.en ? "“Follow system” tracks the operating system language. Core lines in the log stay in the engine's own language." : "«Как в системе» следует за языком операционной системы. Тексты ядра в журнале остаются на языке движка.";
    out property <string> set-theme-section-caps:             root.en ? "APPEARANCE" : "ВНЕШНИЙ ВИД";
    out property <string> set-theme:                          root.en ? "Theme" : "Тема оформления";
    out property <string> set-theme-desc:                     root.en ? "“Follow system” tracks the OS setting and switches by itself, including on its light/dark schedule." : "«Как в системе» следует за настройкой системы и переключается сама, в том числе по её расписанию светлой и тёмной темы.";
    out property <string> set-startup-section-caps:           root.en ? "STARTUP" : "ЗАПУСК";
    out property <string> set-autostart:                      root.en ? "Start with Windows" : "Запускать вместе с Windows";
    out property <string> set-autostart-desc:                 root.en ? "The app starts when you sign in." : "Приложение стартует при входе в систему.";
    out property <string> set-autostart-elevated:             root.en ? "Start with administrator rights" : "Запускать сразу с правами администратора";
    out property <string> set-autostart-elevated-desc:        root.en ? "Creates a Windows Task Scheduler task: the app starts elevated and brings TUN up right away — no UAC prompt. Manual launches go through the task too, so an “as administrator” restart is never needed." : "Создаст задачу в планировщике Windows: приложение будет стартовать с правами администратора и сразу поднимать TUN — без запроса UAC. Ручной запуск ярлыком тоже пойдёт через неё, поэтому перезапуск «от администратора» больше не понадобится.";
    out property <string> set-autostart-elevated-needs-admin: root.en ? "Needs a one-time restart with administrator rights to register the scheduled task." : "Требуется однократный перезапуск с правами администратора, чтобы зарегистрировать задачу в планировщике.";
    out property <string> set-autostart-normal-warn:          root.en ? "Plain autostart cannot bring TUN up: after sign-in the app will ask for rights. Enable the toggle above to avoid that." : "Обычная автозагрузка не может поднять режим TUN: после входа в систему приложение запросит права. Включите переключатель выше, чтобы этого не происходило.";
    out property <string> set-auto-connect:                   root.en ? "Connect on launch" : "Подключаться при запуске";
    out property <string> set-start-minimized:                root.en ? "Start minimized to tray" : "Запускать свёрнутым в трей";
    out property <string> set-close-to-tray:                  root.en ? "Closing the window minimizes to tray" : "Закрытие окна сворачивает в трей";
    out property <string> set-close-to-tray-desc:             root.en ? "Off — the close button quits completely and drops the connection." : "Выключено — крестик полностью завершает работу и разрывает соединение.";
    out property <string> set-resources-section-caps:         root.en ? "RESOURCE USAGE" : "ПОТРЕБЛЕНИЕ РЕСУРСОВ";
    out property <string> set-res-core:                       root.en ? "sing-box core" : "Ядро sing-box";
    out property <string> set-about-section-caps:             root.en ? "ABOUT" : "О ПРИЛОЖЕНИИ";
    out property <string> set-app-version:                    root.en ? "App version" : "Версия приложения";
    out property <string> fmt-no-tls:                         root.en ? "no TLS" : "без TLS";
    out property <string> dash-subtitle:                      root.en ? "Tunnel state, speed, and routing mode." : "Состояние туннеля, скорость и режим маршрутизации.";
    // Третьего режима, «Напрямую», на переключателе нет: он и означал «трафик
    // мимо VPN», а для этого проще выключить туннель кнопкой питания. Ядро его
    // понимает по-прежнему (route-правило clash_mode), так что внешний
    // клиент Clash API им пользоваться может.
    out property <string> dash-mode-rule:                     root.en ? "Rules" : "По правилам";
    out property <string> dash-mode-global:                   root.en ? "Everything via VPN" : "Всё через VPN";
    // Подпись под переключателем режима: без неё два слова ничего не говорят
    // тому, кто открыл клиент впервые.
    out property <string> dash-mode-rule-help:                root.en ? "Everyday mode: what goes through the VPN is decided by the “Split tunneling” and “Routing” pages." : "Обычный режим: что идёт через VPN, решают страницы «Раздельный туннель» и «Маршрутизация».";
    out property <string> dash-mode-global-help:              root.en ? "Every connection goes through the VPN, ignoring those pages." : "Через VPN идёт всё подряд, эти страницы не учитываются.";
    out property <string> dash-tun-needs-admin:               root.en ? "TUN mode requires administrator rights — otherwise only the system proxy is available." : "Режим TUN требует прав администратора — иначе доступен только системный прокси.";
    out property <string> dash-restart:                       root.en ? "Restart" : "Перезапустить";
    out property <string> dash-add-server-hint:               root.en ? "Add a server on the Servers tab to get started." : "Добавьте сервер на вкладке «Серверы», чтобы начать.";
    out property <string> dash-traffic-down:                  root.en ? "Down" : "Приём";
    out property <string> dash-traffic-down-caps:             root.en ? "DOWN" : "ПРИЁМ";
    out property <string> dash-traffic-up:                    root.en ? "Up" : "Отдача";
    out property <string> dash-traffic-up-caps:               root.en ? "UP" : "ОТДАЧА";
    out property <string> dash-this-session-caps:             root.en ? "THIS SESSION" : "ЗА СЕССИЮ";
    out property <string> dash-connections-caps:              root.en ? "CONNECTIONS" : "СОЕДИНЕНИЙ";
    out property <string> dash-click-to-close:                root.en ? "click to close" : "нажмите, чтобы разорвать";
    out property <string> dash-not-connected:                 root.en ? "not connected" : "нет подключения";
    out property <string> dash-test-latency:                  root.en ? "Test latency" : "Проверить задержку";
    out property <string> dash-latency-caps:                  root.en ? "LATENCY" : "ЗАДЕРЖКА";
    out property <string> dash-click-to-test:                 root.en ? "click to test" : "нажмите, чтобы измерить";
    out property <string> dash-no-server:                     root.en ? "no server selected" : "сервер не выбран";
    out property <string> pick-no-server:                     root.en ? "No server selected" : "Сервер не выбран";
    out property <string> pick-test-all:                      root.en ? "Test all" : "Проверить все";
    out property <string> srv-subtitle-before:                root.en ? "Paste" : "Вставьте ссылки";
    out property <string> srv-subtitle-after:                 root.en ? "links from your panel — a subscription URL works too." : "из вашей панели — ссылка подписки тоже подойдёт.";
    out property <string> srv-add-btn:                        root.en ? "Add" : "Добавить";
    out property <string> srv-refresh-all:                    root.en ? "Refresh all" : "Обновить все";
    out property <string> srv-empty-title:                    root.en ? "No servers yet" : "Пока нет серверов";
    out property <string> srv-empty-text:                     root.en ? "Copy a server or subscription link from your panel (in 3x-ui, the “Share” button on the client) and paste it here. You can paste several lines at once." : "Скопируйте ссылку сервера или подписки из вашей панели (например, в 3x-ui — кнопка «Поделиться» у клиента) и вставьте её сюда. Можно вставить сразу несколько строк.";
    out property <string> srv-paste-links:                    root.en ? "Paste links" : "Вставить ссылки";
    out property <string> srv-add-manually:                   root.en ? "Add a server manually" : "Добавить сервер вручную";
    out property <string> srv-add-servers:                    root.en ? "Add servers" : "Добавить серверы";
    out property <string> srv-cancel:                         root.en ? "Cancel" : "Отмена";
    out property <string> srv-import-btn:                     root.en ? "Import" : "Импортировать";
    out property <string> srv-links-label:                    root.en ? "Links" : "Ссылки";
    out property <string> srv-links-hint:                     root.en ? "One per line. Supports vless://, vmess://, trojan://, ss://, hysteria2://, tuic://, or a whole base64 subscription block — and an http(s) subscription link will be added to “Subscriptions” and refresh on its own." : "По одной на строку. Поддерживаются vless://, vmess://, trojan://, ss://, hysteria2://, tuic://, base64-блок подписки целиком — а http(s)-ссылка на подписку добавится в «Подписки» и будет обновляться сама.";
    out property <string> srv-link-placeholder:               root.en ? "vless://uuid@server:443?type=tcp&security=reality&pbk=...#Name" : "vless://uuid@server:443?type=tcp&security=reality&pbk=...#Название";
    out property <string> srv-name-label:                     root.en ? "Name" : "Название";
    out property <string> srv-new-server:                     root.en ? "New server" : "Новый сервер";
    out property <string> srv-server-params:                  root.en ? "Server settings" : "Параметры сервера";
    out property <string> srv-save-btn:                       root.en ? "Save" : "Сохранить";
    out property <string> srv-protocol-label:                 root.en ? "Protocol" : "Протокол";
    out property <string> srv-address-label:                  root.en ? "Address" : "Адрес";
    out property <string> srv-port-label:                     root.en ? "Port" : "Порт";
    out property <string> srv-password-label:                 root.en ? "Password" : "Пароль";
    out property <string> srv-encryption-label:               root.en ? "Encryption" : "Шифрование";
    out property <string> srv-transport-label:                root.en ? "Transport" : "Транспорт";
    out property <string> srv-channel-encryption-label:       root.en ? "Channel encryption" : "Шифрование канала";
    out property <string> srv-tls-fingerprint-label:          root.en ? "TLS fingerprint (fp)" : "Отпечаток TLS (fp)";
    out property <string> srv-flow-hint:                      root.en ? "Usually xtls-rprx-vision or empty." : "Обычно xtls-rprx-vision либо пусто.";
    out property <string> srv-skip-cert-label:                root.en ? "Don't verify the certificate" : "Не проверять сертификат";
    out property <string> srv-skip-cert-desc:                 root.en ? "Only needed for a self-signed certificate on the server. The connection stays encrypted, but a substituted certificate cannot be detected." : "Нужно только для самоподписанного сертификата на сервере. Соединение остаётся зашифрованным, но подмену сертификата отследить нельзя.";
    out property <string> srv-mux-label:                      root.en ? "Multiplexing (mux)" : "Мультиплексирование (mux)";
    out property <string> srv-mux-desc:                       root.en ? "Several requests in one connection. Speeds up page loads, but is incompatible with XTLS Vision and interferes with torrents." : "Несколько запросов в одном соединении. Ускоряет открытие страниц, но несовместимо с XTLS Vision и мешает торрентам.";
    out property <string> srv-remaining-caps:                 root.en ? "REMAINING" : "ОСТАЛОСЬ";
    out property <string> srv-traffic-label-caps:             root.en ? "DATA" : "ТРАФИК";
    out property <string> srv-no-usage-info:                  root.en ? "The panel does not report data limits or expiry" : "Панель не сообщает лимиты и срок действия";
    out property <string> split-subtitle:                     root.en ? "Rules for specific apps. An app's route and DNS queries always take the same path, so the address never leaks outside the tunnel." : "Правила по конкретным приложениям. Маршрут и DNS-запросы программы всегда идут одним путём — так адрес не утекает мимо туннеля.";
    out property <string> split-mode-off-help:                root.en ? "All system traffic goes through the VPN." : "Весь трафик системы идёт через VPN.";
    out property <string> split-mode-include-help:            root.en ? "Only selected apps go via VPN. Everything else goes directly, bypassing the tunnel." : "Через VPN пойдут только выбранные приложения. Все остальные — напрямую, минуя туннель.";
    out property <string> split-mode-exclude-help:            root.en ? "Selected apps bypass VPN and go directly. All other traffic goes through the tunnel." : "Выбранные приложения пойдут напрямую, минуя VPN. Весь остальной трафик — через туннель.";
    out property <string> split-tun-only-title:               root.en ? "Works only in TUN mode" : "Работает только в режиме TUN";
    out property <string> split-tun-only-text:                root.en ? "System proxy mode is currently on. Telling which app owns a connection is only possible when traffic goes through the virtual adapter — switch the mode in settings." : "Сейчас включён режим системного прокси. Определить, какому приложению принадлежит соединение, можно только когда трафик проходит через виртуальный адаптер — переключите режим в настройках.";
    out property <string> split-mode-off:                     root.en ? "Off" : "Выключен";
    out property <string> split-mode-include:                 root.en ? "Only selected" : "Только выбранные";
    out property <string> split-mode-exclude:                 root.en ? "All except selected" : "Кроме выбранных";
    out property <string> split-add-from-running:             root.en ? "From running apps" : "Из запущенных";
    out property <string> split-pick-exe:                     root.en ? "Choose .exe" : "Выбрать .exe";
    out property <string> split-clear-list:                   root.en ? "Clear list" : "Очистить список";
    out property <string> split-empty-title:                  root.en ? "The list is empty" : "Список пуст";
    out property <string> split-empty-text:                   root.en ? "Add apps — for example, a banking client and Steam bypassing the VPN, or only the browser via VPN." : "Добавьте приложения — например, банковский клиент и Steam мимо VPN, либо только браузер через VPN.";
    out property <string> split-match-by-name:                root.en ? "matched by process name" : "совпадение по имени процесса";
    out property <string> split-running-apps:                 root.en ? "Running apps" : "Запущенные приложения";
    out property <string> split-search-placeholder:           root.en ? "Search by name or path" : "Поиск по имени или пути";
    out property <string> split-show-system-procs:            root.en ? "Show Windows system processes" : "Показывать системные процессы Windows";
    out property <string> split-nothing-found:                root.en ? "Nothing found" : "Ничего не найдено";
    out property <string> split-already-added:                root.en ? "already added" : "уже добавлено";
    out property <string> split-selected-chip:                root.en ? "selected" : "выбрано";
    out property <string> route-subtitle:                     root.en ? "Rules apply top to bottom, the first match wins: blocks → local network → your lists → geo rules → app rules." : "Правила применяются сверху вниз, побеждает первое совпадение: блокировки → локальная сеть → ваши списки → гео-правила → правила по приложениям.";
    out property <string> route-show-config:                  root.en ? "Show config" : "Показать конфиг";
    out property <string> route-presets-caps:                 root.en ? "PRESETS" : "ГОТОВЫЕ НАБОРЫ";
    out property <string> route-bypass-lan:                   root.en ? "Don't touch the local network" : "Не трогать локальную сеть";
    out property <string> route-bypass-lan-desc:              root.en ? "Router, printers, NAS and localhost go directly. Disable this only deliberately — otherwise devices on your home network will become unreachable." : "Роутер, принтеры, NAS и localhost идут напрямую. Отключать стоит только осознанно — иначе перестанут открываться устройства в домашней сети.";
    out property <string> route-bypass-ru:                    root.en ? "Russian sites bypass VPN" : "Российские сайты — мимо VPN";
    out property <string> route-bypass-ru-desc:               root.en ? "Domains and addresses from the geosite/geoip ru lists go directly. Speeds up access to local services and removes captchas." : "Домены и адреса из списка geosite/geoip ru идут напрямую. Ускоряет доступ к локальным сервисам и снимает капчи.";
    out property <string> route-bypass-cn:                    root.en ? "Chinese sites bypass VPN" : "Китайские сайты — мимо VPN";
    out property <string> route-bypass-cn-desc:               root.en ? "The same for the geosite/geoip cn list." : "То же самое для списка geosite/geoip cn.";
    out property <string> route-block-ads:                    root.en ? "Block ads and trackers" : "Блокировать рекламу и трекеры";
    out property <string> route-block-ads-desc:               root.en ? "Requests to domains from the category-ads-all list are rejected at the core and DNS level." : "Запросы к доменам из списка category-ads-all отклоняются на уровне ядра и DNS.";
    out property <string> route-custom-rules-caps:            root.en ? "CUSTOM RULES" : "СВОИ ПРАВИЛА";
    out property <string> route-direct-domains:               root.en ? "Always direct — domains" : "Всегда напрямую — домены";
    out property <string> route-direct-domains-hint:          root.en ? "One per line. Suffix match: example.com also covers sub.example.com." : "По одному на строку. Совпадение по суффиксу: example.com покроет и sub.example.com.";
    out property <string> route-proxy-domains:                root.en ? "Always via VPN — domains" : "Всегда через VPN — домены";
    out property <string> route-proxy-domains-hint:           root.en ? "Takes priority over geo rules, but yields to the “always direct” list." : "Имеет приоритет над гео-правилами, но уступает списку «всегда напрямую».";
    out property <string> route-direct-ips:                   root.en ? "Always direct — addresses" : "Всегда напрямую — адреса";
    out property <string> route-direct-ips-hint:              root.en ? "IP or CIDR, e.g. 10.0.0.0/8." : "IP или CIDR, например 10.0.0.0/8.";
    out property <string> route-proxy-ips:                    root.en ? "Always via VPN — addresses" : "Всегда через VPN — адреса";
    out property <string> route-proxy-ips-hint:               root.en ? "IP or CIDR." : "IP или CIDR.";
    out property <string> route-block-domains:                root.en ? "Block domains" : "Блокировать домены";
    out property <string> route-block-domains-hint:           root.en ? "Connections are rejected and no DNS answer is returned." : "Соединения отклоняются, DNS-ответ не выдаётся.";
    out property <string> route-config-title:                 root.en ? "Generated sing-box configuration" : "Сгенерированная конфигурация sing-box";
    out property <string> route-copied:                       root.en ? "Copied" : "Скопировано";
    out property <string> route-copy:                         root.en ? "Copy" : "Скопировать";
    out property <string> route-close:                        root.en ? "Close" : "Закрыть";
    out property <string> logs-title:                         root.en ? "Core log" : "Журнал ядра";
    out property <string> logs-subtitle:                      root.en ? "Real-time sing-box output. Look here if the connection keeps dropping." : "Вывод sing-box в реальном времени. Сюда стоит смотреть, если подключение обрывается.";
    out property <string> logs-filter-all:                    root.en ? "All" : "Все";
    out property <string> logs-filter-info:                   root.en ? "Info" : "Инфо";
    out property <string> logs-filter-warn:                   root.en ? "Warn" : "Предупр.";
    out property <string> logs-filter-errors:                 root.en ? "Errors" : "Ошибки";
    out property <string> logs-empty:                         root.en ? "The log is empty — entries will appear after connecting." : "Журнал пуст — записи появятся после подключения.";
    out property <string> logs-to-latest:                     root.en ? "To the latest entries" : "К последним записям";
    out property <string> elev-title:                         root.en ? "Administrator rights required" : "Требуются права администратора";
    out property <string> elev-tunnel-why:                    root.en ? "TUN mode intercepts all system traffic through the Wintun virtual adapter. Creating it requires administrator rights — Windows will show a UAC prompt." : "Режим TUN перехватывает трафик всей системы через виртуальный адаптер Wintun. Его создание требует прав администратора — Windows покажет запрос UAC.";
    out property <string> elev-tunnel-alt:                    root.en ? "If you don't want to elevate, switch to system proxy mode in settings: it works without UAC but only covers apps that respect the system proxy settings." : "Если повышать права не нужно, переключитесь на режим системного прокси в настройках: он работает без UAC, но охватывает только те приложения, которые уважают системные настройки прокси.";
    out property <string> elev-autostart-why:                 root.en ? "Autostart with administrator rights creates a task in the Windows Task Scheduler — a regular startup entry can't do that, the system won't elevate rights without confirmation." : "Автозапуск с правами администратора создаёт задачу в планировщике Windows — обычная запись в автозагрузке так не умеет, система не даёт повышать права без подтверждения.";
    out property <string> elev-autostart-once:                root.en ? "Rights are needed only once, to register the task. After that the app will start with administrator rights on its own, without a UAC prompt at every sign-in." : "Права нужны только один раз, чтобы зарегистрировать задачу. После этого приложение будет стартовать с правами администратора само, без запроса UAC при каждом входе в систему.";
    out property <string> orphan-title:                       root.en ? "A core from a previous session" : "Ядро от прошлого сеанса";
    out property <string> orphan-why:                         root.en ? "sing-box started by an earlier session is still running. It holds the cache file and the virtual adapter exclusively, so a new connection cannot come up: the core waits ten seconds for the lock and gives up with «initialize cache-file: timeout»." : "sing-box, запущенный прошлым сеансом, всё ещё работает. Файл кэша и виртуальный адаптер он держит монопольно, поэтому новое подключение не поднимется: ядро десять секунд ждёт блокировку и уходит с «initialize cache-file: timeout».";
    out property <string> orphan-traffic:                     root.en ? "Traffic may still be flowing through it" : "Через него всё ещё может идти трафик";
    out property <string> orphan-traffic-text:                root.en ? "Terminating it drops every connection open through that tunnel." : "Завершение оборвёт все соединения, открытые через тот туннель.";
    out property <string> orphan-ask:                         root.en ? "Terminate it and connect?" : "Завершить его и подключиться?";
    out property <string> orphan-uptime-label:                root.en ? "running for" : "работает";
    out property <string> orphan-no:                          root.en ? "No" : "Нет";
    out property <string> orphan-yes:                         root.en ? "Yes, terminate" : "Да, завершить";
    out property <string> dash-power-hint:                    root.en ? "Press the power button to bring the tunnel up." : "Нажмите кнопку питания, чтобы поднять туннель.";
    // Заголовок списка приложений: в вебе split.appsCount со своим {count}.
    out property <string> split-apps-caps:                    root.en ? "APPS" : "ПРИЛОЖЕНИЯ";
    // Демо-число карточки ресурсов: своё, потому что единица тоже переводится.
    out property <string> set-core-mem-demo:                  root.en ? "38.4 MB" : "38.4 МБ";
    out property <string> set-core-processes:                 root.en ? "1 process" : "процессов: 1";
    out property <string> set-core-stopped:                   root.en ? "not running" : "не запущено";
    out property <string> set-mem-private:                    root.en ? "Private memory (as in Task Manager)" : "Своя память (как в диспетчере задач)";
    out property <string> set-mem-working-set:                root.en ? "Full working set (shared DLLs included)" : "Полный working set (с общими DLL)";
    out property <string> set-process-count:                  root.en ? "Processes in Task Manager" : "Процессов в диспетчере задач";
    out property <string> set-resources-note:                 root.en ? "The whole interface is one native process, no WebView2. Both figures are live: «private» memory matches the Task Manager column; the full one counts system DLLs, loaded into RAM once for the whole machine." : "Весь интерфейс — один нативный процесс, без WebView2. Обе цифры живые: «своя» память — как колонка в диспетчере задач; полная — вместе с системными DLL, которые загружены в ОЗУ один раз на всю систему.";
    out property <string> toast-elevate-demo:                 root.en ? "Restarting as administrator — a demo only in the spike" : "Перезапуск с правами администратора — в спайке только демонстрация";
}
