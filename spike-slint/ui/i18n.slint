    out property <string> theme-emerald: root.tr(["Изумруд", "Emerald", "翡翠", "エメラルド", "에메랄드", "زمردي", "Esmeralda"]);
    out property <string> theme-swamp: root.tr(["Болотная", "Swamp", "沼泽", "スワンプ", "스웜프", "مستنقع", "Pântano"]);
    out property <string> theme-light: root.tr(["Светлая", "Light", "浅色", "ライト", "라이트", "فاتح", "Claro"]);
    out property <string> theme-system: root.tr(["Как в системе", "Follow system", "跟随系统", "システムに合わせる", "시스템 설정 따르기", "اتّباع النظام", "Seguir o sistema"]);
    out property <string> set-subtitle: root.tr(["Изменения применяются сразу; при активном подключении ядро перезапускается автоматически.", "Changes apply immediately; with an active connection the core restarts automatically.", "改动立即生效；如果连接正在运行，内核会自动重启。", "変更はすぐに反映されます。接続中の場合はコアが自動で再起動します。", "변경은 즉시 적용되며, 연결 중이면 코어가 자동으로 재시작합니다.", "تسري التغييرات فورًا، وإن كان هناك اتصال قائم فستُعاد تشغيل النواة تلقائيًا.", "As mudanças valem na hora; com uma conexão ativa, o núcleo reinicia sozinho."]);
    out property <string> set-data-folder: root.tr(["Папка данных", "Data folder", "数据文件夹", "データフォルダー", "데이터 폴더", "مجلد البيانات", "Pasta de dados"]);
    out property <string> set-tab-core: root.tr(["Ядро", "Core", "内核", "コア", "코어", "النواة", "Núcleo"]);
    out property <string> set-tab-client: root.tr(["Клиент", "Client", "客户端", "クライアント", "클라이언트", "التطبيق", "Cliente"]);
    out property <string> set-tunnel-section-caps: root.tr(["ТУННЕЛЬ", "TUNNEL", "隧道", "トンネル", "터널", "النفق", "TÚNEL"]);
    out property <string> set-tunnel-mode: root.tr(["Режим работы", "Mode", "模式", "モード", "모드", "الوضع", "Modo"]);
    out property <string> set-tunnel-mode-tun-desc: root.tr(["TUN — виртуальный адаптер Wintun перехватывает трафик всей системы. Нужны права администратора, зато работают правила по приложениям.", "TUN — a Wintun virtual adapter captures traffic system-wide. Needs administrator rights, but per-app rules work.", "TUN —— Wintun 虚拟网卡接管整个系统的流量。需要管理员权限，但可以按应用设置规则。", "TUN — Wintun 仮想アダプターがシステム全体の通信を受け取ります。管理者権限が必要ですが、アプリ単位のルールが使えます。", "TUN — Wintun 가상 어댑터가 시스템 전체의 트래픽을 받습니다. 관리자 권한이 필요하지만 앱별 규칙을 쓸 수 있습니다.", "‏TUN — محوّل Wintun الافتراضي يلتقط حركة النظام كلها. يحتاج صلاحيات المسؤول، لكن قواعد التطبيقات تعمل معه.", "TUN — um adaptador virtual Wintun captura o tráfego de todo o sistema. Exige direitos de administrador, mas as regras por aplicativo funcionam."]);
    out property <string> set-tunnel-mode-proxy-desc: root.tr(["Системный прокси — без прав администратора, но охватывает только приложения, которые читают системные настройки прокси.", "System proxy — no administrator rights, but only covers apps that honour the system proxy settings.", "系统代理 —— 无需管理员权限，但只覆盖遵循系统代理设置的应用。", "システムプロキシ — 管理者権限は不要ですが、システムプロキシ設定に従うアプリしか対象になりません。", "시스템 프록시 — 관리자 권한은 필요 없지만, 시스템 프록시 설정을 따르는 앱만 대상이 됩니다.", "وكيل النظام — لا يحتاج صلاحيات المسؤول، لكنه لا يغطي إلا التطبيقات التي تحترم إعدادات وكيل النظام.", "Proxy do sistema — sem direitos de administrador, mas cobre apenas os aplicativos que respeitam as configurações de proxy do sistema."]);
    out property <string> set-tun-needs-admin: root.tr(["Приложение запущено без прав администратора — подключение в режиме TUN предложит перезапуск.", "The app is running without administrator rights — connecting in TUN mode will offer a restart.", "应用正以普通权限运行 —— 在 TUN 模式下连接时会提示重启。", "アプリは管理者権限なしで動作しています。TUN モードで接続すると再起動を求められます。", "앱이 관리자 권한 없이 실행 중입니다 — TUN 모드로 연결하면 재시작을 제안합니다.", "التطبيق يعمل دون صلاحيات المسؤول — وسيعرض إعادة التشغيل عند الاتصال بوضع TUN.", "O aplicativo está rodando sem direitos de administrador — conectar em modo TUN vai oferecer um reinício."]);
    out property <string> set-tun-section-caps: root.tr(["ПАРАМЕТРЫ TUN", "TUN OPTIONS", "TUN 选项", "TUN の設定", "TUN 옵션", "خيارات TUN", "OPÇÕES DO TUN"]);
    out property <string> set-tun-stack: root.tr(["Сетевой стек", "Network stack", "网络栈", "ネットワークスタック", "네트워크 스택", "حزمة الشبكة", "Pilha de rede"]);
    out property <string> set-tun-stack-hint: root.tr(["mixed — gVisor для TCP и системный для UDP: лучший баланс скорости и совместимости.", "mixed — gVisor for TCP and the system stack for UDP: the best speed/compatibility trade-off.", "mixed —— TCP 走 gVisor，UDP 走系统栈：速度与兼容性的最佳平衡。", "mixed — TCP は gVisor、UDP はシステムスタック。速度と互換性のバランスが最も良い設定です。", "mixed — TCP는 gVisor, UDP는 시스템 스택. 속도와 호환성의 균형이 가장 좋습니다.", "‏mixed — ‏gVisor لـ TCP وحزمة النظام لـ UDP: أفضل موازنة بين السرعة والتوافق.", "mixed — gVisor para TCP e a pilha do sistema para UDP: o melhor equilíbrio entre velocidade e compatibilidade."]);
    out property <string> set-tun-stack-mixed: root.tr(["mixed (рекомендуется)", "mixed (recommended)", "mixed（推荐）", "mixed（推奨）", "mixed(권장)", "‏mixed (موصى به)", "mixed (recomendado)"]);
    out property <string> set-mtu-hint: root.tr(["По умолчанию 9000.", "Default is 9000.", "默认值为 9000。", "既定値は 9000 です。", "기본값은 9000입니다.", "القيمة الافتراضية 9000.", "O padrão é 9000."]);
    out property <string> set-strict-route: root.tr(["Строгая маршрутизация", "Strict routing", "严格路由", "厳格なルーティング", "엄격한 라우팅", "التوجيه الصارم", "Roteamento estrito"]);
    out property <string> set-strict-route-desc: root.tr(["Блокирует попытки трафика уйти в обход туннеля. Отключите, если перестают работать VirtualBox/WSL или сетевые игры.", "Blocks traffic from escaping the tunnel. Turn it off if VirtualBox/WSL or online games stop working.", "阻止流量绕开隧道。如果 VirtualBox/WSL 或网络游戏无法使用，请关闭它。", "通信がトンネルの外に漏れるのを防ぎます。VirtualBox/WSL やオンラインゲームが動かなくなったらオフにしてください。", "트래픽이 터널 밖으로 새는 것을 막습니다. VirtualBox/WSL이나 온라인 게임이 동작하지 않으면 끄세요.", "يمنع تسرّب الحركة خارج النفق. أوقفه إذا توقّف VirtualBox/WSL أو ألعاب الإنترنت عن العمل.", "Impede que o tráfego escape do túnel. Desligue se o VirtualBox/WSL ou jogos online pararem de funcionar."]);
    out property <string> set-ipv6: root.tr(["Поддержка IPv6", "IPv6 support", "IPv6 支持", "IPv6 対応", "IPv6 지원", "دعم IPv6", "Suporte a IPv6"]);
    out property <string> set-ipv6-desc: root.tr(["Выключено — DNS отдаёт только A-записи. Включайте, если провайдер и сервер действительно поддерживают IPv6.", "Off — DNS answers with A records only. Enable when your ISP and the server actually support IPv6.", "关闭时 DNS 只返回 A 记录。仅当运营商和服务器确实支持 IPv6 时再启用。", "オフのとき DNS は A レコードだけを返します。プロバイダーとサーバーが実際に IPv6 に対応している場合に有効にしてください。", "끄면 DNS가 A 레코드만 반환합니다. 통신사와 서버가 실제로 IPv6를 지원할 때만 켜세요.", "عند الإيقاف يردّ DNS بسجلات A فقط. فعّله حين يدعم مزوّدك والخادم IPv6 فعليًا.", "Desligado — o DNS responde apenas com registros A. Ligue quando o seu provedor e o servidor realmente suportarem IPv6."]);
    out property <string> set-fake-ip-desc: root.tr(["Ускоряет открытие сайтов: домен резолвится мгновенно, а настоящий адрес узнаёт уже сервер. Может мешать некоторым локальным сервисам.", "Speeds up page opens: domains resolve instantly and the real address is resolved by the server. May confuse some local services.", "加快网页打开速度：域名立即解析，真实地址交由服务器解析。可能会影响部分本地服务。", "ページの表示を速くします。ドメインは即座に解決され、実際のアドレスはサーバー側で解決されます。一部のローカルサービスが誤動作することがあります。", "페이지 열림을 빠르게 합니다. 도메인은 즉시 해석되고 실제 주소는 서버가 해석합니다. 일부 로컬 서비스가 혼란스러워할 수 있습니다.", "يسرّع فتح الصفحات: تُحلّ النطاقات فورًا ويتولّى الخادم تحليل العنوان الحقيقي. قد يربك بعض الخدمات المحلية.", "Acelera a abertura das páginas: os domínios são resolvidos na hora e o endereço real fica a cargo do servidor. Pode confundir alguns serviços locais."]);
    out property <string> set-dns-remote: root.tr(["DNS через VPN", "DNS via VPN", "经 VPN 的 DNS", "VPN 経由の DNS", "VPN 경유 DNS", "‏DNS عبر VPN", "DNS pela VPN"]);
    out property <string> set-dns-remote-hint: root.tr(["Используется для доменов, идущих в туннель. Можно указать tls:// или https://.", "Used for domains going through the tunnel. tls:// and https:// work too.", "用于走隧道的域名。也支持 tls:// 和 https://。", "トンネルを通るドメインに使われます。tls:// と https:// も指定できます。", "터널을 지나는 도메인에 쓰입니다. tls://와 https://도 됩니다.", "يُستخدم للنطاقات التي تمرّ عبر النفق. ويعمل معه ‎tls://‎ و‎https://‎ أيضًا.", "Usado para os domínios que passam pelo túnel. tls:// e https:// também funcionam."]);
    out property <string> set-dns-direct: root.tr(["DNS напрямую", "Direct DNS", "直连 DNS", "直接接続の DNS", "직접 연결 DNS", "‏DNS المباشر", "DNS direto"]);
    out property <string> set-dns-direct-hint: root.tr(["Для доменов в обход туннеля и для резолва адреса самого сервера.", "For domains bypassing the tunnel and for resolving the server's own address.", "用于绕过隧道的域名，以及解析服务器自身的地址。", "トンネルを迂回するドメインと、サーバー自身のアドレスの解決に使われます。", "터널을 우회하는 도메인과 서버 자신의 주소를 해석할 때 쓰입니다.", "للنطاقات التي تتجاوز النفق، ولتحليل عنوان الخادم نفسه.", "Para os domínios que contornam o túnel e para resolver o endereço do próprio servidor."]);
    out property <string> set-conn-section-caps: root.tr(["ПОДКЛЮЧЕНИЕ", "CONNECTION", "连接", "接続", "연결", "الاتصال", "CONEXÃO"]);
    out property <string> set-mixed-port: root.tr(["Порт SOCKS/HTTP", "SOCKS/HTTP port", "SOCKS/HTTP 端口", "SOCKS/HTTP ポート", "SOCKS/HTTP 포트", "منفذ SOCKS/HTTP", "Porta SOCKS/HTTP"]);
    out property <string> set-mixed-port-hint: root.tr(["Локальный смешанный прокси.", "Local mixed proxy.", "本地混合代理。", "ローカルの混合プロキシ。", "로컬 혼합 프록시.", "وكيل محلي مختلط.", "Proxy misto local."]);
    out property <string> set-clash-port: root.tr(["Порт панели управления ядром", "Core control port", "内核控制端口", "コア制御ポート", "코어 제어 포트", "منفذ التحكم بالنواة", "Porta de controle do núcleo"]);
    out property <string> set-clash-port-hint: root.tr(["Clash API на 127.0.0.1.", "Clash API on 127.0.0.1.", "监听 127.0.0.1 的 Clash API。", "127.0.0.1 上の Clash API。", "127.0.0.1의 Clash API.", "واجهة Clash على 127.0.0.1.", "API Clash em 127.0.0.1."]);
    out property <string> set-latency-url: root.tr(["URL для проверки задержки", "Latency test URL", "延迟测试地址", "レイテンシ計測 URL", "지연 시간 측정 URL", "رابط قياس زمن الاستجابة", "URL do teste de latência"]);
    out property <string> set-latency-url-hint: root.tr(["Запрос уходит через выбранный сервер.", "The request goes through the selected server.", "请求会经过所选服务器。", "リクエストは選択中のサーバーを経由します。", "요청은 선택한 서버를 거칩니다.", "يمرّ الطلب عبر الخادم المحدَّد.", "A requisição passa pelo servidor selecionado."]);
    out property <string> set-log-level: root.tr(["Уровень журнала", "Log level", "日志级别", "ログレベル", "로그 수준", "مستوى السجل", "Nível do log"]);
    out property <string> set-allow-lan: root.tr(["Доступ из локальной сети", "LAN access", "局域网访问", "LAN からの利用", "LAN 접근", "الوصول من الشبكة المحلية", "Acesso pela rede local"]);
    out property <string> set-allow-lan-desc: root.tr(["Прокси слушает 0.0.0.0 — другие устройства в сети смогут им пользоваться. Включайте только в доверенной сети.", "The proxy listens on 0.0.0.0 so other devices on the network can use it. Enable only on a trusted network.", "代理监听 0.0.0.0，网络中的其他设备也能使用。仅在可信网络中启用。", "プロキシが 0.0.0.0 で待ち受け、同じネットワークの他の端末からも使えるようになります。信頼できるネットワークでのみ有効にしてください。", "프록시가 0.0.0.0에서 대기하여 같은 네트워크의 다른 기기도 쓸 수 있습니다. 신뢰할 수 있는 네트워크에서만 켜세요.", "يستمع الوكيل على 0.0.0.0 ليستخدمه بقية أجهزة الشبكة. فعّله في الشبكات الموثوقة فقط.", "O proxy escuta em 0.0.0.0 para que outros dispositivos da rede possam usá-lo. Ative apenas em uma rede confiável."]);
    out property <string> set-balancer: root.tr(["Выбор сервера", "Server selection", "服务器选择", "サーバーの選択", "서버 선택", "اختيار الخادم", "Seleção de servidor"]);
    out property <string> set-balancer-manual: root.tr(["Вручную", "Manual", "手动", "手動", "수동", "يدوي", "Manual"]);
    out property <string> set-balancer-failover: root.tr(["С резервом", "Failover", "故障转移", "フェイルオーバー", "장애 조치", "احتياطي", "Reserva"]);
    out property <string> set-balancer-fastest: root.tr(["Самый быстрый", "Fastest", "最快", "最速", "가장 빠른", "الأسرع", "Mais rápido"]);
    out property <string> set-balancer-rotate: root.tr(["По кругу", "Rotation", "轮换", "ローテーション", "순환", "بالتناوب", "Rodízio"]);
    out property <string> set-balancer-manual-desc: root.tr(["Работает сервер, который вы выбрали. Само ничего не переключается.", "The server you picked is used. Nothing switches on its own.", "使用您选择的服务器，不会自动切换。", "選んだサーバーをそのまま使います。自動では切り替わりません。", "선택한 서버를 그대로 사용합니다. 자동으로 전환되지 않습니다.", "يُستخدم الخادم الذي اخترته، ولا يتبدّل شيء تلقائيًا.", "O servidor que você escolheu é usado. Nada muda sozinho."]);
    out property <string> set-balancer-failover-desc: root.tr(["Выбранный сервер — основной. Перестал отвечать — переход на лучший из живых; когда основной вернётся и продержится, трафик вернётся на него. Живые соединения при этом не рвутся.", "Your pick is the primary. When it stops answering, traffic moves to the best live server and returns once the primary is back and stays up. Live connections are not cut.", "所选服务器为主服务器。它无响应时切换到最好的可用服务器；主服务器恢复并保持稳定后再切回。现有连接不会中断。", "選んだサーバーがメインです。応答しなくなると最良の生きているサーバーへ移り、メインが復帰して安定したら戻ります。既存の接続は切れません。", "선택한 서버가 기본 서버입니다. 응답이 없으면 살아 있는 서버 중 가장 좋은 곳으로 옮기고, 기본 서버가 복구되어 안정되면 되돌아옵니다. 기존 연결은 끊기지 않습니다.", "الخادم الذي اخترته هو الأساسي. إذا توقّف عن الاستجابة ينتقل التدفّق إلى أفضل خادم حي، ويعود حين يرجع الأساسي ويستقر. الاتصالات القائمة لا تُقطع.", "O servidor escolhido é o principal. Se ele parar de responder, o tráfego vai para o melhor servidor vivo e volta quando o principal retornar e se manter estável. As conexões ativas não são cortadas."]);
    out property <string> set-balancer-fastest-desc: root.tr(["Все серверы проверяются по расписанию. Переход — только на тот, что быстрее нынешнего на заданный порог два обхода подряд: между серверами с одинаковой задержкой скакать не будет.", "Every server is checked on a schedule. Traffic moves only to one that beats the current server by the threshold in two consecutive rounds, so servers with similar latency don't swap back and forth.", "定期检测所有服务器。只有某台服务器连续两轮都比当前服务器快出设定阈值时才会切换，延迟相近的服务器之间不会来回跳。", "すべてのサーバーを定期的に計測します。設定したしきい値以上に速いサーバーが 2 回続けて現れたときだけ切り替えるので、同じくらいの遅延のサーバー間で行き来しません。", "모든 서버를 주기적으로 검사합니다. 두 번 연속 임계값 이상 더 빠른 서버가 있을 때만 옮기므로, 지연 시간이 비슷한 서버 사이를 오가지 않습니다.", "تُفحص كل الخوادم وفق جدول. لا ينتقل التدفّق إلا إلى خادم يتفوّق على الحالي بالحدّ المضبوط في جولتين متتاليتين، فلا يتأرجح بين خوادم متقاربة الزمن.", "Todos os servidores são verificados periodicamente. O tráfego só muda para um servidor que supere o atual pelo limiar em duas rodadas seguidas, então servidores com latência parecida não ficam alternando."]);
    out property <string> set-balancer-rotate-desc: root.tr(["Каждый обход — следующий живой сервер по списку; упавшие пропускаются.", "Each round moves to the next live server down the list; dead ones are skipped.", "每轮切换到列表中的下一个可用服务器，跳过失效的。", "毎回、リストの次の生きているサーバーへ移ります。落ちているサーバーは飛ばします。", "매 회차마다 목록의 다음 살아 있는 서버로 옮깁니다. 죽은 서버는 건너뜁니다.", "في كل جولة ينتقل إلى الخادم الحي التالي في القائمة، متجاوزًا المعطّل.", "A cada rodada passa para o próximo servidor vivo da lista; os que caíram são pulados."]);
    out property <string> set-balancer-interval: root.tr(["Обход серверов", "Check interval", "检测周期", "計測の間隔", "검사 주기", "فترة الفحص", "Intervalo de verificação"]);
    out property <string> set-balancer-interval-hint: root.tr(["Как часто проверять все серверы. Текущий проверяется чаще — каждые 20 секунд.", "How often all servers are checked. The current one is checked every 20 seconds.", "多久检测一次所有服务器。当前服务器每 20 秒检测一次。", "すべてのサーバーを計測する間隔。使用中のサーバーは 20 秒ごとに計測します。", "모든 서버를 검사하는 주기. 현재 서버는 20초마다 검사합니다.", "كم مرّة تُفحص كل الخوادم. الخادم الحالي يُفحص كل 20 ثانية.", "Com que frequência todos os servidores são verificados. O atual é verificado a cada 20 segundos."]);
    out property <string> set-balancer-tolerance: root.tr(["Порог переключения", "Switch threshold", "切换阈值", "切り替えのしきい値", "전환 임계값", "حدّ التبديل", "Limiar de troca"]);
    out property <string> set-balancer-tolerance-hint: root.tr(["Другой сервер должен быть быстрее хотя бы на столько.", "Another server has to be at least this much faster.", "另一台服务器至少要快这么多。", "別のサーバーが少なくともこれだけ速い必要があります。", "다른 서버가 최소 이만큼 더 빨라야 합니다.", "يجب أن يكون الخادم الآخر أسرع بهذا القدر على الأقل.", "Outro servidor precisa ser pelo menos isto mais rápido."]);
    out property <string> unit-min: root.tr(["мин", "min", "分钟", "分", "분", "د", "min"]);
    out property <string> unit-ms: root.tr(["мс", "ms", "毫秒", "ms", "ms", "م.ث", "ms"]);
    out property <string> set-subs-section-caps: root.tr(["ПОДПИСКИ", "SUBSCRIPTIONS", "订阅", "サブスクリプション", "구독", "الاشتراكات", "ASSINATURAS"]);
    out property <string> set-sub-auto: root.tr(["Обновлять автоматически", "Refresh automatically", "自动刷新", "自動で更新する", "자동으로 새로 고침", "التحديث تلقائيًا", "Atualizar automaticamente"]);
    out property <string> set-sub-auto-desc: root.tr(["Список серверов, остаток трафика и срок действия подтягиваются с панели в фоне. Устаревший список — самая частая причина, по которой клиент внезапно перестаёт подключаться.", "The server list, data allowance and expiry are pulled from the panel in the background. A silently stale list is the most common reason a client suddenly stops connecting.", "服务器列表、流量额度和到期时间会在后台从面板拉取。列表悄悄过期，是客户端突然连不上的最常见原因。", "サーバー一覧、データ量、有効期限をバックグラウンドでパネルから取得します。一覧が黙って古くなることは、クライアントが突然つながらなくなる最もよくある原因です。", "서버 목록, 데이터 한도, 만료일을 백그라운드에서 패널로부터 가져옵니다. 목록이 조용히 낡는 것은 클라이언트가 갑자기 연결되지 않는 가장 흔한 원인입니다.", "تُجلب قائمة الخوادم وحصة البيانات وتاريخ الانتهاء من اللوحة في الخلفية. وقِدَم القائمة بصمت هو أكثر أسباب توقّف العميل عن الاتصال فجأة.", "A lista de servidores, a franquia de dados e o vencimento são buscados no painel em segundo plano. Uma lista que envelhece em silêncio é o motivo mais comum de um cliente parar de conectar do nada."]);
    out property <string> set-sub-every-off: root.tr(["Не обновлять", "Never", "从不", "しない", "안 함", "أبدًا", "Nunca"]);
    out property <string> set-sub-every3h: root.tr(["каждые 3 часа", "every 3 hours", "每 3 小时", "3 時間ごと", "3시간마다", "كل 3 ساعات", "a cada 3 horas"]);
    out property <string> set-sub-every6h: root.tr(["каждые 6 часов", "every 6 hours", "每 6 小时", "6 時間ごと", "6시간마다", "كل 6 ساعات", "a cada 6 horas"]);
    out property <string> set-sub-every12h: root.tr(["каждые 12 часов", "every 12 hours", "每 12 小时", "12 時間ごと", "12시간마다", "كل 12 ساعة", "a cada 12 horas"]);
    out property <string> set-sub-every-day: root.tr(["раз в сутки", "once a day", "每天一次", "1 日 1 回", "하루 한 번", "مرة يوميًا", "uma vez por dia"]);
    out property <string> set-language-section-caps: root.tr(["ЯЗЫК / LANGUAGE", "ЯЗЫК / LANGUAGE", "语言 / LANGUAGE", "言語 / LANGUAGE", "언어 / LANGUAGE", "اللغة / LANGUAGE", "IDIOMA / LANGUAGE"]);
    out property <string> set-language: root.tr(["Язык интерфейса", "Interface language", "界面语言", "表示言語", "인터페이스 언어", "لغة الواجهة", "Idioma da interface"]);
    out property <string> set-language-desc: root.tr(["«Как в системе» следует за языком операционной системы. Тексты ядра в журнале остаются на языке движка.", "“Follow system” tracks the operating system language. Core lines in the log stay in the engine's own language.", "「跟随系统」会随操作系统语言变化。日志中的内核输出仍保持内核本身的语言。", "「システムに合わせる」は OS の言語に追従します。ログ中のコアの行はエンジン自身の言語のままです。", "「시스템 설정 따르기」는 운영체제 언어를 따릅니다. 로그의 코어 출력은 엔진 자체의 언어로 남습니다.", "«اتّباع النظام» يتتبّع لغة نظام التشغيل. أما أسطر النواة في السجل فتبقى بلغة المحرّك نفسه.", "“Seguir o sistema” acompanha o idioma do sistema operacional. As linhas do núcleo no log continuam no idioma do próprio motor."]);
    out property <string> set-theme-section-caps: root.tr(["ВНЕШНИЙ ВИД", "APPEARANCE", "外观", "外観", "모양", "المظهر", "APARÊNCIA"]);
    out property <string> set-theme: root.tr(["Тема оформления", "Theme", "主题", "テーマ", "테마", "السمة", "Tema"]);
    out property <string> set-theme-desc: root.tr(["«Как в системе» следует за настройкой системы и переключается сама, в том числе по её расписанию светлой и тёмной темы.", "“Follow system” tracks the OS setting and switches by itself, including on its light/dark schedule.", "「跟随系统」会跟随操作系统设置自动切换，包括系统的浅色/深色时间表。", "「システムに合わせる」は OS の設定に追従し、ライト／ダークのスケジュールも含めて自動で切り替わります。", "「시스템 설정 따르기」는 OS 설정을 따라가며, 밝게/어둡게 일정에 맞춰 스스로 전환합니다.", "«اتّباع النظام» يتتبّع إعداد نظام التشغيل ويبدّل من تلقاء نفسه، بما في ذلك جدول الفاتح والداكن.", "“Seguir o sistema” acompanha a configuração do SO e troca sozinho, inclusive no horário de claro/escuro."]);
    out property <string> set-startup-section-caps: root.tr(["ЗАПУСК", "STARTUP", "启动", "起動", "시작", "بدء التشغيل", "INICIALIZAÇÃO"]);
    out property <string> set-autostart: root.tr(["Запускать вместе с Windows", "Start with Windows", "开机自启", "Windows と一緒に起動", "Windows와 함께 시작", "التشغيل مع Windows", "Iniciar com o Windows"]);
    out property <string> set-autostart-desc: root.tr(["Приложение стартует при входе в систему.", "The app starts when you sign in.", "登录系统时自动启动应用。", "サインイン時にアプリが起動します。", "로그인할 때 앱이 실행됩니다.", "يبدأ التطبيق عند تسجيل الدخول.", "O aplicativo abre quando você faz logon."]);
    out property <string> set-autostart-elevated: root.tr(["Запускать сразу с правами администратора", "Start with administrator rights", "以管理员权限启动", "管理者権限で起動する", "관리자 권한으로 시작", "التشغيل بصلاحيات المسؤول", "Iniciar com direitos de administrador"]);
    out property <string> set-autostart-elevated-desc: root.tr(["Создаст задачу в планировщике Windows: приложение будет стартовать с правами администратора и сразу поднимать TUN — без запроса UAC. Ручной запуск ярлыком тоже пойдёт через неё, поэтому перезапуск «от администратора» больше не понадобится.", "Creates a Windows Task Scheduler task: the app starts elevated and brings TUN up right away — no UAC prompt. Manual launches go through the task too, so an “as administrator” restart is never needed.", "创建一个 Windows 任务计划：应用以提权方式启动并立即建立 TUN —— 不再弹出 UAC。手动启动同样会走这个计划任务，因此永远不需要「以管理员身份」重新启动。", "Windows のタスク スケジューラにタスクを作成します。アプリが昇格した状態で起動して TUN をすぐ張るため、UAC のプロンプトは出ません。手動での起動もこのタスクを通るので、「管理者として」起動し直す必要はありません。", "Windows 작업 스케줄러에 작업을 만듭니다. 앱이 권한이 올라간 상태로 시작해 TUN을 바로 올리므로 UAC 창이 뜨지 않습니다. 직접 실행할 때도 이 작업을 거치므로 「관리자 권한으로」 다시 시작할 일이 없습니다.", "يُنشئ مهمة في «برنامج جدولة المهام» في Windows: يبدأ التطبيق بصلاحيات مرتفعة ويرفع نفق TUN فورًا — دون نافذة UAC. والتشغيل اليدوي يمرّ عبر المهمة نفسها، فلا حاجة أبدًا لإعادة التشغيل «كمسؤول».", "Cria uma tarefa no Agendador de Tarefas do Windows: o aplicativo inicia elevado e sobe o TUN de imediato — sem prompt do UAC. As aberturas manuais também passam pela tarefa, então nunca é preciso reiniciar “como administrador”."]);
    out property <string> set-autostart-elevated-needs-admin: root.tr(["Требуется однократный перезапуск с правами администратора, чтобы зарегистрировать задачу в планировщике.", "Needs a one-time restart with administrator rights to register the scheduled task.", "需要以管理员权限重启一次，以便注册计划任务。", "タスクを登録するため、一度だけ管理者権限での再起動が必要です。", "작업을 등록하려면 관리자 권한으로 한 번만 다시 시작해야 합니다.", "يتطلّب إعادة تشغيل واحدة بصلاحيات المسؤول لتسجيل المهمة المجدولة.", "Exige um único reinício com direitos de administrador para registrar a tarefa agendada."]);
    out property <string> set-autostart-normal-warn: root.tr(["Обычная автозагрузка не может поднять режим TUN: после входа в систему приложение запросит права. Включите переключатель выше, чтобы этого не происходило.", "Plain autostart cannot bring TUN up: after sign-in the app will ask for rights. Enable the toggle above to avoid that.", "普通自启无法建立 TUN：登录后应用会请求权限。启用上面的开关即可避免。", "通常の自動起動では TUN を張れません。サインイン後にアプリが権限を求めます。上のスイッチを入れれば回避できます。", "일반 자동 시작으로는 TUN을 올릴 수 없어, 로그인 후 앱이 권한을 요청합니다. 위 스위치를 켜면 이를 피할 수 있습니다.", "البدء التلقائي العادي لا يستطيع رفع نفق TUN: سيطلب التطبيق الصلاحيات بعد تسجيل الدخول. فعّل المفتاح أعلاه لتفادي ذلك.", "O início automático comum não consegue subir o TUN: depois do logon o aplicativo vai pedir direitos. Ligue a chave acima para evitar isso."]);
    out property <string> set-auto-connect: root.tr(["Подключаться при запуске", "Connect on launch", "启动时自动连接", "起動時に接続する", "실행할 때 연결", "الاتصال عند التشغيل", "Conectar ao abrir"]);
    out property <string> set-start-minimized: root.tr(["Запускать свёрнутым в трей", "Start minimized to tray", "启动时最小化到托盘", "最小化してトレイで起動する", "트레이에 최소화된 상태로 시작", "البدء مصغَّرًا في شريط النظام", "Iniciar minimizado na bandeja"]);
    out property <string> set-close-to-tray: root.tr(["Закрытие окна сворачивает в трей", "Closing the window minimizes to tray", "关闭窗口时最小化到托盘", "ウィンドウを閉じたらトレイへ最小化する", "창을 닫으면 트레이로 최소화", "إغلاق النافذة يصغّرها إلى شريط النظام", "Fechar a janela minimiza para a bandeja"]);
    out property <string> set-close-to-tray-desc: root.tr(["Выключено — крестик полностью завершает работу и разрывает соединение.", "Off — the close button quits completely and drops the connection.", "关闭时，关闭按钮会完全退出应用并断开连接。", "オフのとき、閉じるボタンは完全に終了し接続も切れます。", "끄면 닫기 버튼이 앱을 완전히 종료하고 연결도 끊습니다.", "عند الإيقاف، يُنهي زر الإغلاق التطبيق تمامًا ويقطع الاتصال.", "Desligado — o botão de fechar encerra tudo e derruba a conexão."]);
    out property <string> set-resources-section-caps: root.tr(["ПОТРЕБЛЕНИЕ РЕСУРСОВ", "RESOURCE USAGE", "资源占用", "リソース使用量", "자원 사용량", "استهلاك الموارد", "USO DE RECURSOS"]);
    out property <string> set-res-core: root.tr(["Ядро sing-box", "sing-box core", "sing-box 内核", "sing-box コア", "sing-box 코어", "نواة sing-box", "núcleo sing-box"]);
    out property <string> set-about-section-caps: root.tr(["О ПРИЛОЖЕНИИ", "ABOUT", "关于", "情報", "정보", "حول", "SOBRE"]);
    out property <string> set-app-version: root.tr(["Версия приложения", "App version", "应用版本", "アプリのバージョン", "앱 버전", "إصدار التطبيق", "Versão do aplicativo"]);
    out property <string> fmt-no-tls: root.tr(["без TLS", "no TLS", "无 TLS", "TLS なし", "TLS 없음", "بلا TLS", "sem TLS"]);
    out property <string> dash-subtitle: root.tr(["Состояние туннеля, скорость и режим маршрутизации.", "Tunnel state, speed, and routing mode.", "隧道状态、速度与路由模式。", "トンネルの状態、速度、ルーティングモード。", "터널 상태, 속도, 라우팅 모드.", "حالة النفق والسرعة ووضع التوجيه.", "Estado do túnel, velocidade e modo de roteamento."]);
    // Третьего режима, «Напрямую», на переключателе нет: он и означал «трафик
    // мимо VPN», а для этого проще выключить туннель кнопкой питания. Ядро его
    // понимает по-прежнему (route-правило clash_mode), так что внешний
    // клиент Clash API им пользоваться может.
    out property <string> dash-mode-rule: root.tr(["По правилам", "Rules", "按规则", "ルール", "규칙", "بالقواعد", "Regras"]);
    out property <string> dash-mode-global: root.tr(["Всё через VPN", "Everything via VPN", "全部走 VPN", "すべて VPN 経由", "모두 VPN 경유", "كل شيء عبر VPN", "Tudo pela VPN"]);
    // Подпись под переключателем режима: без неё два слова ничего не говорят
    // тому, кто открыл клиент впервые.
    out property <string> dash-mode-rule-help: root.tr(["Обычный режим: что идёт через VPN, решают страницы «Раздельный туннель» и «Маршрутизация».", "Everyday mode: what goes through the VPN is decided by the “Split tunneling” and “Routing” pages.", "日常模式：哪些流量走 VPN，由「分应用代理」和「路由」页面决定。", "普段使いのモード。何を VPN に通すかは「スプリットトンネリング」と「ルーティング」のページで決まります。", "평소 쓰는 모드입니다. 무엇이 VPN을 지날지는 「분할 터널링」과 「라우팅」 페이지가 결정합니다.", "وضع الاستخدام اليومي: ما الذي يمرّ عبر VPN تقرّره صفحتا «تقسيم النفق» و«التوجيه».", "Modo do dia a dia: o que passa pela VPN é decidido pelas páginas “Túnel dividido” e “Roteamento”."]);
    out property <string> dash-mode-global-help: root.tr(["Через VPN идёт всё подряд, эти страницы не учитываются.", "Every connection goes through the VPN, ignoring those pages.", "所有连接都走 VPN，忽略上述页面的设置。", "それらのページを無視して、すべての通信が VPN を通ります。", "해당 페이지를 무시하고 모든 연결이 VPN을 지납니다.", "كل اتصال يمرّ عبر VPN، متجاهلًا تلك الصفحتين.", "Todas as conexões passam pela VPN, ignorando essas páginas."]);
    out property <string> dash-tun-needs-admin: root.tr(["Режим TUN требует прав администратора — иначе доступен только системный прокси.", "TUN mode requires administrator rights — otherwise only the system proxy is available.", "TUN 模式需要管理员权限 —— 否则只能使用系统代理。", "TUN モードには管理者権限が必要です。ない場合はシステムプロキシのみ利用できます。", "TUN 모드에는 관리자 권한이 필요합니다 — 없으면 시스템 프록시만 쓸 수 있습니다.", "وضع TUN يحتاج صلاحيات المسؤول — وإلا فلن يتاح سوى وكيل النظام.", "O modo TUN exige direitos de administrador — sem eles, só o proxy do sistema fica disponível."]);
    out property <string> dash-restart: root.tr(["Перезапустить", "Restart", "重启", "再起動", "다시 시작", "إعادة التشغيل", "Reiniciar"]);
    out property <string> dash-no-servers-title: root.tr(["Подключаться пока не к чему", "Nothing to connect to yet", "还没有可连接的服务器", "まだ接続先がありません", "아직 연결할 곳이 없습니다", "لا يوجد ما تتصل به بعد", "Ainda não há a que se conectar"]);
    out property <string> dash-no-servers-text: root.tr(["Добавьте ссылку сервера или подписку из вашей панели — и на этом месте появится кнопка подключения.", "Add a server link or a subscription from your panel — the connect button will appear here.", "添加一条服务器链接或面板给出的订阅 —— 连接按钮就会出现在这里。", "サーバーのリンクか、パネルのサブスクリプションを追加すると、ここに接続ボタンが現れます。", "서버 링크나 패널의 구독을 추가하면 여기에 연결 버튼이 나타납니다.", "أضف رابط خادم أو اشتراكًا من لوحتك — وسيظهر زر الاتصال هنا.", "Adicione um link de servidor ou uma assinatura do seu painel — o botão de conectar vai aparecer aqui."]);
    out property <string> dash-traffic-down: root.tr(["Приём", "Down", "下载", "下り", "다운로드", "التنزيل", "Descida"]);
    out property <string> dash-traffic-down-caps: root.tr(["ПРИЁМ", "DOWN", "下载", "下り", "다운로드", "التنزيل", "DESCIDA"]);
    out property <string> dash-traffic-up: root.tr(["Отдача", "Up", "上传", "上り", "업로드", "الرفع", "Subida"]);
    out property <string> dash-traffic-up-caps: root.tr(["ОТДАЧА", "UP", "上传", "上り", "업로드", "الرفع", "SUBIDA"]);
    out property <string> dash-this-session-caps: root.tr(["ЗА СЕССИЮ", "THIS SESSION", "本次会话", "今回のセッション", "이번 세션", "هذه الجلسة", "NESTA SESSÃO"]);
    out property <string> dash-connections-caps: root.tr(["СОЕДИНЕНИЙ", "CONNECTIONS", "连接数", "接続数", "연결", "الاتصالات", "CONEXÕES"]);
    out property <string> dash-click-to-close: root.tr(["нажмите, чтобы разорвать", "click to close", "点击关闭", "クリックで切断", "누르면 닫힘", "انقر للإغلاق", "clique para fechar"]);
    out property <string> dash-not-connected: root.tr(["нет подключения", "not connected", "未连接", "未接続", "연결되지 않음", "غير متصل", "não conectado"]);
    out property <string> dash-test-latency: root.tr(["Проверить задержку", "Test latency", "测试延迟", "レイテンシを測る", "지연 시간 측정", "قياس زمن الاستجابة", "Testar latência"]);
    out property <string> dash-latency-caps: root.tr(["ЗАДЕРЖКА", "LATENCY", "延迟", "レイテンシ", "지연 시간", "زمن الاستجابة", "LATÊNCIA"]);
    out property <string> dash-click-to-test: root.tr(["нажмите, чтобы измерить", "click to test", "点击测试", "クリックで計測", "누르면 측정", "انقر للقياس", "clique para testar"]);
    out property <string> dash-no-server: root.tr(["сервер не выбран", "no server selected", "未选择服务器", "サーバー未選択", "서버가 선택되지 않음", "لم يُحدَّد خادم", "nenhum servidor selecionado"]);
    out property <string> pick-no-server: root.tr(["Сервер не выбран", "No server selected", "未选择服务器", "サーバーが選ばれていません", "선택된 서버 없음", "لم يُحدَّد خادم", "Nenhum servidor selecionado"]);
    out property <string> pick-test-all: root.tr(["Проверить все", "Test all", "全部测试", "すべて計測", "전체 측정", "قياس الكل", "Testar todos"]);
    // Подпись балансировщика у имени сервера на «Обзоре».
    out property <string> pick-badge-failover: root.tr(["с резервом", "failover", "故障转移", "フェイルオーバー", "장애 조치", "احتياطي", "reserva"]);
    out property <string> pick-badge-backup: root.tr(["резервный сервер", "backup server", "备用服务器", "予備サーバー", "예비 서버", "خادم احتياطي", "servidor reserva"]);
    out property <string> pick-badge-fastest: root.tr(["самый быстрый", "fastest", "最快", "最速", "가장 빠른", "الأسرع", "mais rápido"]);
    out property <string> pick-badge-rotate: root.tr(["по кругу", "rotation", "轮换", "ローテーション", "순환", "بالتناوب", "rodízio"]);
    out property <string> toast-balancer-off: root.tr(["Автовыбор выключен: сервер выбран вручную", "Automatic selection is off: server picked by hand", "已关闭自动选择：服务器为手动选择", "自動選択をオフにしました。サーバーを手動で選びました", "자동 선택을 껐습니다. 서버를 직접 선택했습니다", "أُوقف الاختيار التلقائي: اخترتَ الخادم يدويًا", "Seleção automática desligada: servidor escolhido à mão"]);
    out property <string> srv-subtitle-before: root.tr(["Вставьте ссылки", "Paste", "粘贴面板给出的", "パネルの", "패널에서 받은", "الصق روابط", "Cole os links"]);
    out property <string> srv-subtitle-after: root.tr(["из вашей панели — ссылка подписки тоже подойдёт.", "links from your panel — a subscription URL works too.", "链接 —— 订阅地址同样可以。", "リンクを貼り付けてください。サブスクリプション URL でも構いません。", "링크를 붙여 넣으세요 — 구독 URL도 됩니다.", "من لوحتك — ورابط الاشتراك يصلح كذلك.", "do seu painel — uma URL de assinatura também serve."]);
    out property <string> srv-add-btn: root.tr(["Добавить", "Add", "添加", "追加", "추가", "إضافة", "Adicionar"]);
    out property <string> srv-refresh-all: root.tr(["Обновить все", "Refresh all", "全部刷新", "すべて更新", "모두 새로 고침", "تحديث الكل", "Atualizar todas"]);
    out property <string> srv-empty-title: root.tr(["Пока нет серверов", "No servers yet", "还没有服务器", "サーバーがまだありません", "아직 서버가 없습니다", "لا توجد خوادم بعد", "Ainda não há servidores"]);
    out property <string> srv-empty-text: root.tr(["Скопируйте ссылку сервера или подписки из вашей панели (например, в 3x-ui — кнопка «Поделиться» у клиента) и вставьте её сюда. Можно вставить сразу несколько строк.", "Copy a server or subscription link from your panel (in 3x-ui, the “Share” button on the client) and paste it here. You can paste several lines at once.", "从面板复制服务器或订阅链接（在 3x-ui 中是客户端上的「Share」按钮）并粘贴到这里。可以一次粘贴多行。", "パネルからサーバーまたはサブスクリプションのリンクをコピーして（3x-ui ならクライアントの「Share」ボタン）、ここに貼り付けてください。複数行をまとめて貼っても構いません。", "패널에서 서버나 구독 링크를 복사해(3x-ui라면 클라이언트의 「Share」 버튼) 여기에 붙여 넣으세요. 여러 줄을 한 번에 붙여 넣어도 됩니다.", "انسخ رابط خادم أو اشتراك من لوحتك (في 3x-ui زر «Share» عند العميل) والصقه هنا. ويمكنك لصق عدة أسطر دفعة واحدة.", "Copie um link de servidor ou de assinatura do seu painel (no 3x-ui, o botão “Share” no cliente) e cole aqui. Você pode colar várias linhas de uma vez."]);
    out property <string> srv-paste-links: root.tr(["Вставить ссылки", "Paste links", "粘贴链接", "リンクを貼り付ける", "링크 붙여 넣기", "لصق الروابط", "Colar links"]);
    out property <string> srv-add-manually: root.tr(["Добавить сервер вручную", "Add a server manually", "手动添加服务器", "サーバーを手動で追加", "서버를 직접 추가", "إضافة خادم يدويًا", "Adicionar um servidor manualmente"]);
    out property <string> srv-add-servers: root.tr(["Добавить серверы", "Add servers", "添加服务器", "サーバーを追加", "서버 추가", "إضافة خوادم", "Adicionar servidores"]);
    out property <string> srv-cancel: root.tr(["Отмена", "Cancel", "取消", "キャンセル", "취소", "إلغاء", "Cancelar"]);
    out property <string> srv-import-btn: root.tr(["Импортировать", "Import", "导入", "取り込む", "가져오기", "استيراد", "Importar"]);
    out property <string> srv-links-label: root.tr(["Ссылки", "Links", "链接", "リンク", "링크", "الروابط", "Links"]);
    out property <string> srv-links-hint: root.tr(["По одной на строку. Поддерживаются vless://, vmess://, trojan://, ss://, hysteria2://, tuic://, base64-блок подписки целиком — а http(s)-ссылка на подписку добавится в «Подписки» и будет обновляться сама.", "One per line. Supports vless://, vmess://, trojan://, ss://, hysteria2://, tuic://, or a whole base64 subscription block — and an http(s) subscription link will be added to “Subscriptions” and refresh on its own.", "每行一条。支持 vless://、vmess://、trojan://、ss://、hysteria2://、tuic://，也支持整段 base64 订阅内容 —— 而 http(s) 订阅链接会被加入「订阅」并自动刷新。", "1 行に 1 つ。vless://、vmess://、trojan://、ss://、hysteria2://、tuic://、base64 のサブスクリプション全体にも対応します。http(s) のサブスクリプションリンクは「サブスクリプション」に追加され、自動で更新されます。", "한 줄에 하나씩. vless://, vmess://, trojan://, ss://, hysteria2://, tuic:// 및 base64 구독 블록 전체를 지원합니다. http(s) 구독 링크는 「구독」에 추가되어 스스로 갱신됩니다.", "رابط في كل سطر. يدعم ‎vless://‎ و‎vmess://‎ و‎trojan://‎ و‎ss://‎ و‎hysteria2://‎ و‎tuic://‎، أو كتلة اشتراك كاملة بترميز base64 — أما رابط اشتراك ‎http(s)‎ فيُضاف إلى «الاشتراكات» ويتحدّث وحده.", "Um por linha. Aceita vless://, vmess://, trojan://, ss://, hysteria2://, tuic:// ou um bloco base64 inteiro de assinatura — e um link http(s) de assinatura vai para “Assinaturas” e se atualiza sozinho."]);
    out property <string> srv-link-placeholder: root.tr(["vless://uuid@server:443?type=tcp&security=reality&pbk=...#Название", "vless://uuid@server:443?type=tcp&security=reality&pbk=...#Name", "vless://uuid@server:443?type=tcp&security=reality&pbk=...#名称", "vless://uuid@server:443?type=tcp&security=reality&pbk=...#名前", "vless://uuid@server:443?type=tcp&security=reality&pbk=...#이름", "vless://uuid@server:443?type=tcp&security=reality&pbk=...#الاسم", "vless://uuid@servidor:443?type=tcp&security=reality&pbk=...#Nome"]);
    out property <string> srv-name-label: root.tr(["Название", "Name", "名称", "名前", "이름", "الاسم", "Nome"]);
    out property <string> srv-new-server: root.tr(["Новый сервер", "New server", "新服务器", "新しいサーバー", "새 서버", "خادم جديد", "Novo servidor"]);
    out property <string> srv-server-params: root.tr(["Параметры сервера", "Server settings", "服务器设置", "サーバーの設定", "서버 설정", "إعدادات الخادم", "Configurações do servidor"]);
    out property <string> srv-save-btn: root.tr(["Сохранить", "Save", "保存", "保存", "저장", "حفظ", "Salvar"]);
    out property <string> srv-protocol-label: root.tr(["Протокол", "Protocol", "协议", "プロトコル", "프로토콜", "البروتوكول", "Protocolo"]);
    out property <string> srv-address-label: root.tr(["Адрес", "Address", "地址", "アドレス", "주소", "العنوان", "Endereço"]);
    out property <string> srv-port-label: root.tr(["Порт", "Port", "端口", "ポート", "포트", "المنفذ", "Porta"]);
    out property <string> srv-password-label: root.tr(["Пароль", "Password", "密码", "パスワード", "비밀번호", "كلمة المرور", "Senha"]);
    out property <string> srv-encryption-label: root.tr(["Шифрование", "Encryption", "加密", "暗号化", "암호화", "التشفير", "Criptografia"]);
    out property <string> srv-transport-label: root.tr(["Транспорт", "Transport", "传输", "トランスポート", "전송", "النقل", "Transporte"]);
    out property <string> srv-channel-encryption-label: root.tr(["Шифрование канала", "Channel encryption", "通道加密", "通信路の暗号化", "채널 암호화", "تشفير القناة", "Criptografia do canal"]);
    out property <string> srv-tls-fingerprint-label: root.tr(["Отпечаток TLS (fp)", "TLS fingerprint (fp)", "TLS 指纹（fp）", "TLS フィンガープリント（fp）", "TLS 지문(fp)", "بصمة TLS (fp)", "Impressão digital TLS (fp)"]);
    out property <string> srv-flow-hint: root.tr(["Обычно xtls-rprx-vision либо пусто.", "Usually xtls-rprx-vision or empty.", "通常是 xtls-rprx-vision 或留空。", "通常は xtls-rprx-vision か空欄です。", "보통 xtls-rprx-vision이거나 비워 둡니다.", "عادةً xtls-rprx-vision أو فارغ.", "Normalmente xtls-rprx-vision ou vazio."]);
    out property <string> srv-skip-cert-label: root.tr(["Не проверять сертификат", "Don't verify the certificate", "不验证证书", "証明書を検証しない", "인증서를 검증하지 않음", "عدم التحقق من الشهادة", "Não verificar o certificado"]);
    out property <string> srv-skip-cert-desc: root.tr(["Нужно только для самоподписанного сертификата на сервере. Соединение остаётся зашифрованным, но подмену сертификата отследить нельзя.", "Only needed for a self-signed certificate on the server. The connection stays encrypted, but a substituted certificate cannot be detected.", "仅在服务器使用自签名证书时才需要。连接依然加密，但无法察觉证书被替换。", "サーバーが自己署名証明書を使っている場合にのみ必要です。通信は暗号化されたままですが、証明書のすり替えを検出できなくなります。", "서버가 자체 서명 인증서를 쓸 때만 필요합니다. 연결은 계속 암호화되지만, 인증서가 바뀌어도 알아챌 수 없습니다.", "لا يلزم إلا مع شهادة موقّعة ذاتيًا على الخادم. يبقى الاتصال مشفّرًا، لكن لا يمكن كشف شهادة مستبدلة.", "Só é preciso com um certificado autoassinado no servidor. A conexão continua criptografada, mas um certificado trocado passa despercebido."]);
    out property <string> srv-mux-label: root.tr(["Мультиплексирование (mux)", "Multiplexing (mux)", "多路复用（mux）", "多重化（mux）", "다중화(mux)", "التعددية (mux)", "Multiplexação (mux)"]);
    out property <string> srv-mux-desc: root.tr(["Несколько запросов в одном соединении. Ускоряет открытие страниц, но несовместимо с XTLS Vision и мешает торрентам.", "Several requests in one connection. Speeds up page loads, but is incompatible with XTLS Vision and interferes with torrents.", "在一条连接中承载多个请求。能加快网页加载，但与 XTLS Vision 不兼容，也会影响 BT 下载。", "1 本の接続で複数のリクエストを流します。ページの読み込みは速くなりますが、XTLS Vision とは併用できず、トレントの邪魔にもなります。", "하나의 연결에 여러 요청을 담습니다. 페이지 로딩은 빨라지지만 XTLS Vision과 함께 쓸 수 없고 토렌트에도 방해가 됩니다.", "عدة طلبات في اتصال واحد. يسرّع تحميل الصفحات، لكنه لا يتوافق مع XTLS Vision ويعيق التورنت.", "Várias requisições em uma conexão. Acelera o carregamento de páginas, mas é incompatível com o XTLS Vision e atrapalha torrents."]);
    out property <string> srv-remaining-caps: root.tr(["ОСТАЛОСЬ", "REMAINING", "剩余", "残り", "남음", "المتبقي", "RESTANTE"]);
    out property <string> srv-traffic-label-caps: root.tr(["ТРАФИК", "DATA", "流量", "データ量", "데이터", "البيانات", "DADOS"]);
    out property <string> srv-no-usage-info: root.tr(["Панель не сообщает лимиты и срок действия", "The panel does not report data limits or expiry", "面板未提供流量额度或到期信息", "パネルはデータ量や有効期限を返していません", "패널이 데이터 한도나 만료일을 알려 주지 않습니다", "لا تُبلغ اللوحة عن حصة البيانات ولا عن تاريخ الانتهاء", "O painel não informa franquia de dados nem vencimento"]);
    out property <string> split-subtitle: root.tr(["Правила по конкретным приложениям. Маршрут и DNS-запросы программы всегда идут одним путём — так адрес не утекает мимо туннеля.", "Rules for specific apps. An app's route and DNS queries always take the same path, so the address never leaks outside the tunnel.", "针对特定应用的规则。应用的路由与其 DNS 查询始终走同一条路径，因此地址不会泄露到隧道之外。", "特定のアプリ向けのルールです。アプリの経路と DNS クエリは常に同じ道を通るので、アドレスがトンネルの外に漏れることはありません。", "특정 앱을 위한 규칙입니다. 앱의 경로와 DNS 질의는 항상 같은 길을 지나므로 주소가 터널 밖으로 새지 않습니다.", "قواعد لتطبيقات بعينها. مسار التطبيق واستعلامات DNS الخاصة به يسلكان الطريق نفسه دائمًا، فلا يتسرّب العنوان خارج النفق.", "Regras para aplicativos específicos. A rota de um aplicativo e as suas consultas de DNS seguem sempre o mesmo caminho, então o endereço nunca vaza para fora do túnel."]);
    out property <string> split-mode-off-help: root.tr(["Весь трафик системы идёт через VPN.", "All system traffic goes through the VPN.", "系统的全部流量都走 VPN。", "システムのすべての通信が VPN を通ります。", "시스템의 모든 트래픽이 VPN을 지납니다.", "كل حركة النظام تمرّ عبر VPN.", "Todo o tráfego do sistema passa pela VPN."]);
    out property <string> split-mode-include-help: root.tr(["Через VPN пойдут только выбранные приложения. Все остальные — напрямую, минуя туннель.", "Only selected apps go via VPN. Everything else goes directly, bypassing the tunnel.", "只有选中的应用走 VPN。其余流量绕开隧道直连。", "選んだアプリだけが VPN を通ります。それ以外はトンネルを迂回して直接つながります。", "선택한 앱만 VPN을 지납니다. 나머지는 터널을 우회해 직접 연결됩니다.", "التطبيقات المحددة وحدها تمرّ عبر VPN. وكل ما عداها يتصل مباشرة متجاوزًا النفق.", "Só os aplicativos escolhidos passam pela VPN. O resto vai direto, contornando o túnel."]);
    out property <string> split-mode-exclude-help: root.tr(["Выбранные приложения пойдут напрямую, минуя VPN. Весь остальной трафик — через туннель.", "Selected apps bypass VPN and go directly. All other traffic goes through the tunnel.", "选中的应用绕开 VPN 直连。其余流量都走隧道。", "選んだアプリは VPN を迂回して直接つながります。ほかの通信はすべてトンネルを通ります。", "선택한 앱은 VPN을 우회해 직접 연결되고, 나머지 트래픽은 모두 터널을 지납니다.", "التطبيقات المحددة تتجاوز VPN وتتصل مباشرة. وبقية الحركة تمرّ عبر النفق.", "Os aplicativos escolhidos contornam a VPN e vão direto. Todo o resto do tráfego passa pelo túnel."]);
    out property <string> split-tun-only-title: root.tr(["Работает только в режиме TUN", "Works only in TUN mode", "仅在 TUN 模式下可用", "TUN モードでのみ動作します", "TUN 모드에서만 동작합니다", "يعمل في وضع TUN فقط", "Funciona apenas no modo TUN"]);
    out property <string> split-tun-only-text: root.tr(["Сейчас включён режим системного прокси. Определить, какому приложению принадлежит соединение, можно только когда трафик проходит через виртуальный адаптер — переключите режим в настройках.", "System proxy mode is currently on. Telling which app owns a connection is only possible when traffic goes through the virtual adapter — switch the mode in settings.", "当前处于系统代理模式。只有流量经过虚拟网卡时，才能判断某条连接属于哪个应用 —— 请到设置中切换模式。", "現在はシステムプロキシモードです。どのアプリの接続かを判別できるのは、通信が仮想アダプターを通るときだけです。設定でモードを切り替えてください。", "지금은 시스템 프록시 모드입니다. 어느 앱의 연결인지 알 수 있는 것은 트래픽이 가상 어댑터를 지날 때뿐입니다 — 설정에서 모드를 바꾸세요.", "وضع وكيل النظام مفعّل حاليًا. ولا يمكن معرفة صاحب الاتصال من التطبيقات إلا حين تمرّ الحركة عبر المحوّل الافتراضي — بدّل الوضع من الإعدادات.", "O modo de proxy do sistema está ativo. Só dá para saber a qual aplicativo pertence uma conexão quando o tráfego passa pelo adaptador virtual — troque o modo nas configurações."]);
    out property <string> split-mode-off: root.tr(["Выключен", "Off", "关闭", "オフ", "끔", "إيقاف", "Desligado"]);
    out property <string> split-mode-include: root.tr(["Только выбранные", "Only selected", "仅选中的应用", "選んだアプリのみ", "선택한 앱만", "المحددة فقط", "Só os escolhidos"]);
    out property <string> split-mode-exclude: root.tr(["Кроме выбранных", "All except selected", "除选中之外的应用", "選んだアプリ以外すべて", "선택한 앱 제외 전부", "الكل ما عدا المحددة", "Todos, menos os escolhidos"]);
    out property <string> split-add-from-running: root.tr(["Из запущенных", "From running apps", "从运行中的应用添加", "実行中のアプリから", "실행 중인 앱에서", "من التطبيقات العاملة", "Dos aplicativos abertos"]);
    out property <string> split-pick-exe: root.tr(["Выбрать .exe", "Choose .exe", "选择 .exe", ".exe を選ぶ", ".exe 선택", "اختيار ملف ‎.exe‎", "Escolher .exe"]);
    out property <string> split-clear-list: root.tr(["Очистить список", "Clear list", "清空列表", "一覧を空にする", "목록 비우기", "إفراغ القائمة", "Limpar a lista"]);
    out property <string> split-empty-title: root.tr(["Список пуст", "The list is empty", "列表为空", "一覧が空です", "목록이 비어 있습니다", "القائمة فارغة", "A lista está vazia"]);
    out property <string> split-empty-text: root.tr(["Добавьте приложения — например, банковский клиент и Steam мимо VPN, либо только браузер через VPN.", "Add apps — for example, a banking client and Steam bypassing the VPN, or only the browser via VPN.", "添加一些应用 —— 例如让网银客户端和 Steam 绕开 VPN，或者只让浏览器走 VPN。", "アプリを追加してください。たとえば銀行のクライアントと Steam を VPN の外に出したり、ブラウザーだけを VPN に通したり。", "앱을 추가하세요 — 예를 들어 은행 클라이언트와 Steam은 VPN 밖으로, 브라우저만 VPN 안으로.", "أضف تطبيقات — مثلًا تطبيق البنك وSteam خارج VPN، أو المتصفح وحده عبر VPN.", "Adicione aplicativos — por exemplo, o cliente do banco e a Steam fora da VPN, ou só o navegador pela VPN."]);
    out property <string> split-match-by-name: root.tr(["совпадение по имени процесса", "matched by process name", "按进程名匹配", "プロセス名で照合", "프로세스 이름으로 대조", "المطابقة باسم العملية", "identificado pelo nome do processo"]);
    out property <string> split-running-apps: root.tr(["Запущенные приложения", "Running apps", "运行中的应用", "実行中のアプリ", "실행 중인 앱", "التطبيقات العاملة", "Aplicativos abertos"]);
    out property <string> split-search-placeholder: root.tr(["Поиск по имени или пути", "Search by name or path", "按名称或路径搜索", "名前かパスで検索", "이름이나 경로로 검색", "بحث بالاسم أو المسار", "Buscar por nome ou caminho"]);
    out property <string> split-show-system-procs: root.tr(["Показывать системные процессы Windows", "Show Windows system processes", "显示 Windows 系统进程", "Windows のシステムプロセスを表示", "Windows 시스템 프로세스 표시", "إظهار عمليات نظام Windows", "Mostrar processos de sistema do Windows"]);
    out property <string> split-nothing-found: root.tr(["Ничего не найдено", "Nothing found", "未找到任何内容", "見つかりませんでした", "찾은 것이 없습니다", "لم يُعثر على شيء", "Nada encontrado"]);
    out property <string> split-already-added: root.tr(["уже добавлено", "already added", "已添加", "追加済み", "이미 추가됨", "مضاف سلفًا", "já adicionado"]);
    out property <string> split-selected-chip: root.tr(["выбрано", "selected", "已选中", "選択中", "선택됨", "محدَّد", "selecionado"]);
    out property <string> route-subtitle: root.tr(["Правила применяются сверху вниз, побеждает первое совпадение: блокировки → локальная сеть → ваши списки → гео-правила → правила по приложениям.", "Rules apply top to bottom, the first match wins: blocks → local network → your lists → geo rules → app rules.", "规则自上而下匹配，命中即停：拦截 → 局域网 → 自定义列表 → 地理规则 → 应用规则。", "ルールは上から順に評価され、最初に一致したものが勝ちます: ブロック → ローカルネットワーク → 自分のリスト → 地域ルール → アプリのルール。", "규칙은 위에서 아래로 적용되고 먼저 맞는 것이 이깁니다: 차단 → 로컬 네트워크 → 내 목록 → 지역 규칙 → 앱 규칙.", "تُطبَّق القواعد من الأعلى إلى الأسفل، وأول تطابق يفوز: الحجب ← الشبكة المحلية ← قوائمك ← القواعد الجغرافية ← قواعد التطبيقات.", "As regras valem de cima para baixo e a primeira que casar vence: bloqueios → rede local → suas listas → regras geográficas → regras de aplicativo."]);
    out property <string> route-show-config: root.tr(["Показать конфиг", "Show config", "查看配置", "設定を見る", "설정 보기", "عرض الإعداد", "Ver configuração"]);
    out property <string> route-presets-caps: root.tr(["ГОТОВЫЕ НАБОРЫ", "PRESETS", "预设", "プリセット", "프리셋", "الإعدادات الجاهزة", "PREDEFINIÇÕES"]);
    out property <string> route-bypass-lan: root.tr(["Не трогать локальную сеть", "Don't touch the local network", "不干预局域网", "ローカルネットワークには触れない", "로컬 네트워크는 건드리지 않기", "عدم المساس بالشبكة المحلية", "Não mexer na rede local"]);
    out property <string> route-bypass-lan-desc: root.tr(["Роутер, принтеры, NAS и localhost идут напрямую. Отключать стоит только осознанно — иначе перестанут открываться устройства в домашней сети.", "Router, printers, NAS and localhost go directly. Disable this only deliberately — otherwise devices on your home network will become unreachable.", "路由器、打印机、NAS 和 localhost 一律直连。除非确有必要，否则不要关闭 —— 否则家庭网络里的设备将无法访问。", "ルーター、プリンター、NAS、localhost は直接つながります。意図がないかぎり無効にしないでください。家庭内の機器に届かなくなります。", "공유기, 프린터, NAS, localhost는 직접 연결됩니다. 의도가 없다면 끄지 마세요 — 집 안의 기기에 닿지 않게 됩니다.", "الموجّه والطابعات وأجهزة NAS و‎localhost‎ تتصل مباشرة. لا توقفه إلا عن قصد — وإلا فستتعذّر أجهزة شبكتك المنزلية.", "Roteador, impressoras, NAS e localhost vão direto. Desligue apenas de propósito — do contrário os dispositivos da sua rede ficam inalcançáveis."]);
    out property <string> route-bypass-ru: root.tr(["Российские сайты — мимо VPN", "Russian sites bypass VPN", "俄罗斯站点绕开 VPN", "ロシアのサイトは VPN を迂回", "러시아 사이트는 VPN 우회", "المواقع الروسية تتجاوز VPN", "Sites russos fora da VPN"]);
    out property <string> route-bypass-ru-desc: root.tr(["Домены и адреса из списка geosite/geoip ru идут напрямую. Ускоряет доступ к локальным сервисам и снимает капчи.", "Domains and addresses from the geosite/geoip ru lists go directly. Speeds up access to local services and removes captchas.", "geosite/geoip 的 ru 列表中的域名和地址直连。可加快访问本地服务，并减少人机验证。", "geosite/geoip の ru リストにあるドメインとアドレスが直接つながります。国内サービスが速くなり、キャプチャも減ります。", "geosite/geoip의 ru 목록에 있는 도메인과 주소가 직접 연결됩니다. 국내 서비스가 빨라지고 캡차도 줄어듭니다.", "النطاقات والعناوين من قائمتي geosite/geoip‏ ru تتصل مباشرة. يسرّع الوصول إلى الخدمات المحلية ويقلّل اختبارات التحقق.", "Domínios e endereços das listas geosite/geoip ru vão direto. Agiliza o acesso a serviços locais e elimina captchas."]);
    out property <string> route-bypass-cn: root.tr(["Китайские сайты — мимо VPN", "Chinese sites bypass VPN", "中国站点绕开 VPN", "中国のサイトは VPN を迂回", "중국 사이트는 VPN 우회", "المواقع الصينية تتجاوز VPN", "Sites chineses fora da VPN"]);
    out property <string> route-bypass-cn-desc: root.tr(["То же самое для списка geosite/geoip cn.", "The same for the geosite/geoip cn list.", "对 geosite/geoip 的 cn 列表做同样处理。", "geosite/geoip の cn リストについて同じことを行います。", "geosite/geoip의 cn 목록에 같은 처리를 합니다.", "المِثل لقائمتي geosite/geoip‏ cn.", "O mesmo para a lista geosite/geoip cn."]);
    out property <string> route-block-ads: root.tr(["Блокировать рекламу и трекеры", "Block ads and trackers", "拦截广告与追踪器", "広告とトラッカーをブロック", "광고와 추적기 차단", "حجب الإعلانات والمتعقّبات", "Bloquear anúncios e rastreadores"]);
    out property <string> route-block-ads-desc: root.tr(["Запросы к доменам из списка category-ads-all отклоняются на уровне ядра и DNS.", "Requests to domains from the category-ads-all list are rejected at the core and DNS level.", "对 category-ads-all 列表中域名的请求，会在内核与 DNS 两层被拒绝。", "category-ads-all リストのドメインへのリクエストを、コアと DNS の両方で拒否します。", "category-ads-all 목록의 도메인 요청을 코어와 DNS 두 곳에서 거부합니다.", "تُرفض الطلبات إلى نطاقات قائمة category-ads-all على مستوى النواة وDNS معًا.", "Requisições a domínios da lista category-ads-all são recusadas no núcleo e no DNS."]);
    out property <string> route-custom-rules-caps: root.tr(["СВОИ ПРАВИЛА", "CUSTOM RULES", "自定义规则", "自分のルール", "내 규칙", "قواعدك الخاصة", "REGRAS PRÓPRIAS"]);
    out property <string> route-direct-domains: root.tr(["Всегда напрямую — домены", "Always direct — domains", "始终直连 —— 域名", "常に直接 — ドメイン", "항상 직접 연결 — 도메인", "مباشر دائمًا — النطاقات", "Sempre direto — domínios"]);
    out property <string> route-direct-domains-hint: root.tr(["По одному на строку. Совпадение по суффиксу: example.com покроет и sub.example.com.", "One per line. Suffix match: example.com also covers sub.example.com.", "每行一条。按后缀匹配：example.com 同时覆盖 sub.example.com。", "1 行に 1 つ。後方一致です: example.com は sub.example.com も含みます。", "한 줄에 하나씩. 접미사로 대조합니다: example.com은 sub.example.com도 포함합니다.", "نطاق في كل سطر. المطابقة باللاحقة: ‎example.com‎ يشمل كذلك ‎sub.example.com‎.", "Um por linha. Casamento por sufixo: example.com cobre também sub.example.com."]);
    out property <string> route-proxy-domains: root.tr(["Всегда через VPN — домены", "Always via VPN — domains", "始终走 VPN —— 域名", "常に VPN 経由 — ドメイン", "항상 VPN 경유 — 도메인", "عبر VPN دائمًا — النطاقات", "Sempre pela VPN — domínios"]);
    out property <string> route-proxy-domains-hint: root.tr(["Имеет приоритет над гео-правилами, но уступает списку «всегда напрямую».", "Takes priority over geo rules, but yields to the “always direct” list.", "优先于地理规则，但让位于「始终直连」列表。", "地域ルールより優先されますが、「常に直接」のリストには譲ります。", "지역 규칙보다 우선하지만 「항상 직접 연결」 목록에는 양보합니다.", "لها أولوية على القواعد الجغرافية، لكنها تتنازل لقائمة «مباشر دائمًا».", "Tem prioridade sobre as regras geográficas, mas cede para a lista “sempre direto”."]);
    out property <string> route-direct-ips: root.tr(["Всегда напрямую — адреса", "Always direct — addresses", "始终直连 —— 地址", "常に直接 — アドレス", "항상 직접 연결 — 주소", "مباشر دائمًا — العناوين", "Sempre direto — endereços"]);
    out property <string> route-direct-ips-hint: root.tr(["IP или CIDR, например 10.0.0.0/8.", "IP or CIDR, e.g. 10.0.0.0/8.", "IP 或 CIDR，例如 10.0.0.0/8。", "IP または CIDR（例: 10.0.0.0/8）。", "IP 또는 CIDR, 예: 10.0.0.0/8.", "‏IP أو CIDR، مثل 10.0.0.0/8.", "IP ou CIDR, por exemplo 10.0.0.0/8."]);
    out property <string> route-proxy-ips: root.tr(["Всегда через VPN — адреса", "Always via VPN — addresses", "始终走 VPN —— 地址", "常に VPN 経由 — アドレス", "항상 VPN 경유 — 주소", "عبر VPN دائمًا — العناوين", "Sempre pela VPN — endereços"]);
    out property <string> route-proxy-ips-hint: root.tr(["IP или CIDR.", "IP or CIDR.", "IP 或 CIDR。", "IP または CIDR。", "IP 또는 CIDR.", "‏IP أو CIDR.", "IP ou CIDR."]);
    out property <string> route-block-domains: root.tr(["Блокировать домены", "Block domains", "拦截域名", "ドメインをブロック", "도메인 차단", "حجب النطاقات", "Bloquear domínios"]);
    out property <string> route-block-domains-hint: root.tr(["Соединения отклоняются, DNS-ответ не выдаётся.", "Connections are rejected and no DNS answer is returned.", "连接会被拒绝，DNS 也不返回任何应答。", "接続は拒否され、DNS も応答を返しません。", "연결이 거부되고 DNS도 답을 주지 않습니다.", "تُرفض الاتصالات ولا يُعاد أي ردّ من DNS.", "As conexões são recusadas e o DNS não devolve resposta."]);
    out property <string> route-config-title: root.tr(["Сгенерированная конфигурация sing-box", "Generated sing-box configuration", "生成的 sing-box 配置", "生成された sing-box の設定", "생성된 sing-box 설정", "إعداد sing-box المُولَّد", "Configuração sing-box gerada"]);
    out property <string> route-copied: root.tr(["Скопировано", "Copied", "已复制", "コピーしました", "복사했습니다", "نُسخ", "Copiado"]);
    out property <string> route-copy: root.tr(["Скопировать", "Copy", "复制", "コピー", "복사", "نسخ", "Copiar"]);
    out property <string> route-close: root.tr(["Закрыть", "Close", "关闭", "閉じる", "닫기", "إغلاق", "Fechar"]);
    out property <string> logs-title: root.tr(["Журнал ядра", "Core log", "内核日志", "コアのログ", "코어 로그", "سجل النواة", "Log do núcleo"]);
    out property <string> logs-subtitle: root.tr(["Вывод sing-box в реальном времени. Сюда стоит смотреть, если подключение обрывается.", "Real-time sing-box output. Look here if the connection keeps dropping.", "sing-box 的实时输出。连接反复断开时，来这里查看。", "sing-box のリアルタイム出力です。接続が切れ続けるときはここを見てください。", "sing-box의 실시간 출력입니다. 연결이 계속 끊기면 여기를 보세요.", "مخرجات sing-box لحظة بلحظة. انظر هنا إذا ظلّ الاتصال ينقطع.", "Saída do sing-box em tempo real. Olhe aqui se a conexão fica caindo."]);
    out property <string> logs-filter-all: root.tr(["Все", "All", "全部", "すべて", "전체", "الكل", "Tudo"]);
    out property <string> logs-filter-info: root.tr(["Инфо", "Info", "信息", "情報", "정보", "معلومات", "Info"]);
    out property <string> logs-filter-warn: root.tr(["Предупр.", "Warn", "警告", "警告", "경고", "تحذير", "Aviso"]);
    out property <string> logs-filter-errors: root.tr(["Ошибки", "Errors", "错误", "エラー", "오류", "أخطاء", "Erros"]);
    out property <string> logs-empty: root.tr(["Журнал пуст — записи появятся после подключения.", "The log is empty — entries will appear after connecting.", "日志为空 —— 连接之后才会出现记录。", "ログは空です。接続すると行が現れます。", "로그가 비어 있습니다 — 연결하면 줄이 나타납니다.", "السجل فارغ — ستظهر الأسطر بعد الاتصال.", "O log está vazio — as linhas aparecem depois de conectar."]);
    out property <string> logs-to-latest: root.tr(["К последним записям", "To the latest entries", "跳到最新记录", "最新の行へ", "최신 줄로", "إلى أحدث الأسطر", "Para as linhas mais recentes"]);
    out property <string> elev-title: root.tr(["Требуются права администратора", "Administrator rights required", "需要管理员权限", "管理者権限が必要です", "관리자 권한이 필요합니다", "مطلوب صلاحيات المسؤول", "São necessários direitos de administrador"]);
    out property <string> elev-tunnel-why: root.tr(["Режим TUN перехватывает трафик всей системы через виртуальный адаптер Wintun. Его создание требует прав администратора — Windows покажет запрос UAC.", "TUN mode intercepts all system traffic through the Wintun virtual adapter. Creating it requires administrator rights — Windows will show a UAC prompt.", "TUN 模式通过 Wintun 虚拟网卡接管系统的全部流量。创建它需要管理员权限 —— Windows 会弹出 UAC 提示。", "TUN モードは Wintun 仮想アダプターを通じてシステムのすべての通信を横取りします。その作成には管理者権限が必要で、Windows が UAC のプロンプトを表示します。", "TUN 모드는 Wintun 가상 어댑터로 시스템의 모든 트래픽을 가로챕니다. 이를 만들려면 관리자 권한이 필요하며, Windows가 UAC 창을 띄웁니다.", "وضع TUN يعترض حركة النظام كلها عبر محوّل Wintun الافتراضي. وإنشاؤه يتطلّب صلاحيات المسؤول — وسيعرض Windows نافذة UAC.", "O modo TUN intercepta todo o tráfego do sistema pelo adaptador virtual Wintun. Criá-lo exige direitos de administrador — o Windows vai mostrar um prompt do UAC."]);
    out property <string> elev-tunnel-alt: root.tr(["Если повышать права не нужно, переключитесь на режим системного прокси в настройках: он работает без UAC, но охватывает только те приложения, которые уважают системные настройки прокси.", "If you don't want to elevate, switch to system proxy mode in settings: it works without UAC but only covers apps that respect the system proxy settings.", "如果不想提权，可以到设置中切换到系统代理模式：它无需 UAC，但只覆盖遵循系统代理设置的应用。", "昇格したくない場合は、設定でシステムプロキシモードに切り替えてください。UAC は不要ですが、システムプロキシ設定に従うアプリしか対象になりません。", "권한을 올리고 싶지 않다면 설정에서 시스템 프록시 모드로 바꾸세요. UAC 없이 동작하지만, 시스템 프록시 설정을 따르는 앱만 대상이 됩니다.", "إن لم ترغب في رفع الصلاحيات، بدّل إلى وضع وكيل النظام من الإعدادات: يعمل دون UAC لكنه لا يغطي إلا التطبيقات التي تحترم إعدادات وكيل النظام.", "Se não quiser elevar, troque para o modo de proxy do sistema nas configurações: ele funciona sem UAC, mas cobre apenas os aplicativos que respeitam as configurações de proxy do sistema."]);
    out property <string> elev-autostart-why: root.tr(["Автозапуск с правами администратора создаёт задачу в планировщике Windows — обычная запись в автозагрузке так не умеет, система не даёт повышать права без подтверждения.", "Autostart with administrator rights creates a task in the Windows Task Scheduler — a regular startup entry can't do that, the system won't elevate rights without confirmation.", "以管理员权限自启需要在 Windows 任务计划程序中创建任务 —— 普通的启动项做不到这一点，系统不会在没有确认的情况下提升权限。", "管理者権限での自動起動は Windows のタスク スケジューラにタスクを作ります。通常のスタートアップ項目ではこれができません。システムは確認なしに権限を昇格しないためです。", "관리자 권한 자동 시작은 Windows 작업 스케줄러에 작업을 만듭니다. 일반 시작 항목으로는 할 수 없습니다 — 시스템은 확인 없이 권한을 올려 주지 않기 때문입니다.", "البدء التلقائي بصلاحيات المسؤول يُنشئ مهمة في «برنامج جدولة المهام» في Windows — ولا يقدر عنصر بدء تشغيل عادي على ذلك، فالنظام لا يرفع الصلاحيات دون تأكيد.", "O início automático com direitos de administrador cria uma tarefa no Agendador de Tarefas do Windows — uma entrada comum de inicialização não dá conta disso, o sistema não eleva direitos sem confirmação."]);
    out property <string> elev-autostart-once: root.tr(["Права нужны только один раз, чтобы зарегистрировать задачу. После этого приложение будет стартовать с правами администратора само, без запроса UAC при каждом входе в систему.", "Rights are needed only once, to register the task. After that the app will start with administrator rights on its own, without a UAC prompt at every sign-in.", "只需授权一次以注册该任务。此后应用便会自行以管理员权限启动，每次登录都不再弹出 UAC。", "権限が必要なのはタスクを登録する一度だけです。以後はアプリが自分で管理者権限で起動し、サインインのたびに UAC が出ることはありません。", "권한은 작업을 등록하는 한 번만 필요합니다. 그 뒤로는 앱이 스스로 관리자 권한으로 시작하며, 로그인할 때마다 UAC가 뜨지 않습니다.", "الصلاحيات مطلوبة مرة واحدة فقط لتسجيل المهمة. وبعدها يبدأ التطبيق بصلاحيات المسؤول من تلقاء نفسه، دون نافذة UAC عند كل تسجيل دخول.", "Os direitos são necessários uma única vez, para registrar a tarefa. Depois disso o aplicativo passa a iniciar com direitos de administrador sozinho, sem prompt do UAC a cada logon."]);
    out property <string> orphan-title: root.tr(["Ядро от прошлого сеанса", "A core from a previous session", "上次会话遗留的内核", "前回のセッションのコア", "이전 세션의 코어", "نواة من جلسة سابقة", "Um núcleo de uma sessão anterior"]);
    out property <string> orphan-why: root.tr(["sing-box, запущенный прошлым сеансом, всё ещё работает. Файл кэша и виртуальный адаптер он держит монопольно, поэтому новое подключение не поднимется: ядро десять секунд ждёт блокировку и уходит с «initialize cache-file: timeout».", "sing-box started by an earlier session is still running. It holds the cache file and the virtual adapter exclusively, so a new connection cannot come up: the core waits ten seconds for the lock and gives up with «initialize cache-file: timeout».", "上次会话启动的 sing-box 仍在运行。它独占着缓存文件和虚拟网卡，所以新的连接建立不起来：内核会等待锁十秒，然后以「initialize cache-file: timeout」退出。", "以前のセッションが起動した sing-box がまだ動いています。キャッシュファイルと仮想アダプターを排他的に握っているため、新しい接続は張れません。コアはロックを 10 秒待ってから「initialize cache-file: timeout」で諦めます。", "이전 세션이 실행한 sing-box가 아직 살아 있습니다. 캐시 파일과 가상 어댑터를 독점하고 있어 새 연결을 올릴 수 없습니다: 코어는 잠금을 10초 기다린 뒤 「initialize cache-file: timeout」으로 포기합니다.", "ما زال sing-box الذي بدأته جلسة سابقة يعمل. وهو يحتكر ملف الذاكرة المؤقتة والمحوّل الافتراضي، فلا يمكن رفع اتصال جديد: تنتظر النواة القفل عشر ثوانٍ ثم تستسلم برسالة «initialize cache-file: timeout».", "O sing-box iniciado por uma sessão anterior ainda está rodando. Ele mantém o arquivo de cache e o adaptador virtual com exclusividade, então uma conexão nova não sobe: o núcleo espera dez segundos pelo bloqueio e desiste com «initialize cache-file: timeout»."]);
    out property <string> orphan-traffic: root.tr(["Через него всё ещё может идти трафик", "Traffic may still be flowing through it", "可能仍有流量在经过它", "まだ通信が流れているかもしれません", "아직 트래픽이 흐르고 있을 수 있습니다", "قد تكون الحركة ما زالت تمرّ عبره", "Ainda pode haver tráfego passando por ele"]);
    out property <string> orphan-traffic-text: root.tr(["Завершение оборвёт все соединения, открытые через тот туннель.", "Terminating it drops every connection open through that tunnel.", "终止它会断开该隧道上所有已建立的连接。", "終了させると、そのトンネルで開いている接続はすべて切れます。", "종료하면 그 터널로 열려 있는 모든 연결이 끊깁니다.", "إنهاؤه يقطع كل اتصال مفتوح عبر ذلك النفق.", "Encerrá-lo derruba todas as conexões abertas por aquele túnel."]);
    out property <string> orphan-ask: root.tr(["Завершить его и подключиться?", "Terminate it and connect?", "终止它并连接？", "終了して接続しますか?", "종료하고 연결할까요?", "هل تريد إنهاءه والاتصال؟", "Encerrar e conectar?"]);
    out property <string> orphan-uptime-label: root.tr(["работает", "running for", "已运行", "稼働時間", "실행 시간", "يعمل منذ", "em execução há"]);
    out property <string> orphan-no: root.tr(["Нет", "No", "否", "いいえ", "아니요", "لا", "Não"]);
    out property <string> orphan-yes: root.tr(["Да, завершить", "Yes, terminate", "是，终止", "はい、終了する", "예, 종료합니다", "نعم، أنهِه", "Sim, encerrar"]);
    out property <string> dash-power-hint: root.tr(["Нажмите кнопку питания, чтобы поднять туннель.", "Press the power button to bring the tunnel up.", "按下电源按钮即可建立隧道。", "電源ボタンを押すとトンネルが張られます。", "전원 버튼을 누르면 터널이 올라갑니다.", "اضغط زر التشغيل لرفع النفق.", "Pressione o botão de ligar para subir o túnel."]);
    // Заголовок списка приложений: в вебе split.appsCount со своим {count}.
    out property <string> split-apps-caps: root.tr(["ПРИЛОЖЕНИЯ", "APPS", "应用", "アプリ", "앱", "التطبيقات", "APLICATIVOS"]);
    // Демо-число карточки ресурсов: своё, потому что единица тоже переводится.
    out property <string> set-core-mem-demo: root.tr(["38.4 МБ", "38.4 MB", "38.4 MB", "38.4 MB", "38.4 MB", "38.4 م.بايت", "38,4 MB"]);
    out property <string> set-core-processes: root.tr(["процессов: 1", "1 process", "1 个进程", "1 プロセス", "프로세스 1개", "عملية واحدة", "1 processo"]);
    out property <string> set-core-stopped: root.tr(["не запущено", "not running", "未运行", "停止中", "실행 중 아님", "غير مُشغَّلة", "não está rodando"]);
    out property <string> set-mem-private: root.tr(["Своя память (как в диспетчере задач)", "Private memory (as in Task Manager)", "专用内存（与任务管理器一致）", "専用メモリ（タスク マネージャーと同じ）", "전용 메모리(작업 관리자와 동일)", "الذاكرة الخاصة (كما في «مدير المهام»)", "Memória privada (como no Gerenciador de Tarefas)"]);
    out property <string> set-mem-working-set: root.tr(["Полный working set (с общими DLL)", "Full working set (shared DLLs included)", "完整工作集（含共享 DLL）", "ワーキング セット全体（共有 DLL 込み）", "전체 작업 집합(공유 DLL 포함)", "مجموعة العمل الكاملة (بما فيها مكتبات DLL المشتركة)", "Working set completo (DLLs compartilhadas incluídas)"]);
    out property <string> set-process-count: root.tr(["Процессов в диспетчере задач", "Processes in Task Manager", "任务管理器中的进程数", "タスク マネージャー上のプロセス数", "작업 관리자의 프로세스 수", "عدد العمليات في «مدير المهام»", "Processos no Gerenciador de Tarefas"]);
    out property <string> set-resources-note: root.tr(["Весь интерфейс — один нативный процесс, без WebView2. Обе цифры живые: «своя» память — как колонка в диспетчере задач; полная — вместе с системными DLL, которые загружены в ОЗУ один раз на всю систему.", "The whole interface is one native process, no WebView2. Both figures are live: «private» memory matches the Task Manager column; the full one counts system DLLs, loaded into RAM once for the whole machine.", "整个界面只有一个原生进程，没有 WebView2。两个数字都是实时的：「专用」内存与任务管理器那一列一致；完整值还算上了系统 DLL，而它们在整台机器上只加载进内存一次。", "インターフェースはまるごと 1 つのネイティブプロセスで、WebView2 はありません。どちらの数字も実測です: 「専用」メモリはタスク マネージャーの列と一致し、全体のほうはマシン全体で一度だけ読み込まれるシステム DLL も数えています。", "인터페이스 전체가 네이티브 프로세스 하나이며 WebView2는 없습니다. 두 숫자 모두 실시간입니다: 「전용」 메모리는 작업 관리자 열과 같고, 전체 값은 컴퓨터 전체에서 한 번만 메모리에 올라가는 시스템 DLL까지 셉니다.", "الواجهة كلها عملية أصلية واحدة، بلا WebView2. والرقمان حيّان: الذاكرة «الخاصة» تطابق عمود «مدير المهام»، أما الكاملة فتحتسب معها مكتبات النظام التي تُحمَّل في الذاكرة مرة واحدة للجهاز كله.", "A interface inteira é um único processo nativo, sem WebView2. Os dois números são ao vivo: a memória «privada» bate com a coluna do Gerenciador de Tarefas; a completa conta também as DLLs do sistema, carregadas na RAM uma vez para a máquina toda."]);
    out property <string> toast-elevate-demo: root.tr(["Перезапуск с правами администратора — в спайке только демонстрация", "Restarting as administrator — a demo only in the spike", "正在以管理员身份重启 —— 该功能在此原型中仅为演示", "管理者として再起動しています — スパイクではデモのみです", "관리자 권한으로 다시 시작 중 — 스파이크에서는 데모일 뿐입니다", "يُعاد التشغيل بصلاحيات المسؤول — مجرّد عرض توضيحي في النموذج", "Reiniciando como administrador — apenas uma demonstração no protótipo"]);
}
