// Строки интерфейса. Значения — те же, что в src/lib/locales/*.ts: имя
// свойства собрано из ключа словаря, поэтому одну и ту же строку легко найти и
// здесь, и там. Строки, которых в вебе нет (трей, уведомления Windows, диалог
// осиротевшего ядра, карточка ресурсов спайка), идут в конце.
//
// Журнал не переводится намеренно: там вывод самого движка.

import { Conf } from "data.slint";

export global Str {
    // Порядок языков в каждом массиве — тот же, что у LANGS в i18n.ts:
    // ru, en, zh, ja, ko, ar, pt. Conf.language нумерует их с единицы, ноль
    // означает «как в системе» — его разрешает Rust в Conf.system-lang по
    // локали Windows, тем же правилом, что systemLang в i18n.ts.
    out property <int> lang: Conf.language == 0 ? Conf.system-lang : Conf.language;
    pure function tr(v: [string]) -> string { return v[root.lang - 1]; }
    // Названия языков в самих языках — для списка в настройках.
    out property <[string]> lang-names: ["Русский", "English", "简体中文", "日本語", "한국어", "العربية", "Português"];
    // База стран знает только английские и русские названия, поэтому всем
    // остальным языкам достаётся английское.
    out property <bool> country-en: root.lang != 1;

    out property <string> fmt-never: root.tr(["никогда", "never", "从未", "なし", "없음", "أبدًا", "nunca"]);
    out property <string> fmt-just-now: root.tr(["только что", "just now", "刚刚", "たった今", "방금", "الآن", "agora mesmo"]);
    out property <string> fmt-min-ago: root.tr(["{n} мин назад", "{n} min ago", "{n} 分钟前", "{n} 分前", "{n}분 전", "قبل {n} دقيقة", "há {n} min"]);
    out property <string> fmt-hours-ago: root.tr(["{n} ч назад", "{n} h ago", "{n} 小时前", "{n} 時間前", "{n}시간 전", "قبل {n} ساعة", "há {n} h"]);
    out property <string> fmt-days-ago: root.tr(["{n} дн назад", "{n} d ago", "{n} 天前", "{n} 日前", "{n}일 전", "قبل {n} يوم", "há {n} d"]);
    out property <string> fmt-day-forms: root.tr(["день|дня|дней", "day|days|days", "天|天|天", "日|日|日", "일|일|일", "يوم|أيام|يومًا", "dia|dias|dias"]);
    out property <string> fmt-no-expiry: root.tr(["бессрочно", "no expiry", "无限期", "無期限", "무기한", "بلا انتهاء", "sem validade"]);
    out property <string> fmt-expired: root.tr(["истекла", "expired", "已过期", "期限切れ", "만료됨", "منتهية", "expirada"]);
    out property <string> fmt-expires-today: root.tr(["истекает сегодня", "expires today", "今天到期", "本日期限切れ", "오늘 만료", "تنتهي اليوم", "expira hoje"]);
    out property <string> srv-updated-when: root.tr(["обновлено {when}", "updated {when}", "{when}更新", "{when}に更新", "{when} 갱신", "حُدّث {when}", "atualizado {when}"]);
    out property <string> srv-server-one: root.tr(["сервер", "server", "台服务器", "台のサーバー", "개 서버", "خادم", "servidor"]);
    out property <string> srv-server-few: root.tr(["сервера", "servers", "台服务器", "台のサーバー", "개 서버", "خوادم", "servidores"]);
    out property <string> srv-server-many: root.tr(["серверов", "servers", "台服务器", "台のサーバー", "개 서버", "خادمًا", "servidores"]);
    // Раздел для серверов, добавленных руками: подписки у них нет, а место
    // в списке разделов нужно.
    out property <string> srv-own-group: root.tr(["Свои серверы", "Own servers", "自有服务器", "自前のサーバー", "직접 추가한 서버", "خوادمي", "Servidores próprios"]);
    out property <string> srv-expired-warning: root.tr(["Срок действия истёк — серверы, скорее всего, уже не отвечают.", "The subscription has expired — the servers most likely no longer respond.", "订阅已过期 —— 这些服务器多半已经不再响应。", "サブスクリプションの期限が切れています。サーバーはおそらくもう応答しません。", "구독이 만료되었습니다 — 서버는 대개 더 이상 응답하지 않습니다.", "انتهت صلاحية الاشتراك — والخوادم على الأرجح لم تعد تستجيب.", "A assinatura expirou — os servidores provavelmente já não respondem."]);
    out property <string> srv-exhausted-warning: root.tr(["Трафик исчерпан — продлите тариф в панели.", "Data limit reached — renew your plan in the panel.", "流量已用尽 —— 请在面板中续费。", "データ量を使い切りました。パネルでプランを更新してください。", "데이터 한도에 도달했습니다 — 패널에서 요금제를 연장하세요.", "نفدت حصة البيانات — جدّد باقتك من اللوحة.", "Franquia de dados esgotada — renove o plano no painel."]);
    out property <string> dash-state-connecting: root.tr(["Подключение", "Connecting", "连接中", "接続中", "연결 중", "جارٍ الاتصال", "Conectando"]);
    out property <string> dash-state-error: root.tr(["Ошибка", "Error", "错误", "エラー", "오류", "خطأ", "Erro"]);
    out property <string> tray-show: root.tr(["Показать окно", "Show window", "显示窗口", "ウィンドウを表示", "창 표시", "إظهار النافذة", "Mostrar a janela"]);
    out property <string> tray-connect: root.tr(["Подключить", "Connect", "连接", "接続", "연결", "اتصال", "Conectar"]);
    out property <string> tray-disconnect: root.tr(["Отключить", "Disconnect", "断开", "切断", "연결 끊기", "قطع الاتصال", "Desconectar"]);
    out property <string> tray-quit: root.tr(["Выход", "Quit", "退出", "終了", "종료", "خروج", "Sair"]);
    out property <string> set-country-data: root.tr(["Данные о странах", "Country data", "国家数据", "国のデータ", "국가 데이터", "بيانات الدول", "Dados de países"]);
    out property <string> set-country-source:    "IP Geolocation by DB-IP (CC BY 4.0)";
    out property <string> set-notifications: root.tr(["Уведомления Windows", "Windows notifications", "Windows 通知", "Windows の通知", "Windows 알림", "إشعارات Windows", "Notificações do Windows"]);
    out property <string> set-notifications-desc: root.tr(["О поднятии и падении туннеля сообщает центр уведомлений. При первом включении создаётся ярлык в меню «Пуск» — без него Windows не принимает уведомления от приложения.", "The tunnel going up or down is reported to the notification centre. The first time this is switched on, a Start menu shortcut is created — without it Windows refuses to accept notifications from the app.", "隧道的建立与断开会通知到操作中心。首次启用时会在「开始」菜单创建快捷方式 —— 没有它 Windows 不会接受本应用的通知。", "トンネルの開始と停止は通知センターに知らせます。初めてオンにしたときスタート メニューにショートカットが作られます — これがないと Windows はアプリからの通知を受け付けません。", "터널이 올라가고 내려가는 것을 알림 센터에 알립니다. 처음 켤 때 시작 메뉴 바로 가기를 만듭니다 — 이것이 없으면 Windows가 앱의 알림을 받아 주지 않습니다.", "يُبلَّغ مركز الإشعارات عند رفع النفق وسقوطه. وعند التفعيل أول مرة يُنشأ اختصار في قائمة «ابدأ» — فبدونه يرفض Windows قبول إشعارات التطبيق.", "A subida e a queda do túnel são informadas à central de notificações. Na primeira vez que isto é ligado, um atalho no menu Iniciar é criado — sem ele o Windows recusa as notificações do aplicativo."]);
    out property <string> notify-connected-title: root.tr(["Подключено", "Connected", "已连接", "接続しました", "연결됨", "تم الاتصال", "Conectado"]);
    out property <string> notify-disconnected-title: root.tr(["Отключено", "Disconnected", "已断开", "切断しました", "연결 끊김", "انقطع الاتصال", "Desconectado"]);
    out property <string> notify-error-title: root.tr(["Ошибка подключения", "Connection error", "连接错误", "接続エラー", "연결 오류", "خطأ في الاتصال", "Erro de conexão"]);
    out property <string> notify-orphan-title: root.tr(["Ядро от прошлого сеанса", "A core from a previous session", "上次会话遗留的内核", "前回のセッションのコア", "이전 세션의 코어", "نواة من جلسة سابقة", "Um núcleo de uma sessão anterior"]);
    out property <string> notify-orphan-body: root.tr(["Подключение остановлено: sing-box от прошлого сеанса всё ещё работает. Откройте Aurora VPN, чтобы решить, что с ним делать.", "The connection stopped: sing-box from an earlier session is still running. Open Aurora VPN to decide what to do with it.", "连接已停止：上次会话的 sing-box 仍在运行。请打开 Aurora VPN 决定如何处理它。", "接続を停止しました: 以前のセッションの sing-box がまだ動いています。Aurora VPN を開いて、どうするか決めてください。", "연결이 멈췄습니다: 이전 세션의 sing-box가 아직 실행 중입니다. Aurora VPN을 열어 어떻게 할지 정하세요.", "توقّف الاتصال: ما زال sing-box من جلسة سابقة يعمل. افتح Aurora VPN لتقرّر ما تفعله به.", "A conexão parou: o sing-box de uma sessão anterior ainda está rodando. Abra o Aurora VPN para decidir o que fazer com ele."]);
    out property <string> set-autostart-failed: root.tr(["Не удалось изменить автозапуск", "Could not change autostart", "修改开机自启失败", "自動起動を変更できませんでした", "자동 시작을 변경하지 못했습니다", "تعذّر تغيير البدء التلقائي", "Não foi possível alterar o início automático"]);
    // Строки, которые подставляет сам Rust: единицы, состояния, тосты и
    // демо-данные. Он снимает с них копию (Lang в main.rs) — читать глобал на
    // каждый тик графика дороже, чем держать снимок.
    out property <string> srv-latency-ms: root.tr(["{ms} мс", "{ms} ms", "{ms} 毫秒", "{ms} ms", "{ms} ms", "{ms} م.ث", "{ms} ms"]);
    out property <string> dash-na: root.tr(["н/д", "n/a", "无", "n/a", "n/a", "غير متاح", "n/d"]);
    out property <string> split-instances-count: root.tr(["{count} проц.", "{count} processes", "{count} 个进程", "{count} プロセス", "프로세스 {count}개", "{count} عملية", "{count} processos"]);
    out property <string> graph-peak: root.tr(["пик", "peak", "峰值", "ピーク", "최고", "الذروة", "pico"]);
    out property <string> fmt-per-second: root.tr(["/с", "/s", "/秒", "/秒", "/초", "/ث", "/s"]);
    out property <string> fmt-byte-units: root.tr(["Б|КБ|МБ|ГБ|ТБ", "B|KB|MB|GB|TB", "B|KB|MB|GB|TB", "B|KB|MB|GB|TB", "B|KB|MB|GB|TB", "بايت|ك.بايت|م.بايت|غ.بايت|ت.بايت", "B|KB|MB|GB|TB"]);
    out property <string> dash-state-connected: root.tr(["Подключено", "Connected", "已连接", "接続済み", "연결됨", "متصل", "Conectado"]);
    out property <string> dash-state-disconnected: root.tr(["Отключено", "Disconnected", "已断开", "切断済み", "연결 끊김", "غير متصل", "Desconectado"]);
    out property <string> srv-server-deleted: root.tr(["Сервер «{name}» удалён", "Server “{name}” deleted", "服务器「{name}」已删除", "サーバー「{name}」を削除しました", "서버 「{name}」을(를) 삭제했습니다", "حُذف الخادم «{name}»", "Servidor “{name}” excluído"]);
    out property <string> srv-link-copied: root.tr(["Ссылка скопирована", "Link copied", "链接已复制", "リンクをコピーしました", "링크를 복사했습니다", "نُسخ الرابط", "Link copiado"]);
    out property <string> srv-server-saved: root.tr(["Сервер сохранён", "Server saved", "服务器已保存", "サーバーを保存しました", "서버를 저장했습니다", "حُفظ الخادم", "Servidor salvo"]);
    out property <string> srv-server-added: root.tr(["Сервер добавлен", "Server added", "服务器已添加", "サーバーを追加しました", "서버를 추가했습니다", "أُضيف الخادم", "Servidor adicionado"]);
