// Строки и карточки, привязанные к данным: подписка, сервер, приложение.
// В вебе это SubscriptionCard.tsx и классы .node/.app-row из styles.css.

import { Theme, Icons, Card, NavIcon, MicroRow } from "theme.slint";
import { IconBtn, Chip, Dot, Meter, Switch, RoundRect } from "widgets.slint";
import { ServerNode, SubInfo, NodeGroup, AppRule, RunningApp, Data, Conf, Ui } from "data.slint";
import { Str } from "i18n.slint";

// .sub-card: остаток срока и трафика по данным панели.
export component SubCard inherits Card {
    in property <SubInfo> sub;
    in property <bool> deletable;
    callback refresh();
    callback remove();
    pad-x: 18px;
    pad-y: 16px;
    gap: 12px;

    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            NavIcon {
                commands: Icons.rss;
                tint: Theme.text-muted;
                width: 15px;
                height: 15px;
            }
        }
        Text {
            text: root.sub.name;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            font-size: 13.5px * Theme.text-scale;
            font-weight: 550;
            color: Theme.text;
        }
        if root.deletable: IconBtn {
            icon: Icons.trash;
            ghost: true;
            compact: true;
            clicked => { root.remove(); }
        }
        IconBtn {
            icon: Icons.refresh;
            ghost: true;
            compact: true;
            clicked => { root.refresh(); }
        }
    }

    if root.sub.has-usage: HorizontalLayout {
        spacing: 14px;
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            MicroRow {
                icon: Icons.calendar-clock;
                label: Str.srv-remaining-caps;
            }
            Text {
                text: root.sub.expiry;
                font-size: 19px * Theme.text-scale;
                font-weight: 660;
                letter-spacing: -0.4px;
                overflow: elide;
                color: root.sub.expiry-tier == "bad"
                    ? Theme.danger
                    : (root.sub.expiry-tier == "ok"
                        ? Theme.warn
                        : (root.sub.expiry-tier == "good" ? Theme.ok : Theme.text));
            }
        }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            HorizontalLayout {
                alignment: end;
                Text {
                    text: Str.srv-traffic-label-caps;
                    font-size: 10.5px * Theme.text-scale;
                    font-weight: 640;
                    letter-spacing: 1px;
                    color: Theme.text-muted;
                }
            }
            Text {
                text: root.sub.traffic;
                horizontal-alignment: right;
                font-size: 19px * Theme.text-scale;
                font-weight: 660;
                letter-spacing: -0.4px;
                overflow: elide;
                color: Theme.text;
            }
        }
    }
    if root.sub.has-usage: Meter {
        value: root.sub.used;
        tier: root.sub.used >= 1.0 ? "bad" : (root.sub.used > 0.85 ? "ok" : "");
    }
    if !root.sub.has-usage: Text {
        text: Str.srv-no-usage-info;
        font-size: 10.5px * Theme.text-scale;
        font-weight: 640;
        letter-spacing: 1px;
        color: Theme.text-muted;
    }
    if root.sub.warning != "": Text {
        text: root.sub.warning;
        font-size: 12px * Theme.text-scale;
        color: Theme.danger;
        wrap: word-wrap;
    }

    Text {
        text: root.sub.foot;
        font-size: 11.5px * Theme.text-scale;
        color: Theme.text-muted;
        overflow: elide;
    }
}

// .node: строка сервера в списке.
export component NodeRow inherits Rectangle {
    in property <ServerNode> node;
    in property <bool> active;
    // Через этот узел ведёт трафик балансировщик: подсвечен его пункт, а
    // строке сервера достаётся только отметка «сейчас».
    in property <bool> routed;
    callback select();
    callback copy-link();
    callback edit();
    callback remove();
    // Перетаскивание: `drag-move` отдаёт, насколько указатель уехал от места
    // нажатия — раскладка одинаковых по высоте строк переводит это в номер.
    callback drag-start(length);
    callback drag-move(length);
    callback drag-end();
    // Строку держат: она приглушена, пока не отпустят.
    in property <bool> dragging;
    height: 62px;
    opacity: root.dragging ? 0.7 : 1.0;
    drop-shadow-blur: root.dragging ? 22px : (root.active ? 20px : 0px);
    vertical-stretch: 0;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    background: touch.has-hover && !root.active ? Theme.panel-hover : Theme.panel;
    animate background { duration: 130ms; }
    drop-shadow-color: root.dragging
        ? Theme.shadow-deep
        : (root.active ? Theme.accent.transparentize(0.6) : #00000000);

    // Подсветка выбранной строки. В вебе это градиент, здесь — ровная
    // заливка: полупрозрачный Path на софтверном рендере копится слоями при
    // частичной перерисовке (подробнее — в NavItem).
    if root.active: Rectangle {
        border-radius: 12px;
        background: Theme.accent-soft;
    }
    Rectangle {
        x: 12px;
        y: 1px;
        width: parent.width - 24px;
        height: 1px;
        background: Theme.sheen;
    }

    touch := TouchArea {
        // См. шапку раздела: щелчок засчитывается только тому, кто его начал,
        // иначе конец перетаскивания выбирал бы тот сервер, над которым палец
        // отпустили.
        property <bool> mine;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.mine = true;
            }
        }
        clicked => {
            if (self.mine) {
                root.select();
            }
            self.mine = false;
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 13px;

        // Ручка перетаскивания. Отдельная, а не вся строка: по строке щёлкают,
        // чтобы выбрать сервер, и её же тянут пальцем, когда прокручивают
        // список.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 14px;
                height: 34px;
                NavIcon {
                    commands: Icons.grip;
                    tint: Theme.text-muted;
                    width: 14px;
                    height: 14px;
                    opacity: grip.has-hover || root.dragging ? 0.9 : 0.32;
                    animate opacity { duration: 130ms; }
                }
                grip := TouchArea {
                    mouse-cursor: root.dragging ? grabbing : grab;
                    // Указатель в координатах окна, а не смещение от места
                    // нажатия: строка под пальцем сама переезжает на новое
                    // место, и отсчёт от неё сбрасывал бы сам себя — вышла бы
                    // петля, в которой список дёргается и никуда не едет.
                    // Сумма же положения ручки и курсора внутри неё от переезда
                    // не меняется.
                    moved => { root.drag-move(self.absolute-position.y + self.mouse-y); }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.drag-start(self.absolute-position.y + self.mouse-y);
                        }
                        if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                            root.drag-end();
                        }
                    }
                }
            }
        }

        // .node-radio
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 2px;
                border-color: root.active ? Theme.accent : Theme.border-strong;
                if root.active: Rectangle {
                    x: 4px;
                    y: 4px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                }
            }
        }

        // Серый значок сервера — пара акцентному значку стратегии в том же
        // столбце: по нему два вида строк различаются с первого взгляда.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 9px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.sunken;
                NavIcon {
                    commands: Icons.server;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    tint: root.active ? Theme.accent-text : Theme.text-muted;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.node.name;
                overflow: elide;
                font-size: 13.5px * Theme.text-scale;
                font-weight: 550;
                color: Theme.text;
            }
            HorizontalLayout {
                spacing: 7px;
                alignment: start;
                if root.routed: Chip {
                    label: Str.pick-now-chip;
                    kind: "accent";
                }
                Chip { label: root.node.proto; }
                if root.node.country != "": Text {
                    text: root.node.country;
                    vertical-alignment: center;
                    font-size: 11.5px * Theme.text-scale;
                    font-weight: 600;
                    color: Theme.text-dim;
                }
                if root.node.country != "": Text {
                    text: "·";
                    vertical-alignment: center;
                    font-size: 11.5px * Theme.text-scale;
                    color: Theme.text-muted;
                }
                Text {
                    text: root.node.transport;
                    vertical-alignment: center;
                    font-size: 11.5px * Theme.text-scale;
                    color: Theme.text-muted;
                }
                Text {
                    text: "·";
                    vertical-alignment: center;
                    font-size: 11.5px * Theme.text-scale;
                    color: Theme.text-muted;
                }
                Text {
                    text: root.node.address;
                    vertical-alignment: center;
                    overflow: elide;
                    font-size: 11.5px * Theme.text-scale;
                    color: Theme.text-muted;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Dot { tier: root.node.tier; }
        }
        VerticalLayout {
            alignment: center;
            min-width: 52px;
            Text {
                text: root.node.latency;
                horizontal-alignment: right;
                font-size: 12px * Theme.text-scale;
                // Многоточие ожидания приглушено, приехавшая цифра проявляется.
                // Цветом, а не прозрачностью: полупрозрачную строку рендерер
                // обходит целиком каждый кадр, а таких строк на экране сотня.
                color: root.node.tier == "busy" ? Theme.text-muted : Theme.text-dim;
                animate color { duration: 260ms; easing: ease-out; }
            }
        }

        // .node-actions: проявляются под курсором.
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 4px;
                // visible, а не opacity: прозрачное поддерево рендерер всё
                // равно обходит и рисует, а это три иконки на каждой из сотни
                // строк — на прокрутке они и съедали кадры.
                visible: touch.has-hover || copy-btn.hovered || edit-btn.hovered || del-btn.hovered;
                copy-btn := IconBtn {
                    icon: Icons.copy;
                    ghost: true;
                    clicked => { root.copy-link(); }
                }
                edit-btn := IconBtn {
                    icon: Icons.pencil;
                    ghost: true;
                    clicked => { root.edit(); }
                }
                del-btn := IconBtn {
                    icon: Icons.trash;
                    ghost: true;
                    clicked => { root.remove(); }
                }
            }
        }
    }
}

// .balancer-row: стратегия выбора сервера в одном списке с серверами — как
// «Auto» у Hiddify: отдельный пункт, а не тумблер в настройках. Своя иконка
// отличает её от сервера с первого взгляда. Подписи и состояние берутся из
// глобалов, поэтому строка одинаково служит странице серверов и меню выбора
// на «Обзоре» (compact: ниже, без радиокнопки, на прозрачной подложке).
export component BalancerRow inherits Rectangle {
    // 1 с резервом, 2 самый быстрый, 3 по кругу — порядок settings::Balancer.
    in property <int> kind;
    in property <bool> compact;
    callback select();

    property <bool> active: Conf.balancer == root.kind;
    // На резерве: выбранный сервер не отвечает, трафик идёт через замену.
    property <bool> alarmed: root.kind == 1 && root.active && Data.on-backup;
    property <string> icon: root.kind == 1
        ? Icons.life-buoy
        : (root.kind == 2 ? Icons.zap : Icons.repeat);
    property <string> label: root.kind == 1
        ? Str.set-balancer-failover
        : (root.kind == 2 ? Str.set-balancer-fastest : Str.set-balancer-rotate);
    // Пока стратегия ведёт трафик — через кого; иначе, что она станет делать.
    property <string> meta: root.active && Data.connected
        ? (root.alarmed
            ? "\{Str.pick-now} \{Data.active-name} · \{Str.pick-primary-down}"
            : "\{Str.pick-now} \{Data.active-name}")
        : (root.kind == 1
            ? "\{Str.pick-primary} \{Data.pinned-name}"
            : (root.kind == 2 ? Str.pick-fastest-meta : Str.pick-rotate-meta));

    height: root.compact ? 48px : 62px;
    vertical-stretch: 0;
    border-radius: root.compact ? 8px : 12px;
    border-width: root.compact ? 0px : 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    background: root.compact
        ? (root.active ? Theme.accent-soft : (touch.has-hover ? Theme.panel-hover : #00000000))
        : (touch.has-hover && !root.active ? Theme.panel-hover : Theme.panel);
    animate background { duration: 130ms; }
    drop-shadow-blur: root.active && !root.compact ? 20px : 0px;
    drop-shadow-color: root.active && !root.compact ? Theme.accent.transparentize(0.6) : #00000000;

    if root.active && !root.compact: Rectangle {
        border-radius: 12px;
        background: Theme.accent-soft;
    }
    if !root.compact: Rectangle {
        x: 12px;
        y: 1px;
        width: parent.width - 24px;
        height: 1px;
        background: Theme.sheen;
    }

    touch := TouchArea {
        clicked => { root.select(); }
    }

    HorizontalLayout {
        padding-left: root.compact ? 10px : 14px;
        padding-right: root.compact ? 10px : 14px;
        spacing: root.compact ? 10px : 13px;

        if !root.compact: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 2px;
                border-color: root.active ? Theme.accent : Theme.border-strong;
                if root.active: Rectangle {
                    x: 4px;
                    y: 4px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                }
            }
        }

        // Значок в кружке: у серверов на этом месте серый, у стратегий —
        // акцентный, на резерве — предупреждающий.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.compact ? 26px : 30px;
                height: root.compact ? 26px : 30px;
                border-radius: root.compact ? 8px : 9px;
                background: root.alarmed ? Theme.warn.transparentize(0.82) : Theme.accent-soft;
                NavIcon {
                    commands: root.icon;
                    width: root.compact ? 14px : 16px;
                    height: root.compact ? 14px : 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    tint: root.alarmed ? Theme.warn : Theme.accent-text;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: root.compact ? 1px : 2px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                overflow: elide;
                font-size: 13.5px * Theme.text-scale;
                font-weight: 550;
                color: root.compact
                    ? (root.active ? Theme.accent-text : Theme.text-dim)
                    : Theme.text;
            }
            Text {
                text: root.meta;
                overflow: elide;
                font-size: 11.5px * Theme.text-scale;
                color: root.alarmed ? Theme.warn : Theme.text-muted;
            }
        }

        if root.compact && root.active: VerticalLayout {
            alignment: center;
            NavIcon {
                commands: Icons.check;
                width: 13px;
                height: 13px;
                tint: Theme.accent-text;
            }
        }
    }
}

// Раздел списка серверов: подписка, под ней — её серверы.
//
// Полосой карточек подписки жить перестали: четвёртая уже выдавливала соседей
// за край окна, а сотня серверов одной простынёй всё равно нечитаема. Здесь
// подписка — строка во всю ширину, и серверы раскрываются по щелчку.
export component NodeGroupSection inherits VerticalLayout {
    in property <NodeGroup> group;
    in property <string> active-id;
    // Узел, через который сейчас ведёт трафик балансировщик (см. NodeRow).
    in property <string> routed-id;
    callback toggle();
    callback refresh();
    callback remove();
    callback select(string);
    callback copy-link(string);
    callback edit(string);
    callback remove-node(string);
    // Строку отпустили на новом месте: id и новый номер внутри этого раздела.
    callback reorder(string, int);
    // Раздел отпустили на новом месте: его новый номер среди разделов.
    callback reorder-section(int);
    // Номер этого раздела в списке — им он и отвечает, когда указатель внутри.
    in property <int> index;

    // У раздела своих серверов подписки нет: ни обновлять, ни удалять нечего.
    property <bool> own: root.group.sub.id == "";

    // Откуда тянут и куда встанет; -1 — не тянут. Шаг списка: высота строки
    // плюс промежуток, одинаковые у всех, поэтому номер считается делением, а
    // не поиском строки под указателем.
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    property <length> row-pitch: 70px;
    // Где был указатель, когда за строку взялись, — в координатах окна.
    property <length> drag-press-y;

    // Куда строка едет прямо сейчас. Пока её держат, список уже стоит в новом
    // порядке: строки, через которые она проходит, отступают на одно место —
    // и это видно, а не обещано линией.
    pure function slot-of(index: int) -> int {
        if (root.drag-from < 0) {
            return index;
        }
        if (index == root.drag-from) {
            return root.drag-to;
        }
        if (root.drag-from < root.drag-to && index > root.drag-from && index <= root.drag-to) {
            return index - 1;
        }
        if (root.drag-from > root.drag-to && index >= root.drag-to && index < root.drag-from) {
            return index + 1;
        }
        return index;
    }

    // Указатель, тянущий какой-то раздел, сейчас над этим. Отвечает раздел сам:
    // чужой высоты он не знает, а свою — знает.
    property <bool> under-pointer: Ui.group-drag >= 0
        && Ui.group-drag-y >= root.absolute-position.y
        && Ui.group-drag-y < root.absolute-position.y + root.height;
    changed under-pointer => {
        if (root.under-pointer) {
            Ui.group-drop-to = root.index;
        }
    }
    // Этот раздел держат; сюда он встанет.
    property <bool> held: Ui.group-drag == root.index;
    property <bool> drop-here: Ui.group-drag >= 0
        && Ui.group-drop-to == root.index
        && Ui.group-drag != root.index;

    // Раздел, на чьё место встанет перетаскиваемый, расступается ровно на его
    // высоту — с той стороны, откуда тот едет. Пустое место и есть ответ на
    // вопрос «куда»; подсветка рамки его только обещала.
    padding-top: root.drop-here && Ui.group-drag > root.index
        ? Ui.group-drag-h + 10px
        : 0px;
    padding-bottom: root.drop-here && Ui.group-drag < root.index
        ? Ui.group-drag-h + 10px
        : 0px;
    animate padding-top, padding-bottom { duration: 140ms; easing: ease-out; }

    spacing: 8px;

    // ---- шапка раздела
    Rectangle {
        vertical-stretch: 0;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        background: head.has-hover ? Theme.panel-hover : Theme.panel;
        opacity: root.held ? 0.55 : 1.0;
        animate background { duration: 130ms; }

        // Ниже кнопок по порядку — те перехватывают щелчок первыми.
        head := TouchArea {
            clicked => { root.toggle(); }
        }

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 12px;

                // Раздел своих серверов подписке не соответствует, и переставлять
                // его местами не с чем: он всегда идёт последним.
                if !root.own: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 14px;
                        height: 34px;
                        NavIcon {
                            commands: Icons.grip;
                            tint: Theme.text-muted;
                            width: 14px;
                            height: 14px;
                            opacity: section-grip.has-hover || root.held ? 0.9 : 0.32;
                            animate opacity { duration: 130ms; }
                        }
                        section-grip := TouchArea {
                            mouse-cursor: root.held ? grabbing : grab;
                            moved => {
                                // Указатель в координатах окна: раздел под ним
                                // отзовётся сам.
                                Ui.group-drag-y = self.absolute-position.y + self.mouse-y;
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    Ui.group-drag = root.index;
                                    Ui.group-drop-to = root.index;
                                    Ui.group-drag-h = root.height;
                                    Ui.group-drag-y = self.absolute-position.y + self.mouse-y;
                                }
                                if (e.kind == PointerEventKind.up
                                    || e.kind == PointerEventKind.cancel) {
                                    if (e.kind == PointerEventKind.up
                                        && Ui.group-drop-to >= 0
                                        && Ui.group-drop-to != root.index) {
                                        root.reorder-section(Ui.group-drop-to);
                                    }
                                    Ui.group-drag = -1;
                                    Ui.group-drop-to = -1;
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    NavIcon {
                        commands: root.group.expanded ? Icons.chevron-up : Icons.chevron-down;
                        tint: Theme.text-muted;
                        width: 14px;
                        height: 14px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    NavIcon {
                        commands: root.own ? Icons.server : Icons.rss;
                        tint: Theme.text-muted;
                        width: 15px;
                        height: 15px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.group.sub.name;
                        overflow: elide;
                        font-size: 13.5px * Theme.text-scale;
                        font-weight: 550;
                        color: Theme.text;
                    }
                    Text {
                        text: root.group.sub.foot;
                        overflow: elide;
                        font-size: 11.5px * Theme.text-scale;
                        color: Theme.text-muted;
                    }
                }

                // Срок и трафик — те же цифры, что стояли на карточке, только
                // в строку: так они не растут вместе с числом подписок.
                if root.group.sub.has-usage: VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    MicroRow {
                        icon: Icons.calendar-clock;
                        label: Str.srv-remaining-caps;
                    }
                    Text {
                        text: root.group.sub.expiry;
                        font-size: 14px * Theme.text-scale;
                        font-weight: 640;
                        letter-spacing: -0.2px;
                        overflow: elide;
                        color: root.group.sub.expiry-tier == "bad"
                            ? Theme.danger
                            : (root.group.sub.expiry-tier == "ok"
                                ? Theme.warn
                                : (root.group.sub.expiry-tier == "good" ? Theme.ok : Theme.text));
                    }
                }
                if root.group.sub.has-usage: VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    HorizontalLayout {
                        alignment: end;
                        Text {
                            text: Str.srv-traffic-label-caps;
                            font-size: 10.5px * Theme.text-scale;
                            font-weight: 640;
                            letter-spacing: 1px;
                            color: Theme.text-muted;
                        }
                    }
                    Text {
                        text: root.group.sub.traffic;
                        horizontal-alignment: right;
                        font-size: 14px * Theme.text-scale;
                        font-weight: 640;
                        letter-spacing: -0.2px;
                        overflow: elide;
                        color: Theme.text;
                    }
                }

                if !root.own: VerticalLayout {
                    alignment: center;
                    IconBtn {
                        icon: Icons.refresh;
                        ghost: true;
                        compact: true;
                        clicked => { root.refresh(); }
                    }
                }
                if !root.own: VerticalLayout {
                    alignment: center;
                    IconBtn {
                        icon: Icons.trash;
                        ghost: true;
                        compact: true;
                        clicked => { root.remove(); }
                    }
                }
            }

            if root.group.sub.has-usage: Meter {
                value: root.group.sub.used;
                tier: root.group.sub.used >= 1.0 ? "bad" : (root.group.sub.used > 0.85 ? "ok" : "");
            }
            if root.group.sub.warning != "": Text {
                text: root.group.sub.warning;
                font-size: 12px * Theme.text-scale;
                color: Theme.danger;
                wrap: word-wrap;
            }
        }
    }

    // ---- серверы раздела
    // Не лэйаут: строки расставлены вручную, потому что под перетаскиванием им
    // надо разъезжаться, а лэйаут положениями своих детей ни с кем не делится.
    // Высота у всех одна, так что место — это номер, умноженный на шаг.
    if root.group.expanded: Rectangle {
        vertical-stretch: 0;
        height: root.group.nodes.length * root.row-pitch - 8px + 4px;
        for node[i] in root.group.nodes: NodeRow {
            x: 14px;
            y: root.slot-of(i) * root.row-pitch;
            width: parent.width - 14px;
            animate y { duration: 140ms; easing: ease-out; }
            node: node;
            active: node.id == root.active-id;
            routed: node.id == root.routed-id;
            dragging: root.drag-from == i;
            select => { root.select(node.id); }
            copy-link => { root.copy-link(node.id); }
            edit => { root.edit(node.id); }
            remove => { root.remove-node(node.id); }
            drag-start(at) => {
                root.drag-from = i;
                root.drag-to = i;
                root.drag-press-y = at;
            }
            drag-move(at) => {
                root.drag-to = clamp(
                    i + Math.round((at - root.drag-press-y) / root.row-pitch),
                    0,
                    root.group.nodes.length - 1);
            }
            drag-end => {
                if (root.drag-from >= 0 && root.drag-to != root.drag-from) {
                    root.reorder(node.id, root.drag-to);
                }
                root.drag-from = -1;
                root.drag-to = -1;
            }
        }
    }
}

// .app-icon: настоящая иконка программы, а пока её не добыли (или если её у
// файла нет) — квадрат с первой буквой имени процесса.
export component AppIcon inherits Rectangle {
    in property <string> letter;
    in property <image> icon;
    width: 30px;
    height: 30px;
    // Иконка приходит из Rust ровно в тех физических пикселях, которыми и
    // будет нарисована, поэтому масштабировать её здесь нечем и незачем —
    // почему именно так, в src/icons.rs.
    if root.icon.width > 0: Image {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        source: root.icon;
        image-fit: fill;
    }
    if root.icon.width == 0: RoundRect {
        radius: 8px;
        fill: @linear-gradient(135deg, Theme.avatar-from 0%, Theme.avatar-to 100%);
    }
    if root.icon.width == 0: Text {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        text: root.letter;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 13px * Theme.text-scale;
        font-weight: 650;
        color: Theme.text-dim;
    }
}

// .app-row: приложение в списке раздельного туннеля.
export component AppRow inherits Rectangle {
    in property <AppRule> app;
    callback toggled(bool);
    callback remove();
    height: 50px;
    vertical-stretch: 0;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.panel;
    Rectangle {
        x: 10px;
        y: 1px;
        width: parent.width - 20px;
        height: 1px;
        background: Theme.sheen;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 11px;
        VerticalLayout {
            alignment: center;
            AppIcon { letter: root.app.initial; icon: root.app.icon; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.app.name;
                overflow: elide;
                font-size: 13.5px * Theme.text-scale;
                font-weight: 550;
                color: Theme.text;
            }
            Text {
                text: root.app.path == "" ? Str.split-match-by-name : root.app.path;
                overflow: elide;
                font-size: 11.5px * Theme.text-scale;
                color: Theme.text-muted;
            }
        }
        VerticalLayout {
            alignment: center;
            Switch {
                checked: root.app.enabled;
                toggled(on) => { root.toggled(on); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconBtn {
                icon: Icons.trash;
                ghost: true;
                clicked => { root.remove(); }
            }
        }
    }
}

// Строка списка «Запущенные приложения»: та же .app-row, но с выбором.
export component ProcRow inherits Rectangle {
    in property <RunningApp> proc;
    callback toggle();
    height: 50px;
    vertical-stretch: 0;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.proc.selected ? Theme.accent : Theme.border;
    background: touch.has-hover && !root.proc.added ? Theme.panel-hover : Theme.panel;
    opacity: root.proc.added ? 0.5 : 1.0;
    animate background { duration: 130ms; }
    Rectangle {
        x: 10px;
        y: 1px;
        width: parent.width - 20px;
        height: 1px;
        background: Theme.sheen;
    }
    touch := TouchArea {
        enabled: !root.proc.added;
        clicked => { root.toggle(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 11px;
        VerticalLayout {
            alignment: center;
            AppIcon { letter: root.proc.initial; icon: root.proc.icon; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.proc.name;
                overflow: elide;
                font-size: 13.5px * Theme.text-scale;
                font-weight: 550;
                color: Theme.text;
            }
            Text {
                text: root.proc.path;
                overflow: elide;
                font-size: 11.5px * Theme.text-scale;
                color: Theme.text-muted;
            }
        }
        if root.proc.instances != "": VerticalLayout {
            alignment: center;
            Chip { label: root.proc.instances; }
        }
        if root.proc.added: VerticalLayout {
            alignment: center;
            Chip { label: Str.split-already-added; }
        }
        if root.proc.selected && !root.proc.added: VerticalLayout {
            alignment: center;
            Chip { label: Str.split-selected-chip; kind: "accent"; }
        }
    }
}
