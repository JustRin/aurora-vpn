<?xml version="1.0" encoding="utf-8"?>
<!-- Two rows, four or more cells: header with the state chip, server and
     big speeds beside the button, session totals and clock along the
     bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_notification"
            android:tint="@color/widget_text_dim" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/widget_text_dim"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingTop="3dp"
            android:paddingRight="9dp"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/state_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot"
                android:tint="@color/widget_ok" />

            <TextView
                android:id="@+id/state"
                android:text="@string/widget_state_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/widget_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Middle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/server"
                android:text="@string/widget_preview_server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/widget_text"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/traffic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_down"
                    android:tint="@color/widget_on_b" />

                <TextView
                    android:id="@+id/down_speed"
                    android:text="@string/widget_preview_down"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="18sp" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginLeft="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_up"
                    android:tint="@color/widget_on_a" />

                <TextView
                    android:id="@+id/up_speed"
                    android:text="@string/widget_preview_up"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:singleLine="true"
                    android:textColor="@color/widget_text"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/btn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/widget_btn_on"
            android:contentDescription="@string/widget_state_off"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_power" />
    </LinearLayout>

    <!-- Footer: session totals and clock -->
    <LinearLayout
        android:id="@+id/totals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_down"
            android:tint="@color/widget_text_dim" />

        <TextView
            android:id="@+id/down_total"
            android:text="@string/widget_preview_down_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:fontFeatureSettings="tnum"
            android:singleLine="true"
            android:textColor="@color/widget_text_dim"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginLeft="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_up"
            android:tint="@color/widget_text_dim" />

        <TextView
            android:id="@+id/up_total"
            android:text="@string/widget_preview_up_total"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:singleLine="true"
            android:textColor="@color/widget_text_dim"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:contentDescription="@string/widget_session"
            android:src="@drawable/ic_clock"
            android:tint="@color/widget_text_dim" />

        <Chronometer
            android:id="@+id/uptime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:fontFeatureSettings="tnum"
            android:singleLine="true"
            android:textColor="@color/widget_text_dim"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
