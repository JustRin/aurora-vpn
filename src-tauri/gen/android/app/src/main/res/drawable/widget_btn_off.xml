<?xml version="1.0" encoding="utf-8"?>
<!-- Disconnected: muted disc, no glow (the band stays as transparent inset). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_btn_off" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_card_stroke" />
        </shape>
    </item>
</layer-list>
