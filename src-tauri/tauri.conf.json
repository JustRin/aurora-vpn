{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora VPN",
  "version": "0.1.5",
  "identifier": "com.aurora.vpn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aurora VPN",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0A0C12",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/sing-box", "binaries/xray"],
    "copyright": "Aurora VPN",
    "category": "Utility",
    "shortDescription": "VLESS client for 3x-ui",
    "longDescription": "Aurora VPN — desktop client for 3x-ui / Xray VLESS servers with TUN mode, per-application split tunneling and rule-based routing.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
